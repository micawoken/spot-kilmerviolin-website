---
/**
 * components/AdminHead.astro
 *
 * Drop-in for the <head> of admin pages that render the entity components (Info / Form / List views
 * and the search boxes). It:
 *   - pulls in the admin-only stylesheet that styles those components and sets the admin typeface,
 *   - preloads the Inter variable font so admin text does not flash an fallback face, and
 *   - emits the noindex robots directive every admin page needs (so pages no longer repeat it).
 *
 * Kept separate from BaseHead (and from the body-rendered AdminHeader) so this loads from the document
 * head and the public site does not ship the admin entity styles.
 *
 * It also suppresses EmDash's floating visual-editing toolbar. EmDash injects that toolbar into every SSR
 * HTML response for an authenticated editor (its request-context middleware runs on all non-/_emdash
 * routes and has no path-exclude option), so it would otherwise appear on the app's own admin pages, where
 * it is meaningless. The public site is prerendered — served as static assets that bypass the worker and
 * its middleware — so the toolbar never reaches public pages; only /admin needs this.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */
import "../styles/admin-entities.css"
---

<meta name="robots" content="noindex" />
<link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />

<!-- Suppress EmDash's injected visual-editing toolbar on admin pages (see the file header). -->
<style is:global>
    #emdash-toolbar {
        display: none !important;
    }
</style>
<script is:inline>
    // Remove the EmDash toolbar node if/when its middleware injects it before the closing body tag. The
    // style above hides it immediately (no flash); this removes it so its inline script does no further
    // work. NOTE: do not write the literal string "</" + "body>" anywhere in this file (even in a comment) —
    // EmDash's toolbar-injection middleware does a naive string search for that exact substring in the
    // rendered HTML and splices its toolbar markup at the first occurrence, which would corrupt this script
    // block if it matched here instead of the real closing tag.
    ;(function () {
        function strip() {
            document.getElementById("emdash-toolbar")?.remove()
        }
        const observer = new MutationObserver(() => {
            if (document.getElementById("emdash-toolbar")) {
                strip()
                observer.disconnect()
            }
        })
        observer.observe(document.documentElement, { childList: true, subtree: true })
        window.addEventListener("load", () => {
            strip()
            observer.disconnect()
        })
    })()
</script>

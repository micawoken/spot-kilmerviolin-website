export interface Props {
    /** the tiles to render, in order */
    links: { href: string; label: string }[]
    /** the wrapping <nav>'s accessible name */
    ariaLabel: string
}

const { links, ariaLabel } = Astro.props
---

<nav aria-label={ariaLabel} class="nav-tiles">
    <ul>
        {
            links.map(({ href, label }) => (
                <li>
                    <a href={href} class="nav-tile">
                        {label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .nav-tiles ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--dtk-chrome-vertical-space-item-gap, var(--dtk-space-sm, 1rem))
            var(--dtk-chrome-horizontal-space-item-gap, var(--dtk-space-sm, 1.25rem));
        margin: var(--dtk-chrome-vertical-space-section, var(--dtk-space-section, 2.5rem)) 0;
        padding: 0;
        list-style: none;
    }
    @media (max-width: 900px) {
        .nav-tiles ul {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (max-width: 560px) {
        .nav-tiles ul {
            grid-template-columns: 1fr;
        }
    }
    .nav-tile {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 6rem;
        padding-block: var(--dtk-chrome-vertical-space-control, var(--dtk-space-xs, 0.5rem));
        padding-inline: var(--dtk-chrome-horizontal-space-control, var(--dtk-space-sm, 0.75rem));
        text-align: center;
        border: var(--dtk-chrome-hairline-width, var(--dtk-border-hairline-width, 1px))
            var(--dtk-chrome-hairline-style, var(--dtk-border-hairline-style, solid))
            var(--dtk-chrome-hairline-color, var(--dtk-border-hairline-color, var(--shade-4)));
        border-radius: var(--dtk-radius-sm, 0);
        background: var(--dtk-chrome-footer-bg, var(--dtk-color-surface, var(--shade-1)));
        color: var(--dtk-chrome-body-text, var(--dtk-color-ink, var(--color-text)));
        font-weight: 600;
        font-size: 1.1rem;
        text-decoration: none;
    }
    .nav-tile:hover {
        border-color: var(--dtk-chrome-body-text, var(--dtk-color-ink, var(--shade-7)));
        color: var(--dtk-chrome-link, var(--dtk-color-garnet, var(--color-link)));
    }
</style>

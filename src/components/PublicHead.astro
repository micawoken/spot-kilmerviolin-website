---
/**
 * components/PublicHead.astro
 *
 * Shared <head> fragment for the public-facing site, the public analog of AdminHead. It carries the
 * common metadata (charset, viewport, favicon, title/description, canonical and social tags).
 *
 * Public pages are prerendered (static assets served from ASSETS), so the serving environment cannot be
 * resolved per request here — a single build produces identical HTML for both the production domain and
 * the "staging" preview alias. The staging preview is therefore kept out of search indexes at the edge
 * (an X-Robots-Tag: noindex response-header rule on the staging-*.workers.dev hostname), not by a
 * per-request meta tag. See DEPLOY.md.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at 
 * https://github.com/micawoken/spot-kilmerviolin-website.
 * 
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */
import "../styles/global.css"

interface Props {
    title: string
    description: string
    image?: string
}

const { title, description, image } = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// Site-wide og:image/twitter:image fallback for a page with no image of its own (own field, or CMS
// featured_image) — a plain build-time constant, not CMS-managed, so unlike webAnalyticsToken below this
// doesn't need an async settings read. Unset by default: omitting the tags entirely is preferable to
// pointing at a placeholder asset that doesn't exist (the previous default, "/blog-placeholder-1.jpg", was
// never carried into public/ from the Astro starter template it came from, and 404s in prod). See
// .env.example.
const siteDefaultOgImage = import.meta.env.SITE_DEFAULT_OG_IMAGE ?? process.env.SITE_DEFAULT_OG_IMAGE
const resolvedImage = image || siteDefaultOgImage

// Cloudflare Web Analytics beacon token. Public pages are prerendered (astro build), so this must be a
// build-time value, not a wrangler runtime var — see the ImportMetaEnv comment in env.d.ts and
// .env.example. Cookieless and requires no consent banner (Cloudflare Web Analytics does not use
// cookies/localStorage to track visitors), satisfying the analytics requirement in
// docs/dev/miscellaneous.txt. Omitted entirely when unset, so a site with no token configured yet renders
// with no beacon rather than a broken one.
//
// No integrity= hash on the beacon script below: Cloudflare updates beacon.min.js's contents server-side
// without notice (it is not a versioned release), so pinning our own SRI hash would go stale and silently
// block the script on their next update rather than protect against anything.
const webAnalyticsToken = import.meta.env.CF_WEB_ANALYTICS_TOKEN ?? process.env.CF_WEB_ANALYTICS_TOKEN

// Paint the correct background before global.css (an external, network-fetched stylesheet) loads, so
// cross-document view transitions (theme-authored; see layouts/PublicPage.astro) never reveal a flash of
// the wrong scheme. The color-scheme meta tag below is parsed synchronously with the rest of <head> and
// tells the browser which UA default to use for anything not yet styled (scrollbars, form controls); the
// inline <style> paints the exact --color-bg value from global.css (not just the UA's approximate dark
// canvas) since it also parses synchronously, with no network round-trip. Keep the hex values in sync with
// --color-bg in global.css (also duplicated in lib/templates/error.html for the same reason).
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<meta name="color-scheme" content="light dark" />
<style>
    html { background: #ffffff; }
    @media (prefers-color-scheme: dark) {
        html { background: #1a1a1a; }
    }
</style>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{resolvedImage && <meta property="og:image" content={new URL(resolvedImage, Astro.url)} />}

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{resolvedImage && <meta property="twitter:image" content={new URL(resolvedImage, Astro.url)} />}

{
    webAnalyticsToken && (
        <script
            is:inline
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={JSON.stringify({ token: webAnalyticsToken })}
        />
    )
}

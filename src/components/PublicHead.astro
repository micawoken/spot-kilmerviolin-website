import "../styles/global.css"

interface Props {
    title: string
    description: string
    image?: string
    /* Allows a page to be directed as noindex */
    noindex?: boolean
}

const { title, description, image, noindex } = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// allows setting of a site-wide default image, with a fallback
const siteDefaultOgImage = import.meta.env.SITE_DEFAULT_OG_IMAGE ?? process.env.SITE_DEFAULT_OG_IMAGE
const resolvedImage = image || siteDefaultOgImage

// Cloudflare Web Analytics token to emit
const webAnalyticsToken = import.meta.env.CF_WEB_ANALYTICS_TOKEN ?? process.env.CF_WEB_ANALYTICS_TOKEN

// Enable preconnection to the two media domains (admin image database and EmDash CMS media)
const imageOrigins = [
    import.meta.env.FILES_PUBLIC_URL ?? process.env.FILES_PUBLIC_URL,
    import.meta.env.EMDASH_MEDIA_PUBLIC_URL ?? process.env.EMDASH_MEDIA_PUBLIC_URL
]
    .filter((url): url is string => Boolean(url))
    .reduce((origins, url) => {
        try {
            origins.add(new URL(url).origin)
        } catch {
            // failed preconnect is not a major issue, ignore
        }
        return origins
    }, new Set<string>())
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

{imageOrigins.size > 0 && [...imageOrigins].map((origin) => <link rel="preconnect" href={origin} />)}

<meta name="color-scheme" content="light dark" />
<style>
    html {
        background: #ffffff;
    }
    @media (prefers-color-scheme: dark) {
        html {
            background: #1a1a1a;
        }
    }
</style>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

{noindex && <meta name="robots" content="noindex" />}

<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{resolvedImage && <meta property="og:image" content={new URL(resolvedImage, Astro.url)} />}

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{resolvedImage && <meta property="twitter:image" content={new URL(resolvedImage, Astro.url)} />}

{
    webAnalyticsToken && (
        <script
            is:inline
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={JSON.stringify({ token: webAnalyticsToken })}
        />
    )
}

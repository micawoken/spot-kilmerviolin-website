---
/**
 * components/PublicHead.astro
 *
 * Shared <head> fragment for the public-facing site, the public analog of AdminHead. It carries the
 * common metadata (charset, viewport, favicon, title/description, canonical and social tags).
 *
 * Public pages are prerendered (static assets served from ASSETS), so the serving environment cannot be
 * resolved per request here — a single build produces identical HTML for both the production domain and
 * the "staging" preview alias. The staging preview is therefore kept out of search indexes at the edge
 * (an X-Robots-Tag: noindex response-header rule on the staging-*.workers.dev hostname), not by a
 * per-request meta tag. See DEPLOY.md.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */
import "../styles/global.css"

interface Props {
    title: string
    description: string
    image?: string
}

const { title, description, image = "/blog-placeholder-1.jpg" } = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!--
  Paint the correct background before global.css (an external, network-fetched stylesheet) loads, so
  cross-document view transitions (see global.css) never reveal a flash of the wrong scheme. The
  color-scheme meta tag is parsed synchronously with the rest of <head> and tells the browser which UA
  default to use for anything not yet styled (scrollbars, form controls); the inline <style> paints the
  exact --color-bg value from global.css (not just the UA's approximate dark canvas) since it also
  parses synchronously, with no network round-trip. Keep the hex values below in sync with --color-bg
  in global.css (also duplicated in lib/templates/error.html for the same reason).
-->
<meta name="color-scheme" content="light dark" />
<style>
    html { background: #ffffff; }
    @media (prefers-color-scheme: dark) {
        html { background: #1a1a1a; }
    }
</style>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

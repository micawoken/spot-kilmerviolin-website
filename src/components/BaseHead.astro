// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css"
import { detectEnvironment } from "../lib/api/environment"

interface Props {
    title: string
    description: string
    image?: string
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// No admin-page default: the admin is Access-gated, so a scraper never resolves og:image/twitter:image
// here anyway. The previous default, "/blog-placeholder-1.jpg", was never carried into public/ from the
// Astro starter template it came from and 404s in prod — omit the tags entirely rather than point at it.
const { title, description, image } = Astro.props

// keep the staging preview out of search indexes (see PublicHead.astro for the canonical version)
const noindex = detectEnvironment(Astro.request) === "staging"
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

{
    /* Paints the real background before global.css (network-fetched) loads, so view transitions never
    flash the wrong scheme. color-scheme sets the UA default for unstyled controls; the inline style
    paints the exact --color-bg value (not just the UA's approximate dark canvas), both parsed
    synchronously with no network round-trip. Keep these hex values in sync with --color-bg in
    global.css (also duplicated in lib/templates/error.html). */
}
<meta name="color-scheme" content="light dark" />
<style>
    html {
        background: #ffffff;
    }
    @media (prefers-color-scheme: dark) {
        html {
            background: #1a1a1a;
        }
    }
</style>

{
    /* No @view-transition rule here, deliberately: the UA crossfade flashes white ~230ms on every admin
    nav (measured 3/3 in Trace-20260726T223908.json; Chrome root cause still unknown). Overriding
    mix-blend-mode to fix it breaks the UA's alpha-exact blend and dims navigations instead — worse.
    Public pages get their own theme-toggled copy (tokens.ts's viewTransitionCss via PublicPage.astro);
    admin has no theme to toggle from, so it opts out. Don't reintroduce without re-tracing a deploy
    first. */
}

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

{/* staging preview only; see PublicHead.astro for the canonical (prerendered) version */}
{noindex && <meta name="robots" content="noindex" />}

<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image, Astro.url)} />}

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{image && <meta property="twitter:image" content={new URL(image, Astro.url)} />}

{
    /* EmDash injects its visual-editing toolbar into every HTML response (no path/env gate, no opt-out) —
    meant for editing public pages, but dead weight on admin: CSP blocks its script and it floats over
    the UI. Only BaseHead (admin) hides it; PublicHead doesn't. is:global since the toolbar lives outside
    this tree; !important since EmDash's stylesheet loads later and would otherwise win.

    Gotcha: EmDash finds its insertion point via a plain string-replace on the first closing body tag —
    writing that tag literally anywhere earlier, even in a comment, redirects the injection here. Don't
    spell it out. */
}
<style is:global>
    #emdash-toolbar {
        display: none !important;
    }
</style>

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css"
import { detectEnvironment } from "../lib/api/environment"

interface Props {
    title: string
    description: string
    image?: string
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const { title, description, image = "/blog-placeholder-1.jpg" } = Astro.props

// keep the staging preview out of search indexes (see PublicHead.astro for the canonical version)
const noindex = detectEnvironment(Astro.request) === "staging"
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!--
  Paint the correct background before global.css (an external, network-fetched stylesheet) loads, so
  cross-document view transitions (see global.css) never reveal a flash of the wrong scheme. The
  color-scheme meta tag is parsed synchronously with the rest of <head> and tells the browser which UA
  default to use for anything not yet styled (scrollbars, form controls); the inline <style> paints the
  exact --color-bg value from global.css (not just the UA's approximate dark canvas) since it also
  parses synchronously, with no network round-trip. Keep the hex values below in sync with --color-bg
  in global.css (also duplicated in lib/templates/error.html for the same reason).
-->
<meta name="color-scheme" content="light dark" />
<style>
    html { background: #ffffff; }
    @media (prefers-color-scheme: dark) {
        html { background: #1a1a1a; }
    }
</style>

<!--
  EmDash appends its visual-editing toolbar to the end of the document body on every HTML response for a
  CMS editor (emdash's request-context middleware — no path or environment gate, and it exposes no option
  to opt out). That toolbar exists to edit *public* pages in place; on an admin page it is dead weight,
  since the admin CSP blocks its inline script (middleware/headers.ts), and it floats over the UI —
  including the compositor's full-viewport editor. Only admin pages use BaseHead (the public site uses
  PublicHead), so hiding it here scopes the rule to exactly the admin UI.

  is:global because the toolbar is appended outside this component's tree, and !important because
  EmDash's own stylesheet lands later in the document, where it would otherwise win a tie.

  Careful: EmDash locates the insertion point with a plain string replace on the first closing body tag.
  Writing that tag literally anywhere earlier in the document — even inside a comment like this one —
  makes it inject the toolbar there instead. Do not spell it out here.
-->
<style is:global>
    #emdash-toolbar {
        display: none !important;
    }
</style>

<!-- Keep the staging preview out of search indexes -->
{noindex && <meta name="robots" content="noindex" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css"
import { detectEnvironment } from "../lib/api/environment"

interface Props {
    title: string
    description: string
    image?: string
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// No admin-page default: the admin is Access-gated, so a scraper never resolves og:image/twitter:image
// here anyway. The previous default, "/blog-placeholder-1.jpg", was never carried into public/ from the
// Astro starter template it came from and 404s in prod - omit the tags entirely rather than point at it.
const { title, description, image } = Astro.props

// keep the staging preview out of search indexes (see PublicHead.astro for the canonical version)
const noindex = detectEnvironment(Astro.request) === "staging"
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

{/* Paint the true background early before the page loads to prevent flashes on view-transition CSS */}
<meta name="color-scheme" content="light dark" />
<style>
    html {
        background: #ffffff;
    }
    @media (prefers-color-scheme: dark) {
        html {
            background: #1a1a1a;
        }
    }
</style>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

{/* staging preview only; see PublicHead.astro for the canonical (prerendered) version */}
{noindex && <meta name="robots" content="noindex" />}

<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image, Astro.url)} />}

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{image && <meta property="twitter:image" content={new URL(image, Astro.url)} />}

{/* Forces erasure of the EmDash CMS toolbar */}
<style is:global>
    #emdash-toolbar {
        display: none !important;
    }
</style>

const today = new Date()
const locals = Astro.locals
const identity = locals.identity ?? null

// Pulls the IANA time zone from Cloudflare for rendering in footer
const request_cf = (Astro.request as any).cf as { timezone?: string } | undefined
const tz: string | undefined = request_cf?.timezone
let time_display: string
try {
    time_display = today.toLocaleString("en-US", {
        timeZone: tz || "UTC",
        weekday: "long",
        day: "2-digit",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        timeZoneName: "short"
    })
} catch {
    time_display = today.toLocaleString("en-US", { timeZone: "UTC" })
}
const tz_label: string = tz || "UTC"
---

<footer role="contentinfo">
    <nav role="navigation" aria-label="Administrative footer">
        <p>
            <a href="/admin" id="admin-footer-back" class="col-item-link">Back</a>
            <span class="admin-nav-sep" aria-hidden="true">|</span>
            <a href="/admin" rel="home" class="col-item-link">Admin Home</a>
            <span class="admin-nav-sep" aria-hidden="true">|</span>
            <a href="/admin/docs" rel="help" class="col-item-link">Help Docs</a>
            <span class="admin-nav-sep" aria-hidden="true">|</span>
            <a href="/admin/terms-of-use" rel="terms-of-use" class="col-item-link">Terms of Use</a>
            <span class="admin-nav-sep" aria-hidden="true">|</span>
            <a href="/admin/privacy-policy" rel="privacy-policy" class="col-item-link">Privacy Policy</a>
            <span class="admin-nav-sep" aria-hidden="true">|</span>
            <a href="/admin/security-policy" rel="security-policy" class="col-item-link">Security Policy</a>
        </p>
    </nav>
    <p>
        You are accessing this service
        {
            identity?.email ? (
                <>
                    {" "}
                    under email <a href={`mailto:${identity.email}`}>{identity.email}</a>.{" "}
                </>
            ) : (
                <> as an unauthenticated user. </>
            )
        }
        The time is {time_display} ({tz_label}).{" "}
        <a href="mailto:kilmer_security@mwmsc.net">Report a security issue</a>.
    </p>
    <p>
        Thank you for using administrative services. Administrative services are &copy; {today.getFullYear()}{" "}
        <a href="https://michaelwongmusic.com" target="_blank" rel="noopener noreferrer">Michael Wong</a>, licensed
        under <a href="/admin/license" rel="license">GNU AGPLv3 and additional terms</a>.
    </p>
</footer>

{/* backnav is powered by this script to enable true js:history.back without inline js */}
<script is:inline defer src="/js/admin-footer-back.js"></script>

{/* sticky footer */}
<style is:global>
    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        /* A 16px gutter on every side, applied as padding */
        margin: 0;
        padding: 16px;
        box-sizing: border-box;
    }

    body > footer {
        margin-top: auto;
    }

    /* Keep the 16px frame even on the top and bottom edges */
    body > :first-child > h1:first-child {
        margin-top: 0;
    }

    body > footer > p:last-child {
        margin-bottom: 0;
    }
</style>

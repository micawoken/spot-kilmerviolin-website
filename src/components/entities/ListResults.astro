import ListResult from "./ListResult.astro"
const noun: string = Astro.props.noun
const results: (number | Record<string, any>)[] = Astro.props.results
const enviro: string = Astro.props.enviro

// determine if the results are a list of IDs or a list of objects (whose types can be inferred from the noun)

interface ResultObject {
    id: number
    name: string
    name2?: string
    is_self?: boolean
    href?: string
}


const no_body = results.length > 0 && typeof results[0] === "number"

---
<div id={`list-results-${noun}`} class="list-results-container">
    {
        results.length > 0 ? (
            no_body ? (
                (results as number[]).map((id: number) => (
                    <ListResult noun={noun} id={id} enviro={enviro} />
                ))
            ) : (
                (results as ResultObject[]).map((result) => (
                    <ListResult
                        noun={noun}
                        id={result.id}
                        enviro={enviro}
                        name={result.name}
                        name2={result.name2}
                        is_self={result.is_self}
                        href={result.href}
                    />
                ))
            )
        ) : (
            <p>No results found.</p>
        )
    }
</div>
{
    enviro === "admin" ? (
        // Same-origin static file (public/js/list-result-nav.js) loaded with is:inline + src, NOT an Astro
        // <script>: the bundler inlines small self-contained Astro scripts into the document, which the
        // admin Content-Security-Policy (script-src 'self') then blocks. An external same-origin script is
        // covered by 'self'. defer runs it after the DOM is parsed so the edit links exist.
        <script is:inline defer src="/js/list-result-nav.js" />
    ) : (
        <></>
    )
}
---
/**
 * components/entities/IDEntryForm.astro
 * 
 * Reusable component to enter an ID, with client-side processing
 * 
 * Used for info pages when an ID is not specified in the URL param
 * 
 * Props:
 * - output_div (optional): if specified, the ID entry form will render a div with this ID to emit the output
 * - hidden (optional): if true, the form will be hidden (such as if the data is already supplied by the URL param)
 * - search (optional): if true, renders an embedded keyword-search helper inside the Enter ID fieldset
 *   that autofills the id input (akin to the name->ID searchhelpers on the entity forms). The page wires
 *   its select behavior via attachKeywordSearch/attachKeywordSearchInline using these element ids:
 *     - form-id-entry-search-input   : the keyword text input
 *     - form-id-entry-search-button  : the search button
 *     - form-id-entry-search-results : the results container
 * 
 * 
 * Copyright (C) 2026 Michael Wong.
 * 
 * This file is part of the spot-kilmerviolin-website program, available at 
 * https://github.com/micawoken/spot-kilmerviolin-website.
 * 
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 * 
 * This license is also subject to additional terms as specified in the README.md.
 * 
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 * 
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 * 
 */


const output_div: string | undefined = Astro.props.output_div;
const hidden = Astro.props.hidden || false;
/**
 * Whether to render an elevation/escalation checkbox (admin operations on works/contributors)
 */
const show_elevate: boolean = Astro.props.show_elevate || false;
/**
 * Whether to render an embedded keyword-search helper that autofills the id input
 */
const search: boolean = Astro.props.search || false;

---
<div class=`generic-form id-entry${hidden ? ' hidden' : ''}` id="generic-form-id-entry-container">
    <form id="generic-form-id-entry" class="generic-form">
        <fieldset>
            <legend>Enter ID</legend>
            <input type="text" id="form-id-entry-id" name="id" required />
            {
                search ? (
                    <div class="searchhelper" id="form-id-entry-search">
                        <label for="form-id-entry-search-input"><strong>Search for ID by keyword</strong></label>
                        <input type="text" id="form-id-entry-search-input" />
                        <button type="button" id="form-id-entry-search-button">Search</button>
                        <div id="form-id-entry-search-results">
                            <p>Results will display here when searched.</p>
                        </div>
                    </div>
                ) : null
            }
        </fieldset>
        {
            show_elevate ? (
                <fieldset>
                    <legend>Administrator Elevation</legend>
                    <input type="checkbox" id="form-id-entry-elevate" name="elevate" />
                    <label for="form-id-entry-elevate">Use administrator elevation for this operation</label>
                    <p class="general-warning">Elevation bypasses ownership and property protections. Proceed with caution.</p>
                </fieldset>
            ) : null
        }
        <button type="submit">Submit</button>
    </form>
    {
        output_div ? (
            <>
            <div id={`transaction-output-${output_div}`}></div>
            </>
        ) : (
            <></>
        )
    }
</div>
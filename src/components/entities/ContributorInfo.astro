---
/**
 * components/entities/ContributorInfo.astro
 *
 * Result display for a contributor record
 *
 * Element ids follow the contributor-{key} convention used by populateInfo in scripts/interface.ts
 *
 * Protected properties are filtered by the API for non-self, non-escalated requests, which strips those
 * keys from the record entirely (redactProtected, lib/api/d1.ts) rather than nulling them — so the whole
 * authorization-fields section (#contributor-authinfo) is hidden, not left blank, when they are absent.
 * The client-side READ flow (scripts/interface.ts's toggleContributorAuthSection) mirrors this same
 * check after a live lookup, since populateInfo alone cannot re-hide a section a prior, authorized
 * lookup left visible. The set of protected properties is sourced from CONTRIBUTOR.protected
 * (lib/api/d1.ts) so the notice below always matches what the API actually redacts, rather than a
 * hand-maintained list that can drift out of sync.
 *
 * Props:
 * - contributor (optional): a (possibly partial) ContributorRecord provided by SSR, if any
 * - hidden (optional): whether to keep the result container hidden (used until the ID form is submitted)
 * - imageAlt (optional): pre-resolved alt text for the image (see resolveEntityImageAlt); falls back to
 *   a generic "Image of contributor {name}" caption when not provided
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at
 * https://github.com/micawoken/spot-kilmerviolin-website.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */
import { CONTRIBUTOR } from "../../lib/api/d1"
import { NOT_PROVIDED } from "../../consts"

const contributor: Partial<ContributorRecord> | null = Astro.props.contributor || null
const hidden: boolean = Astro.props.hidden || false
const imageAlt: string | undefined = Astro.props.imageAlt

// renders a field value, substituting a clear marker when the value is null, undefined, blank, or an
// empty array so a "not supplied" field is visually distinct from an unset/blank render. Booleans
// render as "Yes"/"No" rather than their literal "true"/"false".
const disp = (value: unknown, missing?: string): string => {
    if (value === null || value === undefined) return missing ?? NOT_PROVIDED
    if (Array.isArray(value)) return value.length > 0 ? value.join(", ") : (missing ?? NOT_PROVIDED)
    if (typeof value === "string" && value.trim() === "") return missing ?? NOT_PROVIDED
    if (typeof value === "boolean") return value ? "Yes" : "No"
    return String(value)
}

// human-readable labels for the protected contributor columns surfaced as fields below.
const protected_field_labels: Record<string, string> = {
    identity_email: "identity email",
    roles: "roles",
    admin: "account type"
}
const protected_fields = CONTRIBUTOR.protected ?? []
const protected_label = protected_fields
    .map((field) => protected_field_labels[field])
    .filter((label): label is string => label !== undefined)
    .join(", ")

// redactProtected (lib/api/d1.ts) deletes every protected key from a record it redacts, rather than
// nulling them out — so a protected key's presence is a reliable signal that the caller is authorized
// to see it (checking one is enough: they are always redacted together). Absent entirely (no record
// loaded yet) is treated the same as unauthorized, matching the container's own `hidden` state.
const authorized = contributor !== null && "identity_email" in contributor
---

<div id="generic-result-contributor" class={`entity-result-container${hidden ? " hidden" : ""}`}>
    {
        /* head: the identifying header (name, contacts, class line, bio) sits top-left, the auth and tags
        groups flow in columns beneath it, and the image occupies the top-right. Source order is header →
        image → groups so that on narrow viewports the image stacks directly below the title (see
        admin-entities.css). */
    }
    <div class="entity-result-head">
        <div class="entity-result-header">
            <h2 id="contributor-name" class="entity-result-name">{contributor?.name}</h2>
            <p id="contributor-id">ID #{contributor?.id}</p>
            <p id="contributor-public_email">{disp(contributor?.public_email, "(no email set)")}</p>
            <div id="contributor-infocard-school">
                {
                    /* class year, major, and phases render together on a single line. All three data-bearing
                    elements are ALWAYS present (with placeholder markers when unset) so the client-side
                    READ flow (populateInfo) can fill them; conditionally omitting them would leave
                    populateInfo with no target and strand the SSR placeholder text in the DOM. */
                }
                <p id="contributor-class_year">
                    <span class="sr-only">Class Year: </span>{disp(contributor?.class_year, "(no class year set)")}
                </p>
                <p id="contributor-major">
                    <span class="sr-only">Major: </span>{disp(contributor?.major, "(no major set)")}
                </p>
                <p id="contributor-phases">Phases {disp(contributor?.phases, "(no phases specified)")}</p>
            </div>
            {/* the bio sits directly below the class line within the header */}
            <div id="contributor-bio-container" class="entity-result-bio">
                <p id="contributor-bio">{disp(contributor?.bio, "(no bio available)")}</p>
            </div>
        </div>
        <div id="contributor-image-container" class="entity-result-image-container">
            {
                /* the <img> is always present (hidden when there is no image) so the client-side READ flow
                (populateInfo) can fill its src; the "(no image)" placeholder mirrors it inversely. src is
                omitted when absent to avoid a broken-image request. */
            }
            <img
                id="contributor-image"
                class={`entity-result-image${contributor?.image ? "" : " hidden"}`}
                src={contributor?.image ?? undefined}
                alt={imageAlt ?? `Image of contributor ${contributor?.name ?? ""}`}
                title={imageAlt ?? `Image of contributor ${contributor?.name ?? ""}`}
            />
            <p
                id="contributor-image-missing"
                class={`entity-result-image-missing${contributor?.image ? " hidden" : ""}`}
            >
                No image available.
            </p>
        </div>
        <div class="entity-result-groups">
            <div id="contributor-authinfo" class={`entity-result-group${authorized ? "" : " hidden"}`}>
                <p class="general-infohelp">
                    Authorization-related fields ({protected_label}) are only visible for your user account unless you
                    are an administrator.
                </p>
                {
                    /* the four fields pair up 2×2 (identity email, roles, account type, tags). The help caption
                    above spans both columns and is excluded from that pairing, so the fields stay evenly
                    aligned regardless of it; the grid collapses to one column when space is low (see
                    admin-entities.css). */
                }
                <p>
                    <strong>Identity Email:</strong>
                    <span id="contributor-identity_email">{disp(contributor?.identity_email)}</span>
                </p>
                <p>
                    <strong>Roles:</strong>
                    <span id="contributor-roles">{disp(contributor?.roles, "(no roles specified)")}</span>
                </p>
                <p>
                    <strong>Account type:</strong>
                    <span id="contributor-admin"
                        >{
                            contributor?.admin === undefined || contributor?.admin === null
                                ? disp(contributor?.admin)
                                : contributor.admin
                                  ? "Administrator"
                                  : "Standard"
                        }</span
                    >
                </p>
                <p id="contributor-tags-container">
                    <strong>Tags:</strong>
                    <span id="contributor-tags">{disp(contributor?.tags)}</span>
                </p>
            </div>
        </div>
    </div>
</div>

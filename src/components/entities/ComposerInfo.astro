---
/**
 * components/entities/ComposerInfo.astro
 *
 * Result display for a composer record
 *
 * Element ids follow the composer-{key} convention used by populateInfo in scripts/interface.ts
 *
 * Props:
 * - composer (optional): a ComposerRecord provided by SSR, if any
 * - hidden (optional): whether to keep the result container hidden (used until the ID form is submitted)
 * - imageAlt (optional): pre-resolved alt text for the image (see resolveEntityImageAlt); falls back to
 *   a generic "Image of composer {name}" caption when not provided
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at 
 * https://github.com/micawoken/spot-kilmerviolin-website.
 * 
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */
import { NOT_PROVIDED } from "../../consts"
import { countryCodeName } from "../../scripts/format"
import { renderCitationsList } from "../../scripts/citations"

const composer: ComposerRecord | null = Astro.props.composer || null
const hidden: boolean = Astro.props.hidden || false
const imageAlt: string | undefined = Astro.props.imageAlt

// renders a field value, substituting a clear marker when the value is null, undefined, blank, or an
// empty array, so a "not supplied" field is visually distinct from an unset/blank render
const disp = (value: unknown, placeholder?: string): string => {
    if (value === null || value === undefined) return placeholder ? placeholder : NOT_PROVIDED
    if (Array.isArray(value)) return value.length > 0 ? value.join(", ") : placeholder ? placeholder : NOT_PROVIDED
    if (typeof value === "string" && value.trim() === "") return placeholder ? placeholder : NOT_PROVIDED
    if (typeof value === "boolean") return value ? "Yes" : "No"
    return String(value)
}

// a death_year of -1 denotes a living composer; render it as "Present" (mirrored client-side in populateInfo)
const dispDeath = (value: number | null | undefined): string =>
    value === -1 ? "Present" : disp(value, "(death year not provided)")
---

<div id="generic-result-composer" class={`entity-result-container${hidden ? " hidden" : ""}`}>
    {/* head: the identifying header (name/ID + country/role/birth-death infoline) sits top-left, the bio
        flows in the column beneath it, and the image occupies the top-right. The tags are pulled out below
        the head so they follow the bio text. Source order is header → image → groups so the image stacks
        directly below the title on narrow viewports. */}
    <div class="entity-result-head">
        <div class="entity-result-header">
            <h2 id="composer-name" class="entity-result-name">{composer?.name}</h2>
            <div id="composer-details-infoline">
                {/* one middot-separated line; the ID # leads the bar */}
                <p id="composer-id">ID #{composer?.id}</p>
                {/* data-bearing elements carry the composer-{key} id used by populateInfo; birth/death are split into
                    their own spans (the ndash stays as static text) so each maps to a single record key */}
                <strong
                    ><span class="sr-only">Country: </span><span id="composer-country"
                        >{
                            disp(
                                composer?.country ? countryCodeName(composer.country) : composer?.country,
                                "(country not provided)"
                            )
                        }</span
                    ></strong
                >
                <p id="composer-role"><span class="sr-only">Role: </span>{disp(composer?.role, "(role not provided)")}</p>
                {/* the label sits in the wrapping <p>, not either id'd span, so a client-side lookup
                    (populateInfo, which sets textContent directly on #composer-birth_year/#composer-death_year)
                    cannot clobber it */}
                <p id="composer-details-infoline-birthdeath">
                    <span class="sr-only">Years active: </span><span id="composer-birth_year"
                        >{disp(composer?.birth_year, "(birth year not provided)")}</span
                    >&ndash;<span id="composer-death_year">{dispDeath(composer?.death_year)}</span>
                </p>
            </div>
        </div>
        <div id="composer-image-container" class="entity-result-image-container">
            {/* the <img> is always present (hidden when there is no image) so the client-side READ flow
                (populateInfo) can fill its src; the grayed-out "(no image)" placeholder mirrors it inversely.
                src is omitted when absent to avoid a broken-image request. */}
            <img
                id="composer-image"
                class={`entity-result-image${composer?.image ? "" : " hidden"}`}
                src={composer?.image ?? undefined}
                alt={imageAlt ?? `Image of composer ${composer?.name ?? ""}`}
                title={imageAlt ?? `Image of composer ${composer?.name ?? ""}`}
            />
            <p id="composer-image-missing" class={`entity-result-image-missing${composer?.image ? " hidden" : ""}`}>
                No image available.
            </p>
        </div>
        <div class="entity-result-groups">
            {/* the bio occupies the group flow (where the tags previously sat) */}
            <div id="composer-details-bio" class="entity-result-group entity-result-bio">
                <p id="composer-bio">{disp(composer?.bio, "(biography not provided)")}</p>
            </div>
        </div>
    </div>
    {/* tags follow the bio text, pulled below the head to span the full card width */}
    <div id="composer-details-tags" class="entity-result-fullwidth entity-result-details">
        <div class="entity-field"><strong>Tags:</strong> <span id="composer-tags">{disp(composer?.tags)}</span></div>
        {/* citations render as a comma-separated list of hyperlinks (key as display text); renderCitationsList
            returns markup-safe HTML (every value escapeHtml-encoded), so it is emitted via set:html. Mirrored
            client-side in populateInfo. */}
        <div class="entity-field">
            <strong>Citations:</strong> <span
                id="composer-citations"
                set:html={renderCitationsList(composer?.citations, NOT_PROVIDED)}
            />
        </div>
    </div>
</div>

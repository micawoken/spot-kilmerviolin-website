---
// extracts the data to render the list result
/*
 * noun - the entity type
 * id - the entity's ID
 * enviro - the list environment (admin, or something else), used to generate the pointer address
 * name - optional, indicates the main name
 * name2 - optional, indicates a secondary name 
 */
const { noun, id, enviro, name, name2 } = Astro.props;
const pointer_text = name ? (name2 ? `${id} - ${name} (${name2})` : `${id} - ${name}`) : `ID ${id}`;
const pointer_address = (enviro === "admin") ? `/admin/${noun}s/info?id=${id}` : `/entity/${noun}/${id}`;
---
<div id={`list-result-${noun}-${id}`} class="list-result-container">
    <a href={pointer_address} class="list-result-link">{pointer_text}</a>
    {
        enviro === "admin" ? (
            <>
                <br />
                <a href={`/admin/${noun}s/edit?id=${id}`} class="list-result-edit-link" id={`list-result-${noun}-${id}-link`}>Edit &gt;</a>
            </>
        ) : (
            <>
                
            </>
        )
    }
</div>
// extracts the data to render the list result
/*
 * noun - the entity type
 * id - the entity's ID
 * enviro - the list environment (admin, or something else), used to generate the pointer address
 * name - optional, indicates the main name
 * name2 - optional, indicates a secondary name
 * is_self - optional, marks the record as the viewing user's own (highlights the card and tags the name)
 */
const { noun, id, enviro, name, name2, is_self } = Astro.props
// when a name is present it becomes the primary label and the ID is demoted to a corner badge;
// with no name the ID is the primary label (original behavior)
const display_name = name ? (name2 ? `${name} (${name2})` : name) : null
const pointer_text = display_name ?? `ID #${id}`
const pointer_address = enviro === "admin" ? `/admin/${noun}s/info?id=${id}` : `/entity/${noun}/${id}`
---

<div id={`list-result-${noun}-${id}`} class:list={["list-result-container", { "list-result-self": is_self }]}>
    {display_name && (
        // Not useful to a public visitor and shouldn't surface in search (a query like "38" would
        // otherwise match every record's id badge) — kept visible for admin, where the id is load-bearing.
        // admin-entities.css absolutely-positions this badge into the card corner (no inline gap needed
        // there); the public index page loads no such stylesheet, so the badge renders inline and needs
        // an explicit trailing space or it runs straight into the name that follows.
        <span class="list-result-id" data-pagefind-ignore={enviro === "admin" ? undefined : "all"}>
            ID #{id}
        </span>
    )}{" "}
    <a href={pointer_address} class="list-result-link">{pointer_text}</a>
    {
        enviro === "admin" ? (
            <>
                <a
                    href={`/admin/${noun}s/edit?id=${id}`}
                    class="list-result-edit-link"
                    id={`list-result-${noun}-${id}-link`}
                >
                    Edit &gt;
                </a>
            </>
        ) : (
            <></>
        )
    }
    {is_self && <span class="list-result-self-tag">(you)</span>}
</div>

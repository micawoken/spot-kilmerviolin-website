---
/**
 * components/entities/EntityIndex.astro
 *
 * Rendering body for one entity noun's public index (composer/composition/contributor) — extracted out
 * of pages/entity/[noun]/index.astro so pages/database/[noun]/index.astro (mirroring the noun indexes
 * under /database, docs/dev/miscellaneous.txt "/database alias") can render byte-identical output at a
 * second path, the same split DatabaseRoot.astro already uses for the database root. Both page files
 * independently run their own `getStaticPaths` (Astro's build has no shared cache between page files,
 * matching [id].astro/index.astro's own existing duplication) and pass this component the same props.
 *
 * Individual entries are NOT mirrored (they remain reachable only under /entity/{noun}/{id} —
 * ListResults/ListResult always link there regardless of which index rendered them), so the breadcrumb's
 * "Database" crumb always points at the canonical /database root, but this component's own current-page
 * crumb has no link (it IS the current page, reached via either /entity/{noun}/ or /database/{noun}/).
 *
 * Opts out of the Pagefind index (PublicPage's pagefindIgnore prop), same reasoning as DatabaseRoot.astro:
 * it renders at two URLs (/entity/{noun}/ and /database/{noun}/) and every name it lists already has its
 * own indexed detail page, so leaving it indexed would only add duplicate, lower-quality search hits.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at
 * https://github.com/micawoken/spot-kilmerviolin-website.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */

import PublicPage from "../../layouts/PublicPage.astro"
import ListResults from "./ListResults.astro"
import { ENTITY_NOUN_LABELS, ENTITY_NOUN_SLUGS, type EntityNoun } from "../../lib/compositor/entity-fields"
import "../../styles/public-entities.css"

interface EntityListItem {
    id: number
    name: string
}

interface Props {
    noun: EntityNoun
    results: EntityListItem[]
}

const { noun, results } = Astro.props as Props
const title = ENTITY_NOUN_LABELS[noun]

// This page is prerendered once at build time and served identically to every visitor, so "now" here is
// the build/generation time, not a per-request value — pinned to UTC (like catalog.tsx's
// ENTITY_DATE_FORMAT) so the same build always produces the same displayed timestamp regardless of the
// machine/CI runner's local zone.
const GENERATED_AT_FORMAT = new Intl.DateTimeFormat("en-US", {
    dateStyle: "long",
    timeStyle: "long",
    timeZone: "UTC"
})
const generatedAt = GENERATED_AT_FORMAT.format(new Date())
---

<PublicPage title={title} pagefindFilter="scope:database" pagefindIgnore>
    {/* Single wrapper, not four bare children directly under <main>: public-chrome.css's
        `main > :not(.cmp-section, article)` rule insets each direct child individually via
        `var(--dtk-space-md)`. That token can be authored as a font-relative expression (e.g. a
        `clamp(..., (100vw - 66ch) / 2, ...)` reading-width trick) — a custom property's relative units
        resolve per consuming element, so the breadcrumbs/h1/list/footnote (each a different font size)
        would each compute a different actual inset, drifting out of alignment with each other and with
        the header at some viewport widths. Applying the inset once, on one wrapper that inherits the
        body's own font size, keeps this page's whole content column aligned with the header at every
        width — the same reasoning, and the same `main > :not(.cmp-section, article)` rule, that a
        Puck-rendered page's `.cmp-root` wrapper (catalog.tsx) relies on. */}
    <div class="entity-index-body">
        <div class="entity-index-listing">
            {/* Hand-authored, not the Puck Breadcrumbs component (catalog.tsx): this page is pre-generated Astro,
                not a Puck design, so the component can never be placed here. Follows the same
                Home / [...ancestor pages] / [current page] convention as route-authority.ts's
                breadcrumbAncestors: "Database" is the one real ancestor page (its own root, canonical at
                /database — see this component's header), and this index's own title is the final,
                unlinked crumb. */}
            <nav class="entity-breadcrumbs" aria-label="Breadcrumb">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li><a href="/database">Database</a></li>
                    <li aria-current="page">{title}</li>
                </ol>
            </nav>
            <h1>{title}</h1>
            <ListResults noun={ENTITY_NOUN_SLUGS[noun]} enviro="public" results={results} />
        </div>
        <p class="entity-index-generated-note">This page is system-generated. Last updated {generatedAt}.</p>
    </div>
</PublicPage>

<style>
    /* Mirrors public-chrome.css's own sticky-footer setup (html body { display: flex; flex-direction:
       column }, main { flex: 1 0 auto }) one level down, so the generated-note behaves like the page
       footer itself: flush above it on a short list, directly beneath the list (still above the footer)
       once the list is tall enough to fill the viewport on its own.
       A percentage height on .entity-index-body can't be used to reach that — main's flex-grown height is
       only a *used* size, not a specified one, so a block child's `height: 100%` does not resolve against
       it (verified: it collapses to content height instead). Making `main` itself a flex column instead
       gives its child a real flex-basis to grow from, the same mechanism public-chrome.css already uses
       one level up. `:global()` is required to reach `main` (owned by PublicPage.astro, not this
       component) but stays page-scoped: Astro only loads this stylesheet on this route. */
    :global(main) {
        display: flex;
        flex-direction: column;
    }
    .entity-index-body {
        display: flex;
        flex-direction: column;
        flex: 1 0 auto;
    }
    .entity-index-listing {
        flex: 1 0 auto;
    }
    .entity-index-generated-note {
        color: var(--dtk-chrome-muted, var(--dtk-color-slate, var(--color-text-muted)));
        font-size: 0.875rem;
        margin-top: var(--dtk-space-section, 2.5rem);
        padding-top: var(--dtk-space-md, 2rem);
        padding-bottom: 0;
        border-top: var(--dtk-chrome-hairline-width, var(--dtk-border-hairline-width, 1px))
            var(--dtk-chrome-hairline-style, var(--dtk-border-hairline-style, solid))
            var(--dtk-chrome-hairline-color, var(--dtk-border-hairline-color, var(--shade-3)));
        margin-bottom: 0;
    }
    .entity-breadcrumbs ol {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0;
        margin: 0 0 var(--dtk-space-md, 1rem);
        padding: 0;
        list-style: none;
        font-family: var(--dtk-type-label-family, ui-monospace, monospace);
        font-size: var(--dtk-type-label-size, 0.85rem);
        color: var(--dtk-chrome-muted, var(--dtk-color-slate, var(--color-text-muted)));
    }
    .entity-breadcrumbs li:not(:first-child)::before {
        content: "/";
        margin-inline: 0.5em;
        opacity: 0.6;
    }
    .entity-breadcrumbs a {
        color: var(--dtk-chrome-link, var(--dtk-color-garnet, var(--color-link)));
    }
    .entity-breadcrumbs li[aria-current="page"] {
        color: var(--dtk-chrome-body-text, var(--dtk-color-ink, var(--color-text)));
    }
</style>

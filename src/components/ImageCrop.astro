---
/**
 * components/ImageCrop.astro
 *
 * The add/replace pages' image crop interface. Uploaded images are stored in exactly one of two canonical
 * shapes (portrait 4:5 or landscape 5:4 — see lib/api/images.ts), so this component lets the operator
 * choose the orientation and frame the crop before upload. It watches a file <input> (identified by
 * `inputId`), renders a preview with an aspect-locked crop box that can be dragged (pan) and resized
 * (zoom), and a Portrait/Landscape toggle that re-locks the box. The static markup lives here; the scoped
 * script below wires the behaviour.
 *
 * It is self-contained: it owns the too-small warning (shown when the selected region is smaller than its
 * canonical canvas and would be upscaled) and recolours the crop box to match. It reports the current selection by dispatching an `imagecrop:change` CustomEvent (detail:
 * ImageCropChangeDetail) on its root element, which the host page caches to forward on submit.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at
 * https://github.com/micawoken/spot-kilmerviolin-website.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */
interface Props {
    /** DOM id of the <input type="file"> whose selection drives the preview. */
    inputId: string
    /** DOM id for this component's root (where the host page listens for `imagecrop:change`). */
    id?: string
}
const { inputId, id = "image-crop" } = Astro.props
---

<div class="image-crop" id={id} data-input-id={inputId} hidden>
    <div class="image-crop-controls">
        <button type="button" class="image-crop-aspect is-active" data-aspect="portrait">Portrait 4:5</button>
        <button type="button" class="image-crop-aspect" data-aspect="landscape">Landscape 5:4</button>
    </div>
    {
        /* the stage and the too-small caution share a row so the caution aligns to the top of the image
        (not the controls above it); the caution reserves no space while hidden, so it shifts no layout. */
    }
    <div class="image-crop-body">
        <div class="image-crop-stage">
            <img class="image-crop-img" alt="Crop preview" />
            <div class="image-crop-box">
                <div class="image-crop-handle"></div>
            </div>
        </div>
        {/* shown only while the selected region would be upscaled */}
        <div class="image-crop-warning field-warning" role="status" hidden>
            <span class="image-crop-warning-text"></span>
        </div>
    </div>
</div>

{
    /* Behaviour lives in a same-origin static file (public/js/image-crop.js) loaded with is:inline + src,
    NOT an Astro <script>: the bundler inlines small self-contained Astro scripts directly into the
    document, which the admin Content-Security-Policy (script-src 'self', no 'unsafe-inline'/nonce/hash)
    then blocks. An external same-origin script is covered by 'self'. defer runs it after the DOM is
    parsed so every .image-crop root exists. The compile-time contract (CropSelection,
    ImageCropChangeDetail, CLIENT_CANON, CLIENT_RATIO) still lives in scripts/image_crop.ts. */
}
<script is:inline defer src="/js/image-crop.js"></script>

---
/**
 * components/ImageCrop.astro
 *
 * The add/replace pages' image crop interface. Uploaded images are stored in exactly one of two canonical
 * shapes (portrait 4:5 or landscape 5:4 — see lib/api/images.ts), so this component lets the operator
 * choose the orientation and frame the crop before upload. It watches a file <input> (identified by
 * `inputId`), renders a preview with an aspect-locked crop box that can be dragged (pan) and resized
 * (zoom), and a Portrait/Landscape toggle that re-locks the box. The static markup lives here; the scoped
 * script below wires the behaviour.
 *
 * It is self-contained: it owns the too-small warning (shown when the selected region is smaller than its
 * canonical canvas and would be upscaled) and recolours the crop box to match. It reports the current selection by dispatching an `imagecrop:change` CustomEvent (detail:
 * ImageCropChangeDetail) on its root element, which the host page caches to forward on submit.
 */
interface Props {
    /** DOM id of the <input type="file"> whose selection drives the preview. */
    inputId: string
    /** DOM id for this component's root (where the host page listens for `imagecrop:change`). */
    id?: string
}
const { inputId, id = "image-crop" } = Astro.props
---
<div class="image-crop" id={id} data-input-id={inputId} hidden>
    <!-- too-small caution: occupies the slot just under the file input, mirroring the field warning it
         replaces; shown only while the selected region would be upscaled. -->
    <div class="image-crop-warning field-warning" role="status" hidden>
        <span class="image-crop-warning-text"></span>
    </div>
    <div class="image-crop-controls">
        <button type="button" class="image-crop-aspect is-active" data-aspect="portrait">Portrait 4:5</button>
        <button type="button" class="image-crop-aspect" data-aspect="landscape">Landscape 5:4</button>
    </div>
    <div class="image-crop-stage">
        <img class="image-crop-img" alt="Crop preview" />
        <div class="image-crop-box">
            <div class="image-crop-handle"></div>
        </div>
    </div>
</div>

<script>
    import { CLIENT_CANON, CLIENT_RATIO, type CropSelection, type ImageCropChangeDetail } from "../scripts/image_crop"

    type Aspect = CropSelection["aspect"]
    const DEFAULT_ASPECT: Aspect = "portrait"
    // smallest crop box width, as a fraction of the image, so the box stays grabbable
    const MIN_W = 0.1

    /** Wires one ImageCrop root: its file input, preview, crop box, orientation toggle, and warning. */
    function initImageCrop(root: HTMLElement): void {
        const input_id = root.dataset.inputId
        const file_input = input_id ? document.getElementById(input_id) : null
        const img = root.querySelector(".image-crop-img")
        const box = root.querySelector(".image-crop-box")
        const handle = root.querySelector(".image-crop-handle")
        const btn_portrait = root.querySelector<HTMLButtonElement>('.image-crop-aspect[data-aspect="portrait"]')
        const btn_landscape = root.querySelector<HTMLButtonElement>('.image-crop-aspect[data-aspect="landscape"]')
        const warning = root.querySelector<HTMLElement>(".image-crop-warning")
        const warning_text = root.querySelector<HTMLElement>(".image-crop-warning-text")
        if (!(file_input instanceof HTMLInputElement) || !(img instanceof HTMLImageElement) || !(box instanceof HTMLElement)
            || !(handle instanceof HTMLElement) || !btn_portrait || !btn_landscape || !warning || !warning_text) {
            console.warn("ImageCrop: missing expected elements", { input_id })
            return
        }

        // --- state (normalized 0..1, relative to the image) ---
        let aspect: Aspect = DEFAULT_ASPECT
        let natural: { width: number; height: number } | null = null
        let object_url: string | null = null
        const sel = { x: 0, y: 0, w: 1, h: 1 }

        /** The image's rendered pixel size (0 before layout). */
        const rendered = () => ({ w: img.clientWidth, h: img.clientHeight })

        /** Normalized box height that yields the target pixel ratio for a given normalized width. */
        const heightForWidth = (w: number): number => {
            if (!natural) return w
            // pixel ratio (w*W)/(h*H) = RATIO ⇒ h = w * (W/H) / RATIO; W/H == natural ratio
            return (w * (natural.width / natural.height)) / CLIENT_RATIO[aspect]
        }

        /** Largest crop box of the current aspect, centered on (cx, cy) and clamped inside the image. */
        const fitCentered = (cx: number, cy: number): void => {
            let w = 1
            let h = heightForWidth(w)
            if (h > 1) {
                h = 1
                w = natural ? CLIENT_RATIO[aspect] * (natural.height / natural.width) : 1
            }
            sel.w = w
            sel.h = h
            sel.x = Math.min(Math.max(0, cx - w / 2), 1 - w)
            sel.y = Math.min(Math.max(0, cy - h / 2), 1 - h)
        }

        /** Whether the current region's pixel size is below its canonical canvas (so it will be upscaled). */
        const isTooSmall = (): boolean => {
            if (!natural) return false
            const canon = CLIENT_CANON[aspect]
            return sel.w * natural.width < canon.w || sel.h * natural.height < canon.h
        }

        const currentCrop = (): CropSelection | null =>
            natural ? { aspect, x: sel.x, y: sel.y, w: sel.w, h: sel.h } : null

        /** Repaints the box, refreshes the too-small warning, and notifies the host of the new selection. */
        const sync = (): void => {
            const r = rendered()
            box.style.left = `${sel.x * r.w}px`
            box.style.top = `${sel.y * r.h}px`
            box.style.width = `${sel.w * r.w}px`
            box.style.height = `${sel.h * r.h}px`

            const too_small = isTooSmall()
            box.classList.toggle("is-warning", too_small)
            warning.hidden = !too_small
            if (too_small && natural) {
                const canon = CLIENT_CANON[aspect]
                const rw = Math.round(sel.w * natural.width)
                const rh = Math.round(sel.h * natural.height)
                warning_text.textContent = `This crop (${rw}x${rh}) is smaller than ${canon.w}x${canon.h}. The system will apply sharpening, but the image may still look blurry or pixelated.`
            }

            const detail: ImageCropChangeDetail = { crop: currentCrop(), natural, tooSmall: too_small }
            root.dispatchEvent(new CustomEvent("imagecrop:change", { detail }))
        }

        const setAspect = (next: Aspect): void => {
            aspect = next
            btn_portrait.classList.toggle("is-active", next === "portrait")
            btn_landscape.classList.toggle("is-active", next === "landscape")
            if (natural) {
                fitCentered(sel.x + sel.w / 2, sel.y + sel.h / 2)
                sync()
            }
        }

        // --- file loading ---
        const clear = (): void => {
            if (object_url) {
                URL.revokeObjectURL(object_url)
                object_url = null
            }
            img.removeAttribute("src")
            natural = null
            root.hidden = true
            box.classList.remove("is-warning")
            warning.hidden = true
        }

        const notifyCleared = (): void => {
            const detail: ImageCropChangeDetail = { crop: null, natural: null, tooSmall: false }
            root.dispatchEvent(new CustomEvent("imagecrop:change", { detail }))
        }

        const loadFile = (file: File | undefined): void => {
            clear()
            if (!file || !file.type.toLowerCase().startsWith("image/")) {
                notifyCleared()
                return
            }
            object_url = URL.createObjectURL(file)
            img.onload = () => {
                natural = { width: img.naturalWidth, height: img.naturalHeight }
                root.hidden = false
                fitCentered(0.5, 0.5)
                sync()
            }
            img.onerror = () => {
                clear()
                notifyCleared()
            }
            img.src = object_url
        }

        file_input.addEventListener("change", () => loadFile(file_input.files?.[0]))
        btn_portrait.addEventListener("click", () => setAspect("portrait"))
        btn_landscape.addEventListener("click", () => setAspect("landscape"))

        // --- drag (pan) and resize (zoom), both pointer-driven and clamped within the image ---
        let mode: "drag" | "resize" | null = null
        let start_px = { x: 0, y: 0 }
        let start_sel = { x: 0, y: 0, w: 0, h: 0 }

        const beginDrag = (evt: PointerEvent, kind: "drag" | "resize"): void => {
            if (!natural) return
            evt.preventDefault()
            mode = kind
            start_px = { x: evt.clientX, y: evt.clientY }
            start_sel = { ...sel }
            ;(evt.target as Element).setPointerCapture?.(evt.pointerId)
        }

        box.addEventListener("pointerdown", evt => {
            // the corner handle resizes; the rest of the box pans
            if (evt.target === handle) beginDrag(evt, "resize")
            else beginDrag(evt, "drag")
        })

        box.addEventListener("pointermove", evt => {
            if (!mode || !natural) return
            const r = rendered()
            if (r.w === 0 || r.h === 0) return
            const dx = (evt.clientX - start_px.x) / r.w
            const dy = (evt.clientY - start_px.y) / r.h
            if (mode === "drag") {
                sel.x = Math.min(Math.max(0, start_sel.x + dx), 1 - sel.w)
                sel.y = Math.min(Math.max(0, start_sel.y + dy), 1 - sel.h)
            } else {
                // resize from the top-left anchor: pointer x sets the new width, height follows the ratio
                let w = Math.max(MIN_W, start_sel.w + dx)
                w = Math.min(w, 1 - sel.x)
                let h = heightForWidth(w)
                if (sel.y + h > 1) {
                    h = 1 - sel.y
                    w = natural ? Math.min(1 - sel.x, (h * CLIENT_RATIO[aspect] * natural.width) / natural.height) : w
                }
                sel.w = w
                sel.h = h
            }
            sync()
        })

        const endDrag = (evt: PointerEvent): void => {
            mode = null
            ;(evt.target as Element).releasePointerCapture?.(evt.pointerId)
        }
        box.addEventListener("pointerup", endDrag)
        box.addEventListener("pointercancel", endDrag)

        // keep the box correct when the rendered image size changes (responsive layout)
        if (typeof ResizeObserver !== "undefined") {
            new ResizeObserver(() => { if (natural) sync() }).observe(img)
        }
    }

    document.querySelectorAll<HTMLElement>(".image-crop").forEach(initImageCrop)
</script>

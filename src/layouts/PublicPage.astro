---
/**
 * layouts/PublicPage.astro
 *
 * Base layout for public-facing pages, the public analog of AdminDocument. It renders the shared
 * public chrome (PublicHead in the document head, PublicHeader and PublicFooter around the body)
 * with the page content projected through <slot />.
 *
 * PublicHead emits the staging noindex directive, so every page built on this layout is kept out of
 * search indexes on the staging preview. Public pages are server-rendered (output: "server"); leave
 * them un-prerendered so the environment is resolved per request.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at 
 * https://github.com/micawoken/spot-kilmerviolin-website.
 * 
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */
import PublicHead from "../components/PublicHead.astro"
import PublicHeader from "../components/PublicHeader.astro"
import PublicFooter from "../components/PublicFooter.astro"
import { getSiteSettings } from "../lib/content/site"
import { getThemeHead } from "../lib/content/theme-head"
import { getNav, getFooterNav } from "../lib/content/nav"
// Binds the shared public chrome (body, PublicHeader, PublicFooter) to the theme's --dtk-* tokens, each
// with a styles/global.css --color-* fallback. Public-only: never imported by the admin (BaseHead), so the
// admin keeps its built-in palette. Loaded after global.css (imported by PublicHead) so its body rule wins.
import "../styles/public-chrome.css"
// Single source for every public search form's look (docs/dev/plan-prelaunch-features.md §10) — see that
// file's header for the full list of forms it replaces.
import "../styles/search-form.css"

interface Props {
    title?: string
    description?: string
    image?: string
    /** Pagefind filter value (e.g. "scope:database") applied to <body> via data-pagefind-filter, so a
     *  scoped search (see pages/search.astro's "scope" param) can restrict results to pages carrying it.
     *  Omitted entirely (not just empty) for a page with no scope, matching Pagefind's own convention. */
    pagefindFilter?: string
    /** When true, excludes the whole page from the Pagefind index via data-pagefind-ignore on <body> — for
     *  pages with no unique content of their own (e.g. the /entity and /database hub page, which is just a
     *  search box and nav tiles duplicated across two URLs). Pagefind then has nothing to index for the
     *  page, so it never appears as a search result. */
    pagefindIgnore?: boolean
    /** Pagefind content-type filter value ("page" | "post" | one of ENTITY_NOUN_SLUGS), emitted as
     *  "type:<value>" alongside pagefindFilter so /search's content-type checkboxes can narrow results.
     *  Defaults to "page" so every existing/future public page is tagged automatically with no caller
     *  change required — only [...slug].astro (posts) and entity/[noun]/[id].astro override it. */
    contentType?: string
}

// fall back to the CMS-managed site settings (which themselves fall back to the src/consts.ts defaults)
// when a page does not supply its own title/description
//
// getNav/getFooterNav are started here too, alongside settings/theme, even though their results aren't
// used until PublicHeader/PublicFooter render below: fetchSettings/fetchMenu memoize per build, so firing
// all four now lets them race over the network together instead of each component discovering — and
// paying for — its own read one at a time as the page renders top to bottom.
const [site, themeHead] = await Promise.all([getSiteSettings(), getThemeHead(), getNav(), getFooterNav()])
const { title = site.title, description = site.description, image, pagefindFilter, pagefindIgnore, contentType = "page" } =
    Astro.props
const bodyPagefindFilter = [`type:${contentType}`, pagefindFilter].filter(Boolean).join(", ")
---

<!doctype html>
<html lang="en">
    <head>
        <PublicHead title={title} description={description} image={image} />
        {/* Site-wide web fonts (design theme → fonts), self-hosted at build time (theme-fonts.ts) so the
            font file can be preloaded directly instead of routing through fonts.googleapis.com — see
            theme-fonts.ts for why that round trip made the theme font unreliable on a cold cache. Omitted
            entirely when no font is authored or self-hosting it failed for this build. */}
        {themeHead.fontFaceCss && (
            <>
                {themeHead.preloadHrefs.map((href) => (
                    <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
                ))}
                <style set:html={themeHead.fontFaceCss} />
            </>
        )}
        {/* The theme's --dtk-* custom properties, emitted site-wide so both the chrome (public-chrome.css)
            and any compositor design page resolve their token references. Omitted when no theme is
            published, leaving every binding on its --color-* fallback. */}
        {themeHead.tokenCss && <style set:html={themeHead.tokenCss} />}
        {/* Columns' single-column stacking breakpoint (theme-authored; see tokens.ts's
            columnsStackBreakpointCss). Always present, theme or not — it replaces what used to be a rule
            hardcoded into compositor.css. Harmless on a page with no .cmp-columns element. */}
        <style set:html={themeHead.columnsBreakpointCss} />
        {/* Cross-document view transitions (theme-authored; see tokens.ts's viewTransitionCss). Enabled by
            default, matching the site's original always-on global.css rule; "" (rendering nothing) when
            the theme has explicitly disabled it. Unsupported browsers (Firefox, Safari) just fall back to
            a normal navigation with no regression either way. */}
        {themeHead.viewTransitionCss && <style set:html={themeHead.viewTransitionCss} />}
        {/* Optional per-page head content. Design pages inject the compositor component stylesheet here;
            every other caller simply leaves it empty. */}
        <slot name="head" />
    </head>
    <body data-pagefind-filter={bodyPagefindFilter} data-pagefind-ignore={pagefindIgnore}>
        <PublicHeader />
        <main>
            <slot />
        </main>
        <PublicFooter />
    </body>
</html>

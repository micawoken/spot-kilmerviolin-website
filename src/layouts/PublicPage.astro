import PublicHead from "../components/PublicHead.astro"
import PublicHeader from "../components/PublicHeader.astro"
import PublicFooter from "../components/PublicFooter.astro"
import { getSiteSettings } from "../lib/content/site"
import { getThemeHead } from "../lib/content/theme-head"
import { getNav, getFooterNav } from "../lib/content/nav"
// pull in the public chrome theme settings
import "../styles/public-chrome.css"
// pull in search bar
import "../styles/search-form.css"

interface Props {
    title?: string
    description?: string
    image?: string
    /* allow setting of scope to database, if elected */
    pagefindFilter?: string
    /* whether to ignore from search */
    pagefindIgnore?: boolean
    /* content type used in pagefind - posts, pages, or an entity noun */
    contentType?: string
    /* noindex control */
    noindex?: boolean
}

// fall back to the CMS-managed site settings (which themselves fall back to the src/consts.ts defaults)
// when a page does not supply its own title/description

const [site, themeHead] = await Promise.all([getSiteSettings(), getThemeHead(), getNav(), getFooterNav()])
const {
    title = site.title,
    description = site.description,
    image,
    pagefindFilter,
    pagefindIgnore,
    contentType = "page",
    noindex
} = Astro.props

const themeCss = [themeHead.columnsBreakpointCss, themeHead.viewTransitionCss].filter(Boolean).join("\n\n")
---

<!doctype html>
<html lang="en">
    <head>
        <PublicHead title={title} description={description} image={image} noindex={noindex} />
        {/* Pulls in theme font link loading */}
        {
            themeHead.fontFaceCss &&
                themeHead.preloadHrefs.map((href) => (
                    <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
                ))
        }
        {/* Pull in root rules */}
        {(themeHead.fontFaceCss || themeHead.tokenCss) && <link rel="stylesheet" href="/theme-head.css" />}
        {/* Loads in optional components */}
        <slot name="head" />
        <style set:html={themeCss}></style>
    </head>
    <body data-pagefind-filter={`type:${contentType}`} data-pagefind-ignore={pagefindIgnore}>
        {/* Own element, not comma-joined onto <body>'s type: filter - see pagefindFilter's doc comment above. */}
        {pagefindFilter && <span hidden data-pagefind-filter={pagefindFilter} />}
        <a class="skip-link" href="#main-content">Skip to content</a>
        <PublicHeader />
        <main id="main-content">
            <slot />
        </main>
        <PublicFooter />
    </body>
</html>

import EntityIndex from "../../../components/entities/EntityIndex.astro"
import { fetchAllContributors, fetchComposers, fetchCompositions, fetchContributors } from "../../../lib/build/d1-api"
import { fetchPublishedEntityTemplates } from "../../../lib/build/design-api"
import {
    buildReferenceIndex,
    disambiguatedCompositionNames,
    entityRecords,
    type EntityRecord
} from "../../../lib/build/entity-records"
import { resolveEntityTemplates } from "../../../lib/build/entity-routes"
import { fetchEntitySlugIndex } from "../../../lib/build/entity-slug"
import { entityHref } from "../../../lib/compositor/composition-fields"
import { ENTITY_NOUN_SLUGS, type EntityNoun } from "../../../lib/compositor/entity-fields"

export const prerender = true

interface EntityListItem {
    id: number
    name: string
    href: string
}

export async function getStaticPaths() {
    const [composers, contributors, allContributors, compositions, entityTemplates, slugIndex] = await Promise.all([
        fetchComposers(),
        fetchContributors(),
        fetchAllContributors(),
        fetchCompositions(),
        fetchPublishedEntityTemplates(),
        fetchEntitySlugIndex()
    ])

    const resolutions = resolveEntityTemplates(entityTemplates)
    const nounHasPage = Object.fromEntries(
        resolutions.map(({ noun, template }) => [noun, template !== null])
    ) as Record<EntityNoun, boolean>
    const refs = buildReferenceIndex(composers, allContributors, nounHasPage, slugIndex)
    // Same as entity/[noun]/index.astro: disambiguates same-titled, same-composer works in this list only
    // - the detail page's own title (entityRecords' entry.name) is untouched
    const compositionNames = disambiguatedCompositionNames(compositions)

    // See entity/[noun]/index.astro's matching comment: declared inside getStaticPaths, not at module
    // scope, because Astro extracts getStaticPaths into its own build-time chunk
    const toListItem =
        (noun: EntityNoun) =>
        (record: EntityRecord): EntityListItem => ({
            id: Number(record.id),
            name: typeof record.entry.name === "string" ? record.entry.name : `#${record.id}`,
            href: entityHref(noun, record.slug)
        })

    const paths: { params: { noun: string }; props: { noun: EntityNoun; results: EntityListItem[] } }[] = []

    for (const { noun, template } of resolutions) {
        if (!template) continue // mirrors [id].astro's gate; no warning here to avoid duplicate build log noise

        const results = entityRecords(noun, composers, contributors, compositions, refs, slugIndex).map(
            toListItem(noun)
        )
        if (noun === "composition") {
            for (const item of results) item.name = compositionNames.get(item.id) ?? item.name
        }
        if (results.length === 0) continue

        paths.push({ params: { noun: ENTITY_NOUN_SLUGS[noun] }, props: { noun, results } })
    }

    return paths
}

const { noun, results } = Astro.props
---

<EntityIndex noun={noun} results={results} />

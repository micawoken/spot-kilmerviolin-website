---
/**
 * pages/search.astro
 *
 * Public site search. Static shell (prerendered, no JS-dependent server logic) around a Pagefind-powered
 * client search: Pagefind indexes `dist/client` after `astro build` (see the "build" script), which is
 * exactly the prerendered public output — `/admin` and `/_emdash` never render to static HTML (they are
 * server-rendered per-request, see layouts/AdminDocument.astro and the emdash integration), so they are
 * never crawled and can never appear in results without any allow/deny-list to maintain here.
 *
 * The index only exists post-build: `astro dev` does not run Pagefind, so search only works against a
 * built site (`npm run preview`, or the deployed worker) — see the empty-index handling in the script.
 *
 * Query syntax: typing a recognized `field:value` token (see lib/search/facets.ts's `parseFacetQuery`)
 * snaps this page to the same JSON+Pagefind hybrid
 * pages/search/advanced.astro uses, restricted to database entries — without exposing that page's
 * criteria form. A plain query with no recognized token behaves exactly as before.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at
 * https://github.com/micawoken/spot-kilmerviolin-website.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */
import PublicPage from "../layouts/PublicPage.astro"
import StaticBreadcrumbs from "../components/StaticBreadcrumbs.astro"

export const prerender = true
---

<PublicPage title="Search" description="Search the site">
    <div class="search-page">
        <StaticBreadcrumbs current="Search" />
        <h1>Search</h1>
        <p id="search-scope-note" class="search-scope-note" hidden>Searching database entries only.</p>
        <form id="search-form" role="search" class="search-form">
            <label for="search-input" class="visually-hidden">Search by keyword</label>
            <input
                type="search"
                id="search-input"
                name="q"
                placeholder="Search…"
                aria-label="Search query"
                autocomplete="off"
                required
            />
            <button type="submit">Search</button>
        </form>
        {/* Fixed above the content-type filter: leaving the page and jumping down it are both new actions,
            while content type only filters the results already on screen — see the fieldset below. The
            jump summary sits opposite the link (search-form.css's .search-actions) so a completed search
            reports itself without the visitor scrolling past the filters to find out. */}
        <div class="search-actions">
            <p class="search-advanced-link">
                <a href="/search/advanced" id="search-advanced-link">Advanced search →</a>
            </p>
            <p id="search-jump" class="search-jump" hidden></p>
        </div>
        {/* Populated by the client script from Pagefind's own `filters()` counts, and only once a search has
            actually run — a type absent from the index this build (zero pages of that kind) never renders a
            dead checkbox, and the control stays out of the way until there are results to filter. */}
        <fieldset id="search-type-filters" class="search-type-filters" hidden>
            <legend>Content type</legend>
        </fieldset>
        <p id="search-status" role="status" aria-live="polite"></p>
        <ul id="search-results"></ul>
        <div id="search-pagination"></div>
    </div>
</PublicPage>

<style>
    .search-page {
        /* Matches /search/advanced's `.search-page` so the search bar is the same width on both pages. */
        max-width: 48rem;
    }
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    #search-form {
        margin-block: var(--dtk-chrome-vertical-space-section, var(--dtk-space-section, 2.5rem));
    }
    #search-status {
        font-family: var(--dtk-type-label-family, ui-monospace, monospace);
        font-size: var(--dtk-type-label-size, 0.72rem);
        letter-spacing: var(--dtk-type-label-letter-spacing, 0.08em);
        text-transform: uppercase;
        color: var(--dtk-chrome-muted, var(--dtk-color-slate, var(--color-text-muted)));
        /* Stronger separation from the search controls above it than plain whitespace gives. Only shown
           once there's actual status text (see :not(:empty) below) — otherwise this hairline+padding would
           render as a bare empty line before any search has run. */
        margin-top: var(--dtk-chrome-vertical-space-section, var(--dtk-space-section, 2.5rem));
    }
    #search-status:not(:empty) {
        padding-top: var(--dtk-chrome-vertical-space-control, var(--dtk-space-sm, 0.75rem));
        border-top: var(--dtk-chrome-hairline-width, var(--dtk-border-hairline-width, 1px))
            var(--dtk-chrome-hairline-style, var(--dtk-border-hairline-style, solid))
            var(--dtk-chrome-hairline-color, var(--dtk-border-hairline-color, var(--shade-4)));
    }
    .search-scope-note {
        font-size: 0.85rem;
        color: var(--dtk-chrome-muted, var(--dtk-color-slate, var(--color-text-muted)));
        margin: var(--dtk-chrome-vertical-space-control, var(--dtk-space-xs, 0.5rem)) 0 0;
    }
    .search-type-filters {
        display: flex;
        flex-wrap: wrap;
        gap: var(--dtk-chrome-horizontal-space-control, var(--dtk-space-sm, 0.75rem));
        border: none;
        padding: 0;
        margin: var(--dtk-chrome-vertical-space-control, var(--dtk-space-sm, 0.75rem)) 0 0;
    }
    /* An author `display` declaration on the element itself (this file's rule above) beats the UA
       stylesheet's `[hidden] { display: none }` regardless of selector specificity — origin, not
       specificity, decides that cascade — so `hidden`/`.hidden = true` alone did nothing here without this
       explicit override. Without it, the empty "Content type" legend showed on every page load, before any
       search had run. */
    .search-type-filters[hidden] {
        display: none;
    }
    .search-type-filters legend {
        width: 100%;
        font-family: var(--dtk-type-label-family, ui-monospace, monospace);
        font-size: var(--dtk-type-label-size, 0.72rem);
        letter-spacing: var(--dtk-type-label-letter-spacing, 0.08em);
        text-transform: uppercase;
        color: var(--dtk-chrome-muted, var(--dtk-color-slate, var(--color-text-muted)));
        padding: 0;
        margin: 0 0 var(--dtk-chrome-vertical-space-control, var(--dtk-space-xs, 0.5rem));
    }
    .search-type-filters label {
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
    }
    /* On the row, not the link inside it: `#search-form`'s section-space bottom margin collapses with this
       (adjacent block siblings) and wins, which is what lands this at section-space below the search bar.
       The link itself must stay margin-free — a flex item collapses with nothing, so a margin there would
       add to this one instead of collapsing into it. See search-form.css's .search-actions. */
    .search-actions {
        margin: var(--dtk-chrome-vertical-space-control, var(--dtk-space-sm, 0.75rem)) 0 0;
    }
    /* The results list, its items and its pagination live in styles/search-form.css — identical on both
       search pages, and every node inside them is created by the client script at runtime, where Astro
       applies no scoping class. */
</style>

<script>
    import { matchesFacets, parseFacetQuery, type FacetEntry } from "../lib/search/facets"
    import { clearJumpLink, renderJumpLink } from "../lib/search/jump"
    import { computePageWindow, withPage, withShowAll, type PageWindow } from "../lib/search/pagination"

    /** Lazily loaded Pagefind module — only exists at `/pagefind/pagefind.js` once a build has indexed the
     * site (see the "build" npm script), so it is dynamically imported (never bundled: the path does not
     * exist in the source tree) and cached after the first successful load. See env.d.ts (PagefindApi) for
     * why this is a runtime cast rather than a typed import. */
    let pagefind: PagefindApi | null = null

    async function loadPagefind(): Promise<PagefindApi> {
        if (!pagefind) {
            // The path is built at runtime (not a string literal) so neither Vite nor TypeScript tries to
            // resolve this module now — it is generated post-build by the "build" npm script and does not
            // exist in the source tree.
            const pagefindPath = "/pagefind/pagefind.js"
            const mod = (await import(/* @vite-ignore */ pagefindPath)) as PagefindApi
            await mod.init()
            pagefind = mod
        }
        return pagefind
    }

    /** Lazily loaded, cached for the page's lifetime — only fetched when the query syntax snaps this page
     *  to database mode (see the module header). */
    let facetsCache: FacetEntry[] | null = null
    async function loadFacets(): Promise<FacetEntry[]> {
        if (!facetsCache) {
            const response = await fetch("/database-facets.json")
            facetsCache = response.ok ? ((await response.json()) as FacetEntry[]) : []
        }
        return facetsCache
    }

    const TYPE_LABELS: Record<string, string> = {
        page: "Pages",
        post: "Posts",
        composer: "Composers",
        work: "Works",
        contributor: "Contributors"
    }

    interface ResultItem {
        url: string
        title: string
        excerptHtml?: string
    }

    function currentParams(): URLSearchParams {
        return new URLSearchParams(location.search)
    }

    function setUrlParams(params: URLSearchParams): void {
        const url = new URL(location.href)
        url.search = params.toString()
        history.replaceState(null, "", url)
    }

    function pageStatusText(pageWindow: PageWindow): string {
        const noun = pageWindow.totalCount === 1 ? "result" : "results"
        if (pageWindow.showingAll) return `${pageWindow.totalCount} ${noun}`
        return `${pageWindow.start + 1}–${pageWindow.end} of ${pageWindow.totalCount} ${noun}`
    }

    // Wrapped in a function (rather than narrowing inline at module scope) so the guard clause's narrowing
    // of `status`/`results` is visible inside the nested closures below — TS does not carry module-scope
    // `if` narrowing into function bodies, only a function-scope early return.
    function initSearch(): void {
        const form = document.getElementById("search-form")
        const input = document.getElementById("search-input")
        const status = document.getElementById("search-status")
        const results = document.getElementById("search-results")
        const pagination = document.getElementById("search-pagination")
        const typeFilters = document.getElementById("search-type-filters")
        const advancedLink = document.getElementById("search-advanced-link")
        const jump = document.getElementById("search-jump")
        if (
            !(form instanceof HTMLFormElement) ||
            !(input instanceof HTMLInputElement) ||
            !status ||
            !results ||
            !pagination ||
            !(typeFilters instanceof HTMLFieldSetElement) ||
            !(advancedLink instanceof HTMLAnchorElement) ||
            !jump
        ) {
            return
        }
        // Rebound to their own (non-nullable) consts: TS narrows `status`/`results`/`input` above, but that
        // narrowing does not carry into the nested closures below, only a fresh binding's own static type.
        const statusEl = status
        const resultsEl = results
        const paginationEl = pagination
        const typeFiltersEl = typeFilters
        const inputEl = input
        const advancedLinkEl = advancedLink
        const jumpEl = jump

        // "database" restricts results to pages carrying data-pagefind-filter="scope:database" (the three
        // entity nouns' index/detail pages, see layouts/PublicPage.astro) — used by the /entity root
        // page's search box and the Puck pagefind-search component's "Database only" scope option.
        const scope = new URLSearchParams(location.search).get("scope")
        const scopeNote = document.getElementById("search-scope-note")
        if (scope === "database" && scopeNote) scopeNote.hidden = false

        // Reflects the current input into the "Advanced search" link's target so a visitor who already typed
        // something doesn't have to retype it there — carried as a `#q=` hash fragment (not a `?q=` search
        // param) since /search/advanced.astro only auto-runs a search off `location.search`, so the hash
        // prefills the field on arrival without executing anything.
        function updateAdvancedLink(): void {
            const query = inputEl.value.trim()
            advancedLinkEl.href = query ? `/search/advanced#q=${encodeURIComponent(query)}` : "/search/advanced"
        }
        inputEl.addEventListener("input", updateAdvancedLink)

        function selectedTypes(): string[] {
            return Array.from(typeFiltersEl.querySelectorAll<HTMLInputElement>("input[type=checkbox]:checked")).map(
                (checkbox) => checkbox.value
            )
        }

        function buildSearchOptions(): PagefindSearchOptions | undefined {
            const filters: Record<string, string[]> = {}
            const types = selectedTypes()
            if (types.length > 0) {
                // An explicit type selection fully defines scope on its own (and may mix database nouns with
                // "page"/"post"), so it replaces rather than joins the scope:database restriction below —
                // otherwise checking "Pages" here would never show a result, since every page fails
                // scope:database.
                filters.type = types
            } else if (scope === "database") {
                filters.scope = ["database"]
            }
            return Object.keys(filters).length > 0 ? { filters } : undefined
        }

        // Rebuilt after every plain-mode search from THAT search's own `.filters` (never a separate
        // `pf.filters()` call) — Pagefind computes each returned count as "results if this value were also
        // applied on top of the current filters/query" (docs/js-api-filtering), so a value already checked
        // doesn't drop its siblings' counts to zero and hide them; the numbers are also specific to the
        // current query rather than the whole site. Nothing renders (fieldset stays hidden) until a search
        // has actually produced these — see runSearch's early-return on an empty query.
        function updateTypeFilters(counts: Record<string, number>): void {
            typeFiltersEl.replaceChildren()
            const entries = Object.entries(counts).filter(([, count]) => count > 0)
            if (entries.length === 0) {
                typeFiltersEl.hidden = true
                return
            }
            const initialTypes = new Set(new URLSearchParams(location.search).getAll("type"))
            for (const [type, count] of entries) {
                const label = document.createElement("label")
                const checkbox = document.createElement("input")
                checkbox.type = "checkbox"
                checkbox.name = "type"
                checkbox.value = type
                checkbox.checked = initialTypes.has(type)
                checkbox.addEventListener("change", () => {
                    // A changed filter is a new result set — reflect the now-checked types into the URL
                    // (so pagination/back-forward/sharing keeps them) and reset back to page one.
                    const params = currentParams()
                    params.delete("type")
                    for (const selected of selectedTypes()) params.append("type", selected)
                    params.delete("page")
                    params.delete("perPage")
                    setUrlParams(params)
                    void runSearch(inputEl.value.trim(), params)
                })
                label.appendChild(checkbox)
                label.append(` ${TYPE_LABELS[type] ?? type} (${count})`)
                typeFiltersEl.appendChild(label)
            }
            typeFiltersEl.hidden = false
        }

        function renderResult(url: string, title: string, excerptHtml?: string): void {
            const item = document.createElement("li")
            const link = document.createElement("a")
            link.href = url
            link.textContent = title || url
            item.appendChild(link)
            if (excerptHtml) {
                const excerpt = document.createElement("p")
                excerpt.innerHTML = excerptHtml
                item.appendChild(excerpt)
            }
            resultsEl.appendChild(item)
        }

        function renderPagination(pageWindow: PageWindow, params: URLSearchParams): void {
            paginationEl.replaceChildren()
            if (pageWindow.totalPages <= 1 && pageWindow.showingAll) return
            const goTo = (nextParams: URLSearchParams): void => {
                setUrlParams(nextParams)
                void runSearch(inputEl.value.trim(), nextParams)
            }
            const nav = document.createElement("div")
            nav.className = "search-pagination"
            if (!pageWindow.showingAll) {
                const prev = document.createElement("button")
                prev.type = "button"
                prev.textContent = "← Previous"
                prev.disabled = pageWindow.page <= 1
                prev.addEventListener("click", () => goTo(withPage(params, pageWindow.page - 1)))
                nav.appendChild(prev)

                const label = document.createElement("span")
                label.textContent = `Page ${pageWindow.page} of ${pageWindow.totalPages}`
                nav.appendChild(label)

                const next = document.createElement("button")
                next.type = "button"
                next.textContent = "Next →"
                next.disabled = pageWindow.page >= pageWindow.totalPages
                next.addEventListener("click", () => goTo(withPage(params, pageWindow.page + 1)))
                nav.appendChild(next)
            }
            const toggle = document.createElement("button")
            toggle.type = "button"
            toggle.textContent = pageWindow.showingAll ? "Show paginated" : `Show all ${pageWindow.totalCount}`
            toggle.addEventListener("click", () => goTo(pageWindow.showingAll ? withPage(params, 1) : withShowAll(params)))
            nav.appendChild(toggle)
            paginationEl.appendChild(nav)
        }

        function renderItemsPaged(items: ResultItem[], params: URLSearchParams): void {
            renderJumpLink(jumpEl, statusEl, items.length)
            if (items.length === 0) {
                statusEl.textContent = "No results found."
                return
            }
            const pageWindow = computePageWindow(items.length, params)
            statusEl.textContent = pageStatusText(pageWindow)
            for (const item of items.slice(pageWindow.start, pageWindow.end)) {
                renderResult(item.url, item.title, item.excerptHtml)
            }
            renderPagination(pageWindow, params)
        }

        async function runDatabaseModeSearch(
            text: string,
            criteria: ReturnType<typeof parseFacetQuery>["criteria"],
            params: URLSearchParams
        ): Promise<void> {
            // Database mode never consults the content-type checkboxes (its scope:database restriction is
            // hardcoded below), so leaving a prior plain search's checkboxes on screen here would be inert
            // and misleading — hide them, matching the empty-query state.
            typeFiltersEl.hidden = true
            const facets = await loadFacets()
            const matched = facets.filter((entry) => matchesFacets(entry, criteria))
            if (text === "") {
                renderItemsPaged(
                    matched.map((entry) => ({ url: entry.url, title: entry.name })),
                    params
                )
                return
            }
            const matchedByUrl = new Map(matched.map((entry) => [entry.url, entry]))
            const pf = await loadPagefind()
            const search = await pf.search(text, { filters: { scope: ["database"] } })
            const items: ResultItem[] = []
            for (const result of search.results) {
                const data = await result.data()
                const entry = matchedByUrl.get(data.url)
                if (!entry) continue
                items.push({ url: data.url, title: data.meta.title || entry.name, excerptHtml: data.excerpt })
            }
            renderItemsPaged(items, params)
        }

        async function runPlainSearch(query: string, params: URLSearchParams): Promise<void> {
            const pf = await loadPagefind()
            const search = await pf.search(query, buildSearchOptions())
            updateTypeFilters(search.filters.type ?? {})
            renderJumpLink(jumpEl, statusEl, search.results.length)
            if (search.results.length === 0) {
                statusEl.textContent = "No results found."
                return
            }
            // Pagefind's results are lightweight refs until `.data()` is called — slicing to the current
            // page's window BEFORE fetching data means only the visible page's worth of results is ever
            // resolved, unlike the database-mode path above (which must resolve every hit up front to
            // intersect it against the JSON-matched URL set).
            const pageWindow = computePageWindow(search.results.length, params)
            statusEl.textContent = pageStatusText(pageWindow)
            for (const result of search.results.slice(pageWindow.start, pageWindow.end)) {
                const data = await result.data()
                renderResult(data.url, data.meta.title || data.url, data.excerpt)
            }
            renderPagination(pageWindow, params)
        }

        async function runSearch(query: string, params: URLSearchParams = currentParams()): Promise<void> {
            resultsEl.replaceChildren()
            paginationEl.replaceChildren()
            // Cleared up front, then re-rendered only once a search actually produces a count — otherwise
            // the previous search's total would sit there claiming to describe this one.
            clearJumpLink(jumpEl)
            if (query === "") {
                statusEl.textContent = ""
                typeFiltersEl.hidden = true
                return
            }
            statusEl.textContent = "Searching…"
            try {
                const { text, criteria, hasCriteria } = parseFacetQuery(query)
                if (hasCriteria) {
                    if (scopeNote) scopeNote.hidden = false
                    await runDatabaseModeSearch(text.trim(), criteria, params)
                    return
                }
                await runPlainSearch(query, params)
            } catch {
                // Most likely cause: the page was opened via `astro dev`, which never runs Pagefind, so
                // /pagefind/pagefind.js 404s. `npm run preview` (or the deployed site) has the real index.
                statusEl.textContent = "Search is unavailable right now."
            }
        }

        form.addEventListener("submit", (event) => {
            event.preventDefault()
            const query = input.value.trim()
            const params = currentParams()
            if (query) {
                params.set("q", query)
            } else {
                params.delete("q")
            }
            // A new query is a new result set — start back at page one.
            params.delete("page")
            params.delete("perPage")
            setUrlParams(params)
            void runSearch(query, params)
        })

        // deep-linking: /search?q=... runs immediately with no extra click
        const initialQuery = new URLSearchParams(location.search).get("q")
        if (initialQuery) {
            input.value = initialQuery
            updateAdvancedLink()
            void runSearch(initialQuery)
        } else {
            // The mirror of updateAdvancedLink above: /search/advanced's "← Back to search" carries its
            // keyword as a `#q=` hash fragment precisely so it prefills here without running, letting a
            // visitor carry a query between the two pages and edit it before searching again.
            const prefill = new URLSearchParams(location.hash.replace(/^#/, "")).get("q")
            if (prefill) {
                input.value = prefill
                updateAdvancedLink()
            }
        }
    }

    initSearch()
</script>

---
/**
 * pages/spike/puck-render.astro — THROWAWAY (Phase 0 spike; deleted before Phase 1 merges).
 *
 * Prerendered page rendering the spike Puck document with NO client: directive. The build must emit
 * the composed markup with zero <astro-island> elements and zero <script> tags (verified by
 * tools/check-zero-js.mjs). Includes a hardcoded --dtk-* token style block for spike (c) parity.
 *
 * NOTE: the impl plan placed this under src/pages/_spike/, but Astro excludes underscore-prefixed
 * paths from routing entirely (the page would never build), so it lives at /spike/ instead.
 */

import PuckRenderStatic from "../../spike/PuckRenderStatic"

export const prerender = true
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex" />
        <title>Puck static render spike</title>
        <style>
            :root {
                --dtk-color-band-primary: #f3ede2;
                --dtk-space-section-y: 2rem;
                --dtk-type-display-family: Georgia, serif;
                --dtk-type-body-family: system-ui, sans-serif;
            }
        </style>
    </head>
    <body>
        <PuckRenderStatic />
    </body>
</html>

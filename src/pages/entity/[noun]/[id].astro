import { Render } from "@puckeditor/core/rsc"

import PublicPage from "../../../layouts/PublicPage.astro"
import EntityOgMeta from "../../../components/EntityOgMeta.astro"
import EntityStructuredData from "../../../components/EntityStructuredData.astro"
import CompositorStyles from "../../../components/CompositorStyles.astro"
import { fetchAllContributors, fetchComposers, fetchCompositions, fetchContributors } from "../../../lib/build/d1-api"
import {
    fetchPublishedEntityTemplates,
    fetchPublishedTheme,
    type BuildEntityTemplate
} from "../../../lib/build/design-api"
import {
    buildReferenceIndex,
    buildRelatedWorksIndex,
    entityRecords,
    type RelatedWork
} from "../../../lib/build/entity-records"
import { entityMetaDescription } from "../../../lib/build/entity-meta"
import { resolveEntityTemplates } from "../../../lib/build/entity-routes"
import { loadBundledFileAlt } from "../../../lib/build/bundled-file-alt"
import {
    ENTITY_NOUN_LABELS,
    ENTITY_NOUN_SLUGS,
    entityFields,
    type EntityNoun
} from "../../../lib/compositor/entity-fields"
import { buildConfig, OUTLET_PROPS, TOKEN_PROPS } from "../../../lib/compositor/catalog"
import { hasBlockingError, lintDesign } from "../../../lib/compositor/lint"
import { resolvePublicImageUrl } from "../../../lib/compositor/media"
import { EMPTY_TOKEN_CATALOG, type TokenCatalog } from "../../../lib/compositor/tokens"

export const prerender = true

export async function getStaticPaths() {
    const [composers, contributors, allContributors, compositions, entityTemplates, theme, bundledFileAlt] =
        await Promise.all([
            fetchComposers(),
            fetchContributors(),
            fetchAllContributors(),
            fetchCompositions(),
            fetchPublishedEntityTemplates(),
            fetchPublishedTheme(),
            loadBundledFileAlt()
        ])

    const resolutions = resolveEntityTemplates(entityTemplates)
    const nounHasPage = Object.fromEntries(
        resolutions.map(({ noun, template }) => [noun, template !== null])
    ) as Record<EntityNoun, boolean>
    const refs = buildReferenceIndex(composers, allContributors, nounHasPage)
    const relatedWorksIndex = buildRelatedWorksIndex(composers, compositions, nounHasPage)

    const routes: {
        params: { noun: string; id: string }
        props: {
            template: BuildEntityTemplate
            entry: Record<string, unknown>
            theme: TokenCatalog | null
            bundledFileAlt: Record<string, string>
            relatedEntries: RelatedWork[]
        }
    }[] = []

    for (const { noun, template } of resolutions) {
        if (!template) continue // no is_default authored for this noun yet — no pages this build

        const records = entityRecords(noun, composers, contributors, compositions, refs)
        if (records.length === 0) {
            console.warn(`[build] entity noun "${noun}" has a default template but no D1 records — skipping its pages`)
            continue
        }

        const findings = lintDesign(
            template.doc,
            theme,
            TOKEN_PROPS,
            OUTLET_PROPS,
            { entry: records[0].entry, schemaFields: [...entityFields(noun)] },
            true
        )
        const label = `entity template "${template.slug}" (${noun})`
        for (const finding of findings.filter((candidate) => candidate.severity === "warning")) {
            console.warn(`[build] ${label} — ${finding.rule} at ${finding.path}: ${finding.message}`)
        }
        if (hasBlockingError(findings)) {
            const errors = findings
                .filter((finding) => finding.severity === "error")
                .map((finding) => `  ${finding.rule} at ${finding.path}: ${finding.message}`)
                .join("\n")
            throw new Error(
                `[build] ${label} fails the pairing lint:\n${errors}\n` +
                    "Fix the template in /admin/advanced/designs, or unpublish it."
            )
        }

        for (const record of records) {
            routes.push({
                params: { noun: ENTITY_NOUN_SLUGS[noun], id: record.id },
                props: {
                    template,
                    entry: record.entry,
                    theme,
                    bundledFileAlt,
                    relatedEntries: relatedWorksIndex.get(`${noun}:${record.id}`) ?? []
                }
            })
        }
    }

    return routes
}

const { template, entry, theme, bundledFileAlt, relatedEntries } = Astro.props
const title = typeof entry.name === "string" ? entry.name : undefined
const description = entityMetaDescription(template.collection, entry)
const mediaBaseUrl = import.meta.env.EMDASH_MEDIA_PUBLIC_URL ?? process.env.EMDASH_MEDIA_PUBLIC_URL
const filesBaseUrl = import.meta.env.FILES_PUBLIC_URL ?? process.env.FILES_PUBLIC_URL
const image = resolvePublicImageUrl(entry.image, mediaBaseUrl, filesBaseUrl)
---

<PublicPage
    title={title}
    description={description}
    image={image}
    pagefindFilter="scope:database"
    contentType={ENTITY_NOUN_SLUGS[template.collection]}
>
    <CompositorStyles slot="head" />
    <EntityOgMeta slot="head" entryDate={entry.entry_date} changeDate={entry.change_date} />
    <EntityStructuredData
        slot="head"
        noun={template.collection}
        entry={entry}
        description={description}
        image={image}
    />
    {
        /* Same render path as [...slug].astro's design branch (buildConfig + Render, zero client JS) — see
        that file's header for why. `fields` is passed at build (not just for the editor's pickers):
        `ContentField` uses each field's declared kind (date formatting, the default label) at render. */
    }
    <Render
        config={buildConfig(theme ?? EMPTY_TOKEN_CATALOG, "build", {
            entry,
            fields: [...entityFields(template.collection)],
            mediaBaseUrl,
            filesBaseUrl,
            // Entity pages always link Home / Database / {noun} / {item} — never the generic slug-prefix
            // walk route-authority.ts's breadcrumbAncestors does, since an entity page's URL
            // (/entity/{noun}/{id}) has no relationship to the published CMS route tree. /database is the
            // canonical database root, and the noun crumb
            // points at its /database/{noun}/ mirror (EntityIndex.astro) rather than /entity/{noun}/, so
            // the whole ancestor trail stays inside the canonical /database namespace — only this entry
            // itself (the current, unlinked crumb) is /entity-only, since entries are not mirrored.
            breadcrumbs: [
                { label: "Database", href: "/database" },
                {
                    label: ENTITY_NOUN_LABELS[template.collection],
                    href: `/database/${ENTITY_NOUN_SLUGS[template.collection]}/`
                }
            ],
            pageTitle: title,
            bundledFileAlt,
            relatedEntries
        })}
        data={template.doc.puck}
    />
</PublicPage>

---
/**
 * pages/entity/[noun]/index.astro
 *
 * Reachability index for the D1-backed entity detail pages (impl plan Step 6, "Listing"): before this
 * file existed, a published entity detail page had a URL but nothing on the site linked to it. Reuses
 * `ListResults.astro`/`ListResult.astro` — the same components the admin's `/admin/{noun}s/list` pages
 * use — with a non-"admin" `enviro`, which already makes `ListResult` point at the public
 * `/entity/{noun}/{id}` route instead of the admin edit route.
 *
 * Gated by the SAME dual-source rule as `[id].astro` (resolved default template AND at least one D1
 * record): an index for a noun with no detail pages would only be a list of links to 404s. The two
 * files independently re-fetch the D1 tables and the entity templates — Astro's build has no shared
 * cache between page files (matching the rest of this build; see `[...slug].astro`), so a noun with
 * both `[id].astro` and this file published pays for two reads. Accepted for now: this is the same cost
 * class as [...slug].astro's own per-collection reads, and adding a build-time cache is out of scope
 * for Step 6 (see docs/dev/handoff-entity-page-generation.md).
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at 
 * https://github.com/micawoken/spot-kilmerviolin-website.
 * 
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */

import PublicPage from "../../../layouts/PublicPage.astro"
import ListResults from "../../../components/entities/ListResults.astro"
import { fetchAllContributors, fetchComposers, fetchCompositions, fetchContributors } from "../../../lib/build/d1-api"
import { fetchPublishedEntityTemplates } from "../../../lib/build/design-api"
import { buildReferenceIndex, entityRecords } from "../../../lib/build/entity-records"
import { resolveEntityTemplates } from "../../../lib/build/entity-routes"
import { ENTITY_NOUN_LABELS, ENTITY_NOUN_SLUGS, type EntityNoun } from "../../../lib/compositor/entity-fields"
import "../../../styles/public-entities.css"

export const prerender = true

interface EntityListItem {
    id: number
    name: string
}

export async function getStaticPaths() {
    const [composers, contributors, allContributors, compositions, entityTemplates] = await Promise.all([
        fetchComposers(),
        fetchContributors(),
        fetchAllContributors(),
        fetchCompositions(),
        fetchPublishedEntityTemplates()
    ])

    const resolutions = resolveEntityTemplates(entityTemplates)
    const nounHasPage = Object.fromEntries(
        resolutions.map(({ noun, template }) => [noun, template !== null])
    ) as Record<EntityNoun, boolean>
    const refs = buildReferenceIndex(composers, allContributors, nounHasPage)

    // ListResults' ResultObject wants a numeric id, matching ListResult.astro's admin-list usage
    // (list.astro:51-55) — entityRecords stringifies id for Astro's route params, so it is parsed back here.
    // A record with no string `name` falls back to its id so the link is never unlabeled.
    // Declared inside getStaticPaths (not at module scope): Astro extracts getStaticPaths into its own
    // build-time chunk, and a module-scope helper referenced only from here was not carried into that
    // chunk (`ReferenceError: toListItem is not defined` at build time) — keeping it local guarantees it
    // is in scope regardless of how that extraction works.
    const toListItem = (record: { id: string; entry: Record<string, unknown> }): EntityListItem => ({
        id: Number(record.id),
        name: typeof record.entry.name === "string" ? record.entry.name : `#${record.id}`
    })

    const paths: { params: { noun: string }; props: { noun: EntityNoun; results: EntityListItem[] } }[] = []

    for (const { noun, template } of resolutions) {
        if (!template) continue // mirrors [id].astro's gate; no warning here to avoid duplicate build log noise

        const results = entityRecords(noun, composers, contributors, compositions, refs).map(toListItem)
        if (results.length === 0) continue

        paths.push({ params: { noun: ENTITY_NOUN_SLUGS[noun] }, props: { noun, results } })
    }

    return paths
}

const { noun, results } = Astro.props
const title = ENTITY_NOUN_LABELS[noun]

// This page is prerendered once at build time and served identically to every visitor, so "now" here is
// the build/generation time, not a per-request value — pinned to UTC (like catalog.tsx's
// ENTITY_DATE_FORMAT) so the same build always produces the same displayed timestamp regardless of the
// machine/CI runner's local zone.
const GENERATED_AT_FORMAT = new Intl.DateTimeFormat("en-US", {
    dateStyle: "long",
    timeStyle: "long",
    timeZone: "UTC"
})
const generatedAt = GENERATED_AT_FORMAT.format(new Date())
---

<PublicPage title={title} pagefindFilter="scope:database">
    {/* Single wrapper, not four bare children directly under <main>: public-chrome.css's
        `main > :not(.cmp-section, article)` rule insets each direct child individually via
        `var(--dtk-space-md)`. That token can be authored as a font-relative expression (e.g. a
        `clamp(..., (100vw - 66ch) / 2, ...)` reading-width trick) — a custom property's relative units
        resolve per consuming element, so the breadcrumbs/h1/list/footnote (each a different font size)
        would each compute a different actual inset, drifting out of alignment with each other and with
        the header at some viewport widths. Applying the inset once, on one wrapper that inherits the
        body's own font size, keeps this page's whole content column aligned with the header at every
        width. */}
    <div class="entity-index-body">
        {/* Hand-authored, not the Puck Breadcrumbs component (catalog.tsx): this page is pre-generated Astro,
            not a Puck design, so the component can never be placed here. Entity indexes always point straight
            to Home (docs/dev/miscellaneous.txt), skipping the /entity root as an intermediate crumb. */}
        <nav class="entity-breadcrumbs" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-current="page">{title}</li>
            </ol>
        </nav>
        <h1>{title}</h1>
        <ListResults noun={ENTITY_NOUN_SLUGS[noun]} enviro="public" results={results} />
        <p class="entity-index-generated-note">This page is auto-generated. Last generated {generatedAt}.</p>
    </div>
</PublicPage>

<style>
    .entity-index-generated-note {
        color: var(--dtk-chrome-muted, var(--dtk-color-slate, var(--color-text-muted)));
        font-size: 0.875rem;
        margin-top: var(--dtk-space-section, 2.5rem);
        padding-top: var(--dtk-space-md, 2rem);
        padding-bottom: 0;
        border-top: var(--dtk-chrome-hairline-width, var(--dtk-border-hairline-width, 1px))
            var(--dtk-chrome-hairline-style, var(--dtk-border-hairline-style, solid))
            var(--dtk-chrome-hairline-color, var(--dtk-border-hairline-color, var(--shade-3)));
        margin-bottom: 0;
    }
    .entity-breadcrumbs ol {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0;
        margin: 0 0 var(--dtk-space-sm, 1rem);
        padding: 0;
        list-style: none;
        font-family: var(--dtk-type-label-family, ui-monospace, monospace);
        font-size: var(--dtk-type-label-size, 0.85rem);
        color: var(--dtk-chrome-muted, var(--dtk-color-slate, var(--color-text-muted)));
    }
    .entity-breadcrumbs li:not(:first-child)::before {
        content: "/";
        margin-inline: 0.5em;
        opacity: 0.6;
    }
    .entity-breadcrumbs a {
        color: var(--dtk-chrome-link, var(--dtk-color-garnet, var(--color-link)));
    }
    .entity-breadcrumbs li[aria-current="page"] {
        color: var(--dtk-chrome-body-text, var(--dtk-color-ink, var(--color-text)));
    }
</style>

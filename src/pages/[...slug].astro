import { PortableText } from "emdash/ui"
import PublicPage from "../layouts/PublicPage.astro"
import FormattedDate from "../components/FormattedDate.astro"
import { fetchPublishedPages } from "../lib/build/emdash-api"

export const prerender = true

// Enumerate one static route per published page at build time. fetchPublishedPages reads the `pages`
// content type over EmDash's HTTP API and fails soft to [] (so a build without CMS access still succeeds,
// just with no content pages). Field names (title, description, content, published_at) mirror the `pages`
// content type; the route param is EmDash's top-level item slug, normalized in fetchPublishedPages.
//
// The page authored with slug "home" is the site's designated home page and is routed to "/" (an undefined
// rest-param matches the route's root) instead of "/home", so there is exactly one URL for it.
export async function getStaticPaths() {
    const pages = await fetchPublishedPages()
    return pages.map((page) => ({
        params: { slug: page.slug === "home" ? undefined : page.slug },
        props: {
            title: page.title,
            description: page.description,
            published_at: page.published_at,
            content: page.content
        }
    }))
}

const { title, description, published_at, content } = Astro.props
---

<PublicPage title={title} description={description}>
    <article>
        <h1>{title}</h1>
        {published_at && (
            <p class="last-updated">Last updated: <FormattedDate date={new Date(published_at)} /></p>
        )}
        <PortableText value={content} />
    </article>
</PublicPage>

import { PortableText } from "emdash/ui"
import { Render } from "@puckeditor/core/rsc"

import PublicPage from "../layouts/PublicPage.astro"
import FormattedDate from "../components/FormattedDate.astro"
import { fetchPublishedPages, fetchPublishedPosts } from "../lib/build/emdash-api"
import {
    fetchCollectionFields,
    fetchPublishedDesignPages,
    fetchPublishedTemplates,
    fetchPublishedTheme,
    type CollectionField
} from "../lib/build/design-api"
import { breadcrumbAncestors, collectRoutes } from "../lib/build/route-authority"
import { buildConfig, OUTLET_PROPS, TOKEN_PROPS } from "../lib/compositor/catalog"
import { hasBlockingError, lintDesign } from "../lib/compositor/lint"
import { EMPTY_TOKEN_CATALOG } from "../lib/compositor/tokens"
import compositorCss from "../lib/compositor/compositor.css?raw"

export const prerender = true

// Enumerate one static route per published page across both sources. The readers fail soft to []/null (so
// a build without CMS access still succeeds, just with no content pages), but a duplicate slug, an
// unreadable design document, or a design that fails the a11y lint all FAIL the build — each of those
// would otherwise ship a broken or silently-missing public page.
//
// The page authored with slug "home" is the site's designated home page and is routed to "/" (an undefined
// rest-param matches the route's root) instead of "/home", so there is exactly one URL for it.
export async function getStaticPaths() {
    const [pages, posts, designPages, templates, theme] = await Promise.all([
        fetchPublishedPages(),
        fetchPublishedPosts(),
        fetchPublishedDesignPages(),
        fetchPublishedTemplates(),
        fetchPublishedTheme()
    ])

    // Lint every published design before it can reach the build output. Errors are the a11y/safety rules
    // the editor's Publish dialog already blocks on; reaching here means a design was published around the
    // editor (API-direct), so the build is the last line of defense. Warnings are logged, not fatal.
    for (const designPage of designPages) {
        const findings = lintDesign(designPage.doc, theme, TOKEN_PROPS, OUTLET_PROPS, undefined, true)
        for (const finding of findings.filter((candidate) => candidate.severity === "warning")) {
            console.warn(`[build] design "${designPage.slug}" — ${finding.path}: ${finding.message}`)
        }
        if (hasBlockingError(findings)) {
            const errors = findings
                .filter((finding) => finding.severity === "error")
                .map((finding) => `  ${finding.path}: ${finding.message}`)
                .join("\n")
            throw new Error(
                `[build] design page "${designPage.slug}" fails the design lint and cannot be published:\n` +
                    `${errors}\n` +
                    "Fix it in /admin/designs, or unpublish the page."
            )
        }
    }

    // Resolve every entry to the layout it renders through (D4). A broken template reference is a warning
    // and falls back to the untemplated render; an authored-wrong pairing throws from collectRoutes.
    const { routes, warnings } = collectRoutes({ pages, posts, designPages, templates })
    for (const warning of warnings) console.warn(warning)

    // Pairing lint per (template × entry) route (§5.5) — the sharpest post-pivot edge: heading order
    // stops being a property of one document once template and entry combine, and entries are published
    // in the EmDash admin with no compositor lint, so this build is the FIRST gate for entry-caused
    // failures. Schema reads fail soft to null (fetchCollectionFields warns; the dangling-field rule is
    // skipped); lint errors fail the build naming entry + template + rule.
    const schemaByCollection = new Map<string, CollectionField[] | null>()
    for (const route of routes) {
        if (route.props.kind !== "design" || !route.props.template) continue
        const { collection } = route.props.template
        if (!schemaByCollection.has(collection)) {
            schemaByCollection.set(collection, await fetchCollectionFields(collection))
        }
        const findings = lintDesign(
            route.props.doc,
            theme,
            TOKEN_PROPS,
            OUTLET_PROPS,
            { entry: route.props.entry, schemaFields: schemaByCollection.get(collection) ?? null },
            true
        )
        const label = `entry "${route.slug || "(home)"}" × template "${route.props.template.slug}"`
        for (const finding of findings.filter((candidate) => candidate.severity === "warning")) {
            console.warn(`[build] ${label} — ${finding.rule} at ${finding.path}: ${finding.message}`)
        }
        if (hasBlockingError(findings)) {
            const errors = findings
                .filter((finding) => finding.severity === "error")
                .map((finding) => `  ${finding.rule} at ${finding.path}: ${finding.message}`)
                .join("\n")
            throw new Error(
                `[build] ${label} fails the pairing lint:\n${errors}\n` +
                    "Fix the template in /admin/designs, or fix the entry's content in the EmDash admin."
            )
        }
    }

    return routes.map((route) => ({
        params: { slug: route.slug === "home" ? undefined : route.slug },
        props: { ...route.props, theme, breadcrumbs: breadcrumbAncestors(routes, route.slug) }
    }))
}

const props = Astro.props

// The compositor component stylesheet, inlined into this design page's head. The theme's --dtk-* token
// block is emitted site-wide by PublicPage (getThemeHead), so it is not repeated here. Kept off
// Portable-Text pages entirely — they render no compositor components. With no published theme, the
// component styles' token-backed declarations fall back to their initial values.
const headCss = props.kind === "design" ? compositorCss : ""
---

{
    props.kind === "portable" ? (
        <PublicPage title={props.title} description={props.description}>
            <article>
                <h1>{props.title}</h1>
                {props.published_at && (
                    <p class="last-updated">
                        Last updated: <FormattedDate date={new Date(props.published_at)} />
                    </p>
                )}
                <PortableText value={props.content} />
            </article>
        </PublicPage>
    ) : (
        <PublicPage title={props.title} description={props.description}>
            <style slot="head" set:html={headCss} />
            {/* Puck's config holds React render functions, so it cannot travel through getStaticPaths
                props (those are serialized); it is rebuilt here from the serializable theme. The "build"
                target swaps the two editor-only fields for passthroughs so stored Portable Text reaches
                the renderer intact (§6.3). The entry context feeds the content outlets (D7): the routed
                entry's fields for a templated route, null for a design_page — where outlets render
                nothing. No client directive → server-rendered, zero JS. */}
            <Render
                config={buildConfig(props.theme ?? EMPTY_TOKEN_CATALOG, "build", {
                    entry: props.entry,
                    mediaBaseUrl: import.meta.env.EMDASH_MEDIA_PUBLIC_URL ?? process.env.EMDASH_MEDIA_PUBLIC_URL,
                    breadcrumbs: props.breadcrumbs,
                    pageTitle: props.title
                })}
                data={props.doc.puck}
            />
        </PublicPage>
    )
}

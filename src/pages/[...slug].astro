import { PortableText } from "emdash/ui"
import { Render } from "@puckeditor/core/rsc"

import PublicPage from "../layouts/PublicPage.astro"
import FormattedDate from "../components/FormattedDate.astro"
import CompositorStyles from "../components/CompositorStyles.astro"
import { fetchPublishedPages, fetchPublishedPosts } from "../lib/build/emdash-api"
import {
    fetchCollectionFields,
    fetchPublishedDesignPages,
    fetchPublishedTemplates,
    fetchPublishedTheme,
    partitionDesignPages,
    type CollectionField
} from "../lib/build/design-api"
import { breadcrumbAncestors, collectRoutes, POSTS_PREFIX } from "../lib/build/route-authority"
import { buildConfig, OUTLET_PROPS, TOKEN_PROPS } from "../lib/compositor/catalog"
import { hasBlockingError, lintDesign } from "../lib/compositor/lint"
import { resolvePublicImageUrl } from "../lib/compositor/media"
import { EMPTY_TOKEN_CATALOG } from "../lib/compositor/tokens"

export const prerender = true

// Enumerate one static route per published page across both sources
export async function getStaticPaths() {
    const [pages, posts, allDesignPages, templates, theme] = await Promise.all([
        fetchPublishedPages(),
        fetchPublishedPosts(),
        fetchPublishedDesignPages(),
        fetchPublishedTemplates(),
        fetchPublishedTheme()
    ])

    // The reserved 404 design page is owned entirely by pages/404.astro (own fetch, lint, render)
    const { routable: designPages } = partitionDesignPages(allDesignPages)

    // Lint every published design before it reaches build output
    for (const designPage of designPages) {
        const findings = lintDesign(designPage.doc, theme, TOKEN_PROPS, OUTLET_PROPS, undefined, true)
        for (const finding of findings.filter((candidate) => candidate.severity === "warning")) {
            console.warn(`[build] design "${designPage.slug}" - ${finding.path}: ${finding.message}`)
        }
        if (hasBlockingError(findings)) {
            const errors = findings
                .filter((finding) => finding.severity === "error")
                .map((finding) => `  ${finding.path}: ${finding.message}`)
                .join("\n")
            throw new Error(
                `[build] design page "${designPage.slug}" fails the design lint and cannot be published:\n` +
                    `${errors}\n` +
                    "Fix it in /admin/advanced/designs, or unpublish the page."
            )
        }
    }

    // Resolve every entry to the layout it renders through
    const { routes, warnings } = collectRoutes({ pages, posts, designPages, templates })
    for (const warning of warnings) console.warn(warning)

    const schemaByCollection = new Map<string, CollectionField[] | null>()
    for (const route of routes) {
        if (route.props.kind !== "design" || !route.props.template) continue
        const { collection } = route.props.template
        if (!schemaByCollection.has(collection)) {
            schemaByCollection.set(collection, await fetchCollectionFields(collection))
        }
        const findings = lintDesign(
            route.props.doc,
            theme,
            TOKEN_PROPS,
            OUTLET_PROPS,
            { entry: route.props.entry, schemaFields: schemaByCollection.get(collection) ?? null },
            true
        )
        const label = `entry "${route.slug || "(home)"}" × template "${route.props.template.slug}"`
        for (const finding of findings.filter((candidate) => candidate.severity === "warning")) {
            console.warn(`[build] ${label} - ${finding.rule} at ${finding.path}: ${finding.message}`)
        }
        if (hasBlockingError(findings)) {
            const errors = findings
                .filter((finding) => finding.severity === "error")
                .map((finding) => `  ${finding.rule} at ${finding.path}: ${finding.message}`)
                .join("\n")
            throw new Error(
                `[build] ${label} fails the pairing lint:\n${errors}\n` +
                    "Fix the template in /admin/advanced/designs, or fix the entry's content in the EmDash admin."
            )
        }
    }

    return routes.map((route) => ({
        params: { slug: route.slug === "home" ? undefined : route.slug },
        props: { ...route.props, theme, breadcrumbs: breadcrumbAncestors(routes, route.slug) }
    }))
}

const props = Astro.props

// route.slug already carries the "posts/" prefix routedSlug() applies (route-authority.ts), and that's
// exactly what the rest-param route matches it on, so the same prefix check identifies a post here
const slugParam = Astro.params.slug
const isPost = typeof slugParam === "string" && slugParam.startsWith(`${POSTS_PREFIX}/`)
const contentType = isPost ? "post" : "page"

const mediaBaseUrl = import.meta.env.EMDASH_MEDIA_PUBLIC_URL ?? process.env.EMDASH_MEDIA_PUBLIC_URL
const filesBaseUrl = import.meta.env.FILES_PUBLIC_URL ?? process.env.FILES_PUBLIC_URL
// The entry's `featured_image` (route-authority.ts's RouteProps.image), resolved to a public URL for
// og:image/twitter:image
const image = resolvePublicImageUrl(props.image, mediaBaseUrl, filesBaseUrl)
---

{
    props.kind === "portable" ? (
        <PublicPage title={props.title} description={props.description} image={image} contentType={contentType}>
            <article>
                <h1>{props.title}</h1>
                {props.published_at && (
                    <p class="last-updated">
                        Last updated: <FormattedDate date={new Date(props.published_at)} />
                    </p>
                )}
                <PortableText value={props.content} />
            </article>
        </PublicPage>
    ) : (
        <PublicPage title={props.title} description={props.description} image={image} contentType={contentType}>
            <CompositorStyles slot="head" />
            <Render
                config={buildConfig(props.theme ?? EMPTY_TOKEN_CATALOG, "build", {
                    entry: props.entry,
                    mediaBaseUrl,
                    filesBaseUrl,
                    breadcrumbs: props.breadcrumbs,
                    pageTitle: props.title
                })}
                data={props.doc.puck}
            />
        </PublicPage>
    )
}

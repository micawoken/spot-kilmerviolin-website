---
/**
 * pages/[...slug].astro
 *
 * Catch-all route for the CMS-authored public pages. Two published sources claim slugs (impl §6.6): the
 * `pages` content type and the compositor's `design_page` type. `route-authority.ts` merges them, fails
 * the build on any duplicate slug so a path always has exactly one owner, and — per the content-routing
 * pivot (D4) — resolves each `pages` entry to the design template it renders *through*, if it names one.
 * A page that names no template renders exactly as it did before the compositor existed (D3), which is
 * what keeps designs strictly opt-in.
 *
 * The page is prerendered: getStaticPaths() enumerates both sources at build time over EmDash's HTTP API
 * (src/lib/build/{emdash,design}-api.ts, through a Cloudflare Access service token). Because only
 * published slugs are built, an unknown path matches no route and is served the static 404 from the
 * Cloudflare ASSETS binding — with no D1 or KV lookup. Publishing or editing a page requires a site
 * rebuild (the admin Rebuild button) to regenerate these static pages.
 *
 * Design pages ship ZERO JavaScript: Puck's `Render` is imported from `@puckeditor/core/rsc` and used with
 * no client directive, so it server-renders to plain HTML. The theme's tokens are injected into the head
 * as `--dtk-*` custom properties alongside the component stylesheet. A design page does NOT emit an
 * automatic <h1>{title}</h1> — its headings come from the canvas (§4.5) — while a Portable-Text page still
 * does, preserving the pre-compositor output.
 *
 * As a rest-parameter route this has the lowest routing priority, so explicit files (index.astro,
 * privacy-policy.astro, the /admin and /api trees) always win.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */

import { PortableText } from "emdash/ui"
import { Render } from "@puckeditor/core/rsc"

import PublicPage from "../layouts/PublicPage.astro"
import FormattedDate from "../components/FormattedDate.astro"
import { fetchPublishedPages } from "../lib/build/emdash-api"
import { fetchPublishedDesignPages, fetchPublishedTemplates, fetchPublishedTheme } from "../lib/build/design-api"
import { collectRoutes } from "../lib/build/route-authority"
import { buildConfig, TOKEN_PROPS } from "../lib/compositor/catalog"
import { hasBlockingError, lintDesign } from "../lib/compositor/lint"
import { EMPTY_TOKEN_CATALOG, tokensToCss } from "../lib/compositor/tokens"
import compositorCss from "../lib/compositor/compositor.css?raw"

export const prerender = true

// Enumerate one static route per published page across both sources. The readers fail soft to []/null (so
// a build without CMS access still succeeds, just with no content pages), but a duplicate slug, an
// unreadable design document, or a design that fails the a11y lint all FAIL the build — each of those
// would otherwise ship a broken or silently-missing public page.
//
// The page authored with slug "home" is the site's designated home page and is routed to "/" (an undefined
// rest-param matches the route's root) instead of "/home", so there is exactly one URL for it.
export async function getStaticPaths() {
    const [pages, designPages, templates, theme] = await Promise.all([
        fetchPublishedPages(),
        fetchPublishedDesignPages(),
        fetchPublishedTemplates(),
        fetchPublishedTheme()
    ])

    // Lint every published design before it can reach the build output. Errors are the a11y/safety rules
    // the editor's Publish dialog already blocks on; reaching here means a design was published around the
    // editor (API-direct), so the build is the last line of defense. Warnings are logged, not fatal.
    for (const designPage of designPages) {
        const findings = lintDesign(designPage.doc, theme, TOKEN_PROPS)
        for (const finding of findings.filter((candidate) => candidate.severity === "warning")) {
            console.warn(`[build] design "${designPage.slug}" — ${finding.path}: ${finding.message}`)
        }
        if (hasBlockingError(findings)) {
            const errors = findings
                .filter((finding) => finding.severity === "error")
                .map((finding) => `  ${finding.path}: ${finding.message}`)
                .join("\n")
            throw new Error(
                `[build] design page "${designPage.slug}" fails the design lint and cannot be published:\n` +
                    `${errors}\n` +
                    "Fix it in /admin/designs, or unpublish the page."
            )
        }
    }

    // Resolve every entry to the layout it renders through (D4). A broken template reference is a warning
    // and falls back to the untemplated render; an authored-wrong pairing throws from collectRoutes.
    const { routes, warnings } = collectRoutes({ pages, designPages, templates })
    for (const warning of warnings) console.warn(warning)

    return routes.map((route) => ({
        params: { slug: route.slug === "home" ? undefined : route.slug },
        props: { ...route.props, theme }
    }))
}

const props = Astro.props

// The theme's custom properties plus the component stylesheet, inlined into this page's head. Kept off
// Portable-Text pages entirely — they render no compositor components. With no published theme, only the
// component styles are emitted and token-backed declarations fall back to their initial values.
const headCss =
    props.kind === "design" ? `${props.theme ? tokensToCss(props.theme) : ""}\n${compositorCss}` : ""
---

{
    props.kind === "portable" ? (
        <PublicPage title={props.title} description={props.description}>
            <article>
                <h1>{props.title}</h1>
                {props.published_at && (
                    <p class="last-updated">
                        Last updated: <FormattedDate date={new Date(props.published_at)} />
                    </p>
                )}
                <PortableText value={props.content} />
            </article>
        </PublicPage>
    ) : (
        <PublicPage title={props.title} description={props.description}>
            <style slot="head" set:html={headCss} />
            {/* Puck's config holds React render functions, so it cannot travel through getStaticPaths
                props (those are serialized); it is rebuilt here from the serializable theme. The "build"
                target swaps the two editor-only fields for passthroughs so stored Portable Text reaches
                the renderer intact (§6.3). No client directive → server-rendered, zero JS. */}
            <Render config={buildConfig(props.theme ?? EMPTY_TOKEN_CATALOG, "build")} data={props.doc.puck} />
        </PublicPage>
    )
}

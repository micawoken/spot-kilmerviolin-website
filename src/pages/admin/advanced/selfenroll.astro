import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

export const prerender = false

// the middleware has already resolved the caller's identity, so enrollability is known server-side
const identity = Astro.locals.identity ?? null
const enrollable = identity?.enrollable === true
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Self-Enrollment`} description="Complete self-enrollment to create your contributor record"/>
    <AdminHead />
</head>
<body>
    <AdminHeader identity={identity} welcome={false}/>
    <main class="admin-main" role="main">
    <h2>Self-Enrollment</h2>
    {
        enrollable ? (
            <>
                <p class="general-infohelp">Your login is not yet linked to a contributor record. Complete the following form to create one using self-enrollment.</p>
                <div class="generic-form">
                    <form id="advanced-form-selfenroll" class="generic-form">
                        <fieldset>
                            <legend>Name</legend>
                            <input type="text" id="advanced-form-selfenroll-name" name="name" required />
                        </fieldset>
                        <fieldset>
                            <legend>Major</legend>
                            <input type="text" id="advanced-form-selfenroll-major" name="major" />
                            <p class="general-infohelp">The field is optional; leave blank to omit.</p>
                        </fieldset>
                        <fieldset>
                            <legend>Class Year</legend>
                            <input type="number" id="advanced-form-selfenroll-class_year" name="class_year" />
                            <p class="general-infohelp">This field is optional; leave blank to omit.</p>
                        </fieldset>
                        <button type="submit">Submit</button>
                    </form>
                </div>
                <p id="transaction-status">Your request status will show here after you press "Submit".</p>
                <script>
                    import { enrollSelf } from "../../../scripts/connector"
                    import { disableInput, enableInput, getTransactionElem } from "../../../scripts/interface"

                    const form = document.getElementById("advanced-form-selfenroll") as HTMLFormElement
                    const message = getTransactionElem()

                    form.addEventListener("submit", async (evt: Event) => {
                        evt.preventDefault()
                        message.textContent = "Processing request..."
                        const form_data = new FormData(form)
                        disableInput(form)
                        try {
                            const name = String(form_data.get("name") ?? "")
                            // major and class_year are nullable columns: blank inputs are sent as null
                            const major_raw = String(form_data.get("major") ?? "").trim()
                            const major = major_raw === "" ? null : major_raw
                            const class_year_raw = String(form_data.get("class_year") ?? "").trim()
                            const class_year = class_year_raw === "" ? null : parseInt(class_year_raw)
                            if (!name) {
                                throw new Error("Self-enrollment requires a name")
                            }
                            if (class_year !== null && isNaN(class_year)) {
                                throw new Error("Class year must be a number (or left blank to omit)")
                            }
                            await enrollSelf({ name: name, major: major, class_year: class_year })
                            message.textContent = "Request succeeded: contributor record created. An administrator must activate your account before you can make changes."
                        } catch (error) {
                            message.textContent = `Error: ${error instanceof Error ? error.message : String(error)}`
                            console.error(error)
                            enableInput(form)
                        }
                    })
                </script>
            </>
        ) : (
            <>
                <p>Your login is not eligible for self-enrollment. You may already have a contributor record, or the site configuration has disabled self-enrollment.</p>
                <p class="general-infohelp">You can review your current authorization status in <a href="/admin/iam/whoami">My Authorization Info</a>. If you believe you should be enrollable, contact an administrator.</p>
            </>
        )
    }
    </main>
    <AdminFooter />
</body>
</html>

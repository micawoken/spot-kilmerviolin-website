---
import BaseHead from "../../../components/BaseHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

export const prerender = false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Database Terminal`} description="Execute SQL commands directly on the database"/>
    <meta name="robots" content="noindex" />
</head>
<body>
    <AdminHeader identity={Astro.locals.identity} welcome="false"/>
    <h2>Database Terminal</h2>
    <p class="general-warning">This terminal executes raw SQL directly on the production database, bypassing the validation performed by the regular editing pages. A malformed command can corrupt or destroy data. Requires administrator permissions.</p>
    <div class="generic-form">
        <form id="advanced-form-command" class="generic-form">
            <fieldset>
                <legend>SQL Command</legend>
                <textarea id="advanced-form-command-sql" name="sql" rows="6" cols="80" required></textarea>
            </fieldset>
            <button type="submit">Execute</button>
        </form>
    </div>
    <p id="transaction-status">Your request status will show here after you press "Execute".</p>
    <pre id="advanced-command-results"></pre>
    <script>
        import { executeCommand } from "../../../scripts/connector"
        import { disableInput, enableInput, getTransactionElem } from "../../../scripts/interface"

        const form = document.getElementById("advanced-form-command") as HTMLFormElement
        const results = document.getElementById("advanced-command-results")!
        const message = getTransactionElem()

        form.addEventListener("submit", async (evt: Event) => {
            evt.preventDefault()
            const form_data = new FormData(form)
            const sql = String(form_data.get("sql") ?? "").trim()
            if (!sql) {
                message.textContent = "Error: a SQL command is required"
                return
            }
            if (!confirm("Are you sure you want to execute this SQL command on the production database?")) {
                return
            }
            message.textContent = "Processing request..."
            results.textContent = ""
            disableInput(form)
            try {
                const result = await executeCommand(sql)
                message.textContent = "Request succeeded: command executed"
                results.textContent = JSON.stringify(result, null, 2)
            } catch (error) {
                message.textContent = `Error: ${error instanceof Error ? error.message : String(error)}`
                console.error(error)
            } finally {
                enableInput(form)
            }
        })
    </script>
    <AdminFooter />
</body>
</html>

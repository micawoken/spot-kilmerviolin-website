import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

export const prerender = false
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Database Terminal`}
            description="Execute SQL commands directly on the database"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Database Terminal</h2>
            <p class="general-warning">
                The terminal runs a command directly on the D1 SQLite database with no validation. A malformed or
                dangerous command could corrupt or destroy data. This operation requires administrator permissions.
            </p>
            <p class="general-infohelp">
                Please refer to the <a href="https://sqlite.org/lang.html" target="_blank" rel="noopener noreferrer"
                    >SQLite language documentation</a
                > to learn its SQL implementation.
            </p>
            <div class="generic-form">
                <form id="advanced-form-command" class="generic-form">
                    <fieldset>
                        <legend>SQL Command</legend>
                        <textarea id="advanced-form-command-sql" name="sql" rows="6" cols="80" required></textarea>
                        <p class="general-infohelp">
                            Press <kbd>Enter</kbd> to execute; use <kbd>Shift</kbd>+<kbd>Enter</kbd> for a new line. Separate
                            multiple commands with semicolons (<kbd>;</kbd>).
                        </p>
                    </fieldset>
                    <fieldset>
                        <legend>Batch Execution</legend>
                        <label class="command-batch-option">
                            <input type="checkbox" id="advanced-form-command-batch" name="batch" checked />
                            Run commands as a single atomic transaction (rollback upon failure)
                        </label>
                        <p class="general-infohelp">
                            Applies if multiple commands are entered. Uncheck to run multiple commands independently
                            without rollback.
                        </p>
                    </fieldset>
                    <div id="advanced-command-danger" class="command-danger hidden">
                        <!-- Shown only when the command appears to contain a destructive operation (see detectDangerousSql);
                    the user must acknowledge before the command can be sent. -->
                        <p class="general-warning" id="advanced-command-danger-text"></p>
                        <label class="command-danger-ack">
                            <input type="checkbox" id="advanced-command-danger-ack" name="danger_ack" />
                            I understand this command may irreversibly modify or destroy data, and I want to run it anyway.
                        </label>
                    </div>
                    <button type="submit">Execute</button>
                </form>
            </div>
            <p id="transaction-status">Your request status will show here after you press "Execute".</p>
            <div id="advanced-command-output" class="command-output hidden">
                <div class="command-view-toggle" role="group" aria-label="Response view">
                    <button type="button" id="command-view-formatted" class="command-view-button" aria-pressed="true"
                        >Formatted</button
                    >
                    <button type="button" id="command-view-raw" class="command-view-button" aria-pressed="false"
                        >Raw JSON</button
                    >
                </div>
                <p id="command-format-note" class="general-warning hidden"></p>
                <div id="advanced-command-formatted" class="command-formatted"></div>
                <pre id="advanced-command-raw" class="command-raw hidden"></pre>
            </div>
            <script>
                import { executeCommand } from "../../../scripts/connector"
                import { disableInput, enableInput, getTransactionElem } from "../../../scripts/interface"

                const form = document.getElementById("advanced-form-command") as HTMLFormElement
                const sql_input = document.getElementById("advanced-form-command-sql") as HTMLTextAreaElement
                const batch_input = document.getElementById("advanced-form-command-batch") as HTMLInputElement
                const danger_block = document.getElementById("advanced-command-danger")!
                const danger_text = document.getElementById("advanced-command-danger-text")!
                const danger_ack = document.getElementById("advanced-command-danger-ack") as HTMLInputElement
                const output = document.getElementById("advanced-command-output")!
                const formatted_container = document.getElementById("advanced-command-formatted")!
                const raw_container = document.getElementById("advanced-command-raw")!
                const format_note = document.getElementById("command-format-note")!
                const view_formatted_btn = document.getElementById("command-view-formatted") as HTMLButtonElement
                const view_raw_btn = document.getElementById("command-view-raw") as HTMLButtonElement
                const message = getTransactionElem()

                // regex to detect potentially destructive SQL operations, matched by keyword (may trigger false positives, but should never have a false negative)
                const DANGEROUS_SQL: { pattern: RegExp; label: string }[] = [
                    { pattern: /\bDROP\b/i, label: "DROP" },
                    { pattern: /\bALTER\b/i, label: "ALTER" },
                    { pattern: /\bTRUNCATE\b/i, label: "TRUNCATE" },
                    { pattern: /\bDELETE\b/i, label: "DELETE" },
                    { pattern: /\bREPLACE\b/i, label: "REPLACE" },
                    { pattern: /\bATTACH\b/i, label: "ATTACH" },
                    { pattern: /\bDETACH\b/i, label: "DETACH" },
                    { pattern: /\bVACUUM\b/i, label: "VACUUM" },
                    { pattern: /\bREINDEX\b/i, label: "REINDEX" }
                ]

                // Returns the distinct destructive keywords found in the given SQL (empty when none are present)
                function detectDangerousSql(sql: string): string[] {
                    return DANGEROUS_SQL.filter((op) => op.pattern.test(sql)).map((op) => op.label)
                }

                // Splits a textarea value into individual SQL commands on unquoted semicolons, so a multi-line
                // command (entered with Shift+Enter) stays intact while several semicolon-separated statements are
                // broken apart for batch submission. Semicolons inside single- or double-quoted string literals are
                // ignored, and doubled quotes ('' or "") are treated as escaped quotes within a literal. Blank
                // statements (e.g. a trailing semicolon) are dropped.
                function splitSqlCommands(sql: string): string[] {
                    const statements: string[] = []
                    let current = ""
                    let in_single = false
                    let in_double = false
                    for (let i = 0; i < sql.length; i++) {
                        const ch = sql[i]
                        if (ch === "'" && !in_double) {
                            if (in_single && sql[i + 1] === "'") {
                                // an escaped single quote inside a literal: consume both and stay in the literal
                                current += "''"
                                i++
                                continue
                            }
                            in_single = !in_single
                            current += ch
                        } else if (ch === '"' && !in_single) {
                            if (in_double && sql[i + 1] === '"') {
                                current += '""'
                                i++
                                continue
                            }
                            in_double = !in_double
                            current += ch
                        } else if (ch === ";" && !in_single && !in_double) {
                            if (current.trim() !== "") {
                                statements.push(current.trim())
                            }
                            current = ""
                        } else {
                            current += ch
                        }
                    }
                    if (current.trim() !== "") {
                        statements.push(current.trim())
                    }
                    return statements
                }

                // Run a check on the entered command, and if any potentially destructive operations are detected, reveal the acknowledgement block and require user ACK
                function refreshDangerState(): boolean {
                    const detected = detectDangerousSql(sql_input.value)
                    if (detected.length === 0) {
                        danger_block.classList.add("hidden")
                        danger_ack.checked = false
                        return false
                    }
                    danger_text.textContent = `This command contains a potentially destructive operation (${detected.join(", ")}). It may irreversibly modify or delete data. Confirm you understand before executing.`
                    danger_block.classList.remove("hidden")
                    return true
                }
                sql_input.addEventListener("input", refreshDangerState)

                // Toggle between formatted view and raw JSON view
                function showView(view: "formatted" | "raw"): void {
                    const formatted = view === "formatted"
                    formatted_container.classList.toggle("hidden", !formatted)
                    raw_container.classList.toggle("hidden", formatted)
                    view_formatted_btn.setAttribute("aria-pressed", String(formatted))
                    view_raw_btn.setAttribute("aria-pressed", String(!formatted))
                }
                view_formatted_btn.addEventListener("click", () => showView("formatted"))
                view_raw_btn.addEventListener("click", () => showView("raw"))

                // Renders a single cell value as text: NULL for null, empty for undefined, JSON for nested
                // objects/arrays, and the stringified value otherwise. Everything is set via textContent, so
                // result data is never interpreted as HTML.
                function cellText(value: unknown): string {
                    if (value === null) return "NULL"
                    if (value === undefined) return ""
                    if (typeof value === "object") return JSON.stringify(value)
                    return String(value)
                }

                // Appends a cell value to `parent`. SQL NULL is rendered as a lowercase, italic marker so it's
                // visually distinct from the string "null"; every other value is appended as plain text.
                function appendCellValue(parent: HTMLElement, value: unknown): void {
                    if (value === null) {
                        const null_marker = document.createElement("span")
                        null_marker.className = "command-null"
                        null_marker.textContent = "null"
                        parent.appendChild(null_marker)
                        return
                    }
                    parent.appendChild(document.createTextNode(cellText(value)))
                }

                // Builds the multi-column request-info block from the response's success flag and meta fields.
                function buildRequestInfo(result: any): HTMLElement {
                    const block = document.createElement("div")
                    block.className = "command-info-block"
                    const entries: [string, unknown][] = []
                    entries.push([
                        "success",
                        result?.success === true ? "true" : result?.success === false ? "false" : "(unknown)"
                    ])
                    const meta = result?.meta
                    if (meta !== null && typeof meta === "object") {
                        for (const [key, value] of Object.entries(meta)) {
                            entries.push([key, value])
                        }
                    }
                    for (const [key, value] of entries) {
                        // Each entry is one inline span that flows horizontally with the others. The key is a
                        // nested (bolded) span and the ": value" is appended after it, so the separator is part
                        // of the content itself rather than a CSS pseudo-element.
                        const item = document.createElement("span")
                        item.className = "command-info-item"
                        const label = document.createElement("span")
                        label.className = "command-info-key"
                        label.textContent = key
                        item.appendChild(label)
                        item.appendChild(document.createTextNode(": "))
                        appendCellValue(item, value)
                        block.appendChild(item)
                    }
                    return block
                }

                // Builds a results table whose headers are the union of the result objects' property names.
                function buildResultsTable(rows: Record<string, unknown>[]): HTMLElement {
                    const headers: string[] = []
                    const seen = new Set<string>()
                    for (const row of rows) {
                        for (const key of Object.keys(row)) {
                            if (!seen.has(key)) {
                                seen.add(key)
                                headers.push(key)
                            }
                        }
                    }
                    const table = document.createElement("table")
                    table.className = "command-results-table"
                    const thead = document.createElement("thead")
                    const header_row = document.createElement("tr")
                    for (const header of headers) {
                        const th = document.createElement("th")
                        th.textContent = header
                        header_row.appendChild(th)
                    }
                    thead.appendChild(header_row)
                    table.appendChild(thead)
                    const tbody = document.createElement("tbody")
                    for (const row of rows) {
                        const tr = document.createElement("tr")
                        for (const header of headers) {
                            const td = document.createElement("td")
                            appendCellValue(td, row[header])
                            tr.appendChild(td)
                        }
                        tbody.appendChild(tr)
                    }
                    table.appendChild(tbody)
                    // Wrap the table so a wide result set scrolls horizontally within this container instead of
                    // forcing the page layout wider than the viewport.
                    const scroll = document.createElement("div")
                    scroll.className = "command-table-scroll"
                    scroll.appendChild(table)
                    return scroll
                }

                // Builds the full formatted view: the request-info block followed by the result set, rendered as a
                // table when the rows are objects, a list for primitive rows, a note when empty/absent, or a JSON
                // dump for any other shape.
                function buildFormatted(result: any): HTMLElement {
                    const container = document.createElement("div")
                    container.appendChild(buildRequestInfo(result))
                    const section = document.createElement("div")
                    section.className = "command-results-section"
                    const results = result?.results
                    if (Array.isArray(results)) {
                        if (results.length === 0) {
                            const note = document.createElement("p")
                            note.textContent = "No rows returned."
                            section.appendChild(note)
                        } else if (
                            results.every(
                                (row: unknown) => row !== null && typeof row === "object" && !Array.isArray(row)
                            )
                        ) {
                            section.appendChild(buildResultsTable(results as Record<string, unknown>[]))
                        } else {
                            // an array of primitives (or mixed values) is rendered as a single-column list
                            const list = document.createElement("ul")
                            for (const item of results) {
                                const li = document.createElement("li")
                                appendCellValue(li, item)
                                list.appendChild(li)
                            }
                            section.appendChild(list)
                        }
                    } else if (results === undefined) {
                        const note = document.createElement("p")
                        note.textContent = "No result set returned."
                        section.appendChild(note)
                    } else {
                        // not a tabular result (e.g. a scalar or object payload): show it as formatted JSON
                        const pre = document.createElement("pre")
                        pre.textContent =
                            typeof results === "object" ? JSON.stringify(results, null, 2) : String(results)
                        section.appendChild(pre)
                    }
                    container.appendChild(section)
                    return container
                }

                // Renders the full response: a single D1Result is rendered directly, while an array of results
                // (returned for a multi-command request) is rendered as a labelled block per command, in order.
                function buildAllFormatted(result: any): HTMLElement {
                    if (!Array.isArray(result)) {
                        return buildFormatted(result)
                    }
                    const container = document.createElement("div")
                    result.forEach((item, index) => {
                        const block = document.createElement("section")
                        block.className = "command-result-group"
                        const heading = document.createElement("h3")
                        heading.className = "command-result-heading"
                        heading.textContent = `Command ${index + 1} of ${result.length}`
                        block.appendChild(heading)
                        block.appendChild(buildFormatted(item))
                        container.appendChild(block)
                    })
                    return container
                }

                async function runCommand(): Promise<void> {
                    const form_data = new FormData(form)
                    const sql = String(form_data.get("sql") ?? "").trim()
                    if (!sql) {
                        message.textContent = "Error: a SQL command is required"
                        return
                    }
                    // split into individual commands on unquoted semicolons; a single statement yields one entry
                    const commands = splitSqlCommands(sql)
                    if (commands.length === 0) {
                        message.textContent = "Error: a SQL command is required"
                        return
                    }
                    const batch = batch_input.checked
                    // destructive-operation gate: a flagged command cannot be sent until the acknowledgement is checked
                    if (refreshDangerState() && !danger_ack.checked) {
                        message.textContent =
                            "Error: this command may be destructive — check the acknowledgement box below the command to proceed."
                        danger_ack.focus()
                        return
                    }
                    const command_count_note =
                        commands.length > 1
                            ? ` ${commands.length} commands will run ${batch ? "as a single atomic batch (all-or-nothing)" : "sequentially, with no rollback"}.`
                            : ""
                    if (
                        !confirm(
                            `Are you sure you want to execute this SQL command on the production database?${command_count_note}`
                        )
                    ) {
                        return
                    }
                    message.textContent = "Processing request..."
                    output.classList.add("hidden")
                    formatted_container.replaceChildren()
                    raw_container.textContent = ""
                    format_note.classList.add("hidden")
                    format_note.textContent = ""
                    disableInput(form)
                    try {
                        const result = await executeCommand(commands, batch)
                        message.textContent =
                            commands.length > 1
                                ? `Request succeeded: ${commands.length} commands executed`
                                : "Request succeeded: command executed"
                        // the raw JSON view is always available as a fallback
                        raw_container.textContent = JSON.stringify(result, null, 2)
                        // attempt the formatted view; if rendering fails, fall back to raw and explain why
                        let default_view: "formatted" | "raw" = "formatted"
                        try {
                            formatted_container.appendChild(buildAllFormatted(result))
                        } catch (format_error) {
                            const reason = format_error instanceof Error ? format_error.message : String(format_error)
                            format_note.textContent = `Could not render the formatted view (${reason}); showing the raw JSON response instead.`
                            format_note.classList.remove("hidden")
                            default_view = "raw"
                            console.error("Failed to format command response:", format_error)
                        }
                        output.classList.remove("hidden")
                        showView(default_view)
                    } catch (error) {
                        message.textContent = `Error: ${error instanceof Error ? error.message : String(error)}`
                        console.error(error)
                    } finally {
                        enableInput(form)
                    }
                }

                form.addEventListener("submit", (evt: Event) => {
                    evt.preventDefault()
                    runCommand()
                })

                // submit on Enter; Shift+Enter (and the modifier combos) insert a newline for multi-line commands
                sql_input.addEventListener("keydown", (evt: KeyboardEvent) => {
                    if (
                        evt.key === "Enter" &&
                        !evt.shiftKey &&
                        !evt.ctrlKey &&
                        !evt.altKey &&
                        !evt.metaKey &&
                        !evt.isComposing
                    ) {
                        evt.preventDefault()
                        form.requestSubmit()
                    }
                })
            </script>
            <style>
                /* destructive-operation acknowledgement: a bordered callout between the command box and the Execute
           button, revealed only when a destructive keyword is detected */
                .command-danger {
                    border: 1px solid var(--shade-5);
                    border-left: 4px solid var(--shade-7);
                    border-radius: 6px;
                    background: var(--shade-2);
                    padding: 0.75rem 1rem;
                    margin-block: 0.75rem;
                }
                .command-danger > .general-warning {
                    margin-block-start: 0;
                }
                .command-danger-ack {
                    display: flex;
                    align-items: baseline;
                    gap: 0.5rem;
                    font-weight: 600;
                }
                /* batch-execution toggle: the checkbox sits inline with its descriptive label */
                .command-batch-option {
                    display: flex;
                    align-items: baseline;
                    gap: 0.5rem;
                }
                /* a multi-command response renders one labelled block per command, separated by a rule */
                .command-result-group + .command-result-group {
                    margin-block-start: 1.25rem;
                    padding-block-start: 1.25rem;
                    border-block-start: 1px solid var(--shade-5);
                }
                .command-result-heading {
                    margin-block: 0 0.5rem;
                    font-size: 1rem;
                }
                .command-output {
                    margin-block: 1rem;
                }
                .command-view-toggle {
                    display: flex;
                    gap: 0.5rem;
                    margin-block-end: 0.75rem;
                }
                /* the inactive view button is de-emphasized; the active one (aria-pressed) is highlighted */
                .command-view-button[aria-pressed="true"] {
                    font-weight: 600;
                    text-decoration: underline;
                }
                .command-view-button[aria-pressed="false"] {
                    opacity: 0.6;
                }
                .command-raw {
                    overflow-x: auto;
                }
                /* The formatted view's subtree is styled in the global block below — it's built in client
           script, so its elements never receive Astro's scoped-style marker and scoped rules can't
           reach them. */
            </style>
            <style is:global>
                /* These rules are global but rooted at #advanced-command-formatted so they only affect the
           dynamically generated formatted-response subtree, not the rest of the page. */

                /* request-info block: success + meta fields as horizontal wrapping "key: value" spans */
                #advanced-command-formatted .command-info-block {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.35rem 1.25rem;
                    margin-block-end: 1rem;
                }
                #advanced-command-formatted .command-info-item {
                    overflow-wrap: anywhere;
                }
                #advanced-command-formatted .command-info-key {
                    font-weight: 600;
                }
                /* SQL NULL marker: lowercase + italic so it reads as "absent value", not the string "null" */
                #advanced-command-formatted .command-null {
                    font-style: italic;
                    opacity: 0.75;
                }
                /* wide result sets scroll horizontally within this container rather than widening the page */
                #advanced-command-formatted .command-table-scroll {
                    overflow-x: auto;
                    max-width: 100%;
                }
                #advanced-command-formatted .command-results-table {
                    border-collapse: collapse;
                    width: max-content;
                }
                #advanced-command-formatted .command-results-table th,
                #advanced-command-formatted .command-results-table td {
                    border: 1px solid currentColor;
                    text-align: left;
                    padding: 0.25rem 0.5rem;
                    vertical-align: top;
                    white-space: nowrap;
                }
            </style>
        </main>
        <AdminFooter />
    </body>
</html>

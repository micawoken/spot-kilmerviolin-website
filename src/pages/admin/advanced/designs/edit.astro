---
/**
 * pages/admin/advanced/designs/edit.astro
 *
 * Full-viewport host for the visual editor (impl §6.5). Deliberately minimal — no AdminHeader/Footer
 * chrome, and AdminTypeface instead of the full AdminHead — because the Puck editor owns the whole
 * viewport and renders none of the admin entity components AdminHead's stylesheet exists for. The
 * typeface is NOT optional dressing: Puck's own UI asks for "Inter" by name, and without the @font-face
 * both it and our chrome fall back to the user-agent serif. It resolves the `design_page` id from the
 * query string and mounts the editor below; all loading, autosave, and publishing happen client-side
 * against the EmDash API (see DesignEditor.tsx). Middleware already gates /admin/advanced/designs/* on
 * design_editor (middleware/identity.ts).
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at 
 * https://github.com/micawoken/spot-kilmerviolin-website.
 * 
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */

import BaseHead from "../../../components/BaseHead.astro"
import AdminTypeface from "../../../components/AdminTypeface.astro"
import ReactRefreshPreamble from "../../../components/compositor/ReactRefreshPreamble.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

export const prerender = false

// A design id is required; without one there is nothing to edit, so send the user back to the list.
const id = Astro.url.searchParams.get("id")
if (!id) {
    return Astro.redirect("/admin/advanced/designs")
}

// `type=template` edits a design_template; anything else (or nothing) edits a design_page.
const kind = Astro.url.searchParams.get("type") === "template" ? "template" : "page"
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Edit Design`} description="Visual page editor" />
        <AdminTypeface />
        <ReactRefreshPreamble />
        <style is:global>
            body {
                margin: 0;
            }
        </style>
    </head>
    <body>
        <div id="design-editor" data-design-id={id} data-design-kind={kind}></div>

        <script>
            // Mounted from this module rather than as an Astro island (`client:only="react"`): for any
            // client directive Astro emits its island bootstrap as *inline* <script> tags, which carry no
            // nonce or hash and so are blocked by the admin CSP's script-src 'self' (middleware/headers.ts),
            // leaving the island unhydrated. The imports below keep this script an external hashed module,
            // which that CSP permits. Do not reintroduce a client directive on an /admin page.
            import { createElement } from "react"
            import { createRoot } from "react-dom/client"
            import DesignEditor from "../../../components/compositor/DesignEditor"

            const host = document.getElementById("design-editor")
            if (!host) throw new Error("The design editor host element is missing")

            // Set from the server-resolved query params above; edit.astro redirects when the id is absent.
            const id = host.dataset.designId
            if (!id) throw new Error("The design editor host element carries no design id")
            const kind = host.dataset.designKind === "template" ? ("template" as const) : ("page" as const)

            createRoot(host).render(createElement(DesignEditor, { id, kind }))
        </script>
    </body>
</html>

---
/**
 * pages/admin/advanced/designs/theme.astro
 *
 * The theme editor page (impl §6.5): admin chrome hosting the ThemeEditor island, which edits the
 * single `design_theme` item's token catalog (the `--dtk-*` values every design draws from, §4.3).
 * A form page rather than a canvas, so it keeps the normal AdminHeader/Footer chrome. Middleware
 * already gates /admin/advanced/designs/* on cms_editor (middleware/identity.ts).
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This file is part of the spot-kilmerviolin-website program, available at 
 * https://github.com/micawoken/spot-kilmerviolin-website.
 * 
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU Affero General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or (at your
 * option) any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU Affero General Public License for more details.
 *
 * You should have received a copy of the GNU Affero General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */

import BaseHead from "../../../../components/BaseHead.astro"
import AdminHead from "../../../../components/AdminHead.astro"
import AdminHeader from "../../../../components/AdminHeader.astro"
import AdminFooter from "../../../../components/AdminFooter.astro"
import ReactRefreshPreamble from "../../../../components/compositor/ReactRefreshPreamble.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../../consts"
import { guardPage } from "../../../../lib/api/page_auth"

export const prerender = false

// design_editor is required, matching ADMIN_PAGE_STRUCTURE (middleware/identity.ts). Repeated here so
// the page carries its own gate: a directory move once left the map entry stale and these pages
// reachable by any active contributor, with nothing to catch it.
const denied = guardPage(Astro.request, Astro.locals.identity, {
    kind: "permission",
    permissions: ["design_editor"]
})
if (denied) {
    return denied
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Design Theme`} description="Edit the design token theme" />
        <ReactRefreshPreamble />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Design Theme</h2>
            <p class="general-infohelp">
                Manage general design information, such as colors, fonts, and spacing that is used in design themes and pages.
            </p>
            <div id="theme-editor"></div>

            <script>
                // Mounted from this module rather than as an Astro island — see edit.astro for why a client
                // directive cannot be used under the admin CSP (middleware/headers.ts).
                import { createElement } from "react"
                import { createRoot } from "react-dom/client"
                import ThemeEditor from "../../../../components/compositor/ThemeEditor"

                const host = document.getElementById("theme-editor")
                if (!host) throw new Error("The theme editor host element is missing")

                createRoot(host).render(createElement(ThemeEditor, {}))
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

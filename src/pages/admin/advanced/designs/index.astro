import BaseHead from "../../../../components/BaseHead.astro"
import AdminHead from "../../../../components/AdminHead.astro"
import AdminHeader from "../../../../components/AdminHeader.astro"
import AdminFooter from "../../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../../consts"

export const prerender = false
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Designs`} description="Manage visual design pages" />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Designs</h2>
            <p class="general-warning">In most cases, a CMS page will work better. Only use designed pages when you need full design control.</p>
            <p class="general-infohelp">
                This system allows you to create custom pages with full design control.{" "}
                They are rendered as-is and not passed through templates.</p>
            <section class="design-create" aria-labelledby="design-create-heading">
                <h3 id="design-create-heading">Create a design</h3>
                <form id="design-create-form">
                    <label>
                        Name
                        <input type="text" id="design-name" name="name" required autocomplete="off" />
                    </label>
                    <label>
                        Slug
                        <input
                            type="text"
                            id="design-slug"
                            name="slug"
                            autocomplete="off"
                            placeholder="e.g. about, gallery/2026"
                        />
                    </label>
                    <button type="submit" id="design-create-button">Create and open editor</button>
                </form>
                <p id="design-create-status" role="status" aria-live="polite"></p>
            </section>

            <section aria-labelledby="design-list-heading">
                <h3 id="design-list-heading">Existing designs</h3>
                <p id="design-list-status" role="status" aria-live="polite">Loading designs…</p>
                <div id="design-list"></div>
            </section>

            <script>
                // A real module import forces Astro to emit this as an external hashed module (never inlined),
                // which the admin CSP (script-src 'self') permits; emptyDesignDoc pulls in no Puck/React runtime.
                import { emptyDesignDoc } from "../../../../lib/compositor/migrations"
                import { fetchItems, statusLabel, titleOf, errorMessage, type DesignItem } from "../../../../lib/compositor/design-list"

                const CONTENT_ENDPOINT = "/_emdash/api/content/design_page"
                const EDITOR_PATH = "/admin/advanced/designs/edit"

                const listStatus = document.getElementById("design-list-status") as HTMLParagraphElement
                const listContainer = document.getElementById("design-list") as HTMLDivElement
                const createForm = document.getElementById("design-create-form") as HTMLFormElement
                const createButton = document.getElementById("design-create-button") as HTMLButtonElement
                const createStatus = document.getElementById("design-create-status") as HTMLParagraphElement
                const nameInput = document.getElementById("design-name") as HTMLInputElement
                const slugInput = document.getElementById("design-slug") as HTMLInputElement

                /** Renders the fetched designs as a table, or an empty-state message. */
                function renderDesigns(items: DesignItem[]): void {
                    listContainer.replaceChildren()
                    if (items.length === 0) {
                        listStatus.textContent = "No designs yet. Create one above to get started."
                        return
                    }
                    listStatus.textContent = ""

                    const table = document.createElement("table")
                    table.className = "design-table"
                    const head = table.createTHead().insertRow()
                    for (const heading of ["Name", "Slug", "Status", "Updated", ""]) {
                        const th = document.createElement("th")
                        th.scope = "col"
                        th.textContent = heading
                        head.appendChild(th)
                    }

                    const body = table.createTBody()
                    for (const item of items) {
                        const row = body.insertRow()
                        row.insertCell().textContent = titleOf(item)
                        row.insertCell().textContent = item.slug ?? "—"
                        row.insertCell().textContent = statusLabel(item)
                        const updated = row.insertCell()
                        updated.textContent = item.updatedAt ? new Date(item.updatedAt).toLocaleString() : "—"
                        const actions = row.insertCell()
                        const link = document.createElement("a")
                        link.href = `${EDITOR_PATH}?id=${encodeURIComponent(item.id)}`
                        link.textContent = "Open editor"
                        actions.appendChild(link)
                    }
                    listContainer.appendChild(table)
                }

                async function loadDesigns(): Promise<void> {
                    listStatus.textContent = "Loading designs…"
                    try {
                        renderDesigns(await fetchItems(CONTENT_ENDPOINT))
                    } catch (error) {
                        listStatus.textContent = `Could not load designs: ${
                            error instanceof Error ? error.message : String(error)
                        }`
                        console.error(error)
                    }
                }

                /** Creates a draft design_page seeded with an empty design doc, then opens it in the editor. */
                async function createDesign(name: string, slug: string): Promise<void> {
                    const payload: Record<string, unknown> = {
                        data: { title: name, description: "", design: emptyDesignDoc() },
                        status: "draft"
                    }
                    if (slug) payload.slug = slug

                    const response = await fetch(CONTENT_ENDPOINT, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Accept: "application/json",
                            // EmDash's CSRF check requires this header on every state-changing request.
                            "X-EmDash-Request": "1"
                        },
                        body: JSON.stringify(payload)
                    })
                    if (!response.ok) throw new Error(await errorMessage(response))

                    // EmDash wraps a created item as { data: { item, _rev } } — the id is on `item`, not on
                    // `data` itself (emdash ContentResponse; same envelope fetchDesigns and DesignEditor read).
                    const body = (await response.json()) as { data?: { item?: { id?: string } } }
                    const id = body.data?.item?.id
                    if (!id) throw new Error("The design was created but no id was returned")
                    window.location.href = `${EDITOR_PATH}?id=${encodeURIComponent(id)}`
                }

                createForm.addEventListener("submit", async (event) => {
                    event.preventDefault()
                    const name = nameInput.value.trim()
                    const slug = slugInput.value.trim().replace(/^\/+|\/+$/g, "")
                    if (!name) {
                        createStatus.textContent = "Please enter a name."
                        return
                    }
                    createButton.disabled = true
                    createStatus.textContent = "Creating…"
                    try {
                        await createDesign(name, slug)
                        // navigation happens on success; leave the button disabled while it unloads
                    } catch (error) {
                        createStatus.textContent = `Could not create the design: ${
                            error instanceof Error ? error.message : String(error)
                        }`
                        console.error(error)
                        createButton.disabled = false
                    }
                })

                loadDesigns()
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

export const prerender = false

const locals = Astro.locals

const identity = locals.identity
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Advanced Options`} description="View advanced options" />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={identity} welcome={true} />
        <main id="admin-main-content" class="admin-main" role="main">
            <h2>Advanced Options</h2>
            <p class="general-infohelp">Advanced Options stores various administrative tools.</p>
            <div class="flex-container">
                <div class="column">
                    <ul>
                        <li><a href="/admin/advanced/command" class="col-item-link">Access database terminal</a></li>
                        <li><a href="/admin/advanced/metadata" class="col-item-link">View entity metadata</a></li>
                        <li><a href="/admin/advanced/selfenroll" class="col-item-link">View self-enrollment flow</a></li>
                        <li><a href="/admin/advanced/designs" class="col-item-link">Manage design pages</a></li>
                        <li><a href="/admin/advanced/designs/templates" class="col-item-link">Manage design templates</a></li>
                        <li><a href="/admin/advanced/designs/theme" class="col-item-link">Manage design theme</a></li>
                    </ul>
                </div>
            </div>
            <p class="general-helppointer">
                For help with these options, please review the <a
                    href="/admin/docs/advanced"
                    class="general-helppointer-link">Advanced Options</a
                > documentation.
            </p>
        </main>
        <AdminFooter />
    </body>
</html>

---
import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"
import { getCollection } from "astro:content"

export const prerender = false

const identity = Astro.locals.identity ?? null
// list every entry in the docs collection alphabetically by title; the slug is the entry id
const docs = (await getCollection("docs")).sort((a, b) => a.data.title.localeCompare(b.data.title))
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Documentation`}
            description="Documentation for the administrative services"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={identity} welcome={false} />
        <main class="admin-main" role="main">
            <div class="flex-container">
                <div class="column">
                    <h2>Documentation</h2>
                    {
                        docs.length === 0 ? (
                            <p>No documentation is available yet.</p>
                        ) : (
                            <ul>
                                {docs.map((doc) => (
                                    <li>
                                        <a href={`/admin/docs/${doc.id}`} class="col-item-link">
                                            {doc.data.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        )
                    }
                </div>
            </div>
        </main>
        <AdminFooter />
    </body>
</html>

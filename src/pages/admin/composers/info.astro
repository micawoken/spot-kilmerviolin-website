---
import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import IDEntryForm from "../../../components/entities/IDEntryForm.astro"
import ComposerInfo from "../../../components/entities/ComposerInfo.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

import { COMPOSER } from "../../../lib/api/d1"
import { getComposer } from "../../../lib/api/database"
import { guardPage } from "../../../lib/api/page_auth"
import { guardedRead } from "../../../lib/api/http"

export const prerender = false

// authorize before the direct (API-bypassing) database read below
const denied = guardPage(Astro.request, Astro.locals.identity, { kind: "active" })
if (denied) {
    return denied
}

// SSR is used if an ID is specified as a query param; otherwise, we'll load the client-side JS and ID entry
// check if an id query param exists
const id = Astro.url.searchParams.get("id")
let use_id: boolean = false
let composer_data: ComposerRecord | null = null
if (id) {
    // id param exists; a missing composers table surfaces the missing-table fallback page
    const result = await guardedRead(() => getComposer(Astro.locals.cfContext, COMPOSER.primary_key, id))
    if (result instanceof Response) {
        return result
    }
    composer_data = result
    if (!composer_data) {
        console.warn(`No composer found with ID ${id}, falling back to client-side ID entry`)
    } else {
        use_id = true
    }
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}View Composer`} description="View a composer" />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>View a Composer</h2>
            <IDEntryForm output_div={undefined} hidden={use_id} search={true} />
            <ComposerInfo composer={use_id ? (composer_data as ComposerRecord) : null} hidden={!use_id} />
            <p id="transaction-status">
                {
                    use_id
                        ? "Composer data loaded from URL."
                        : 'Your request status will show here after you press "Submit".'
                }
            </p>
            {
                // when loaded server-side via ?id=, mirror the client READ flow's follow-up links: edit this
                // record, or return to the ID-entry view to look up another (the path without the id query param)
                use_id ? (
                    <p>
                        <a href={`/admin/composers/edit?id=${id}`}>Edit this composer &gt;</a> |{" "}
                        <a href={Astro.url.pathname}>View another composer &gt;</a>
                    </p>
                ) : null
            }
            <script>
                import { getForm, genHandler, getTransactionElem } from "../../../scripts/interface"
                import { APIOpCode } from "../../../scripts/connector"
                import { attachKeywordSearchInline } from "../../../scripts/keyword_search"
                const form_or_button = getForm("composer", APIOpCode.READ)
                form_or_button.addEventListener(
                    form_or_button instanceof HTMLFormElement ? "submit" : "click",
                    genHandler(form_or_button, getTransactionElem(), APIOpCode.READ, "composer")
                )
                // keyword lookup scoped to composers; selecting a hit loads it on-page via the same READ flow as the ID entry form
                attachKeywordSearchInline(
                    "form-id-entry-search-input",
                    "form-id-entry-search-button",
                    "form-id-entry-search-results",
                    () => "composers",
                    (result) => {
                        const id_input = document.getElementById("form-id-entry-id")
                        if (id_input instanceof HTMLInputElement) id_input.value = String(result.id)
                        form_or_button.requestSubmit()
                    }
                )
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

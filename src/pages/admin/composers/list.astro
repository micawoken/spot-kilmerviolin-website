---
import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import ListResults from "../../../components/entities/ListResults.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

// list is rendered server-side
import { listComposers } from "../../../lib/api/database"
import { guardPage } from "../../../lib/api/page_auth"
import { guardedRead } from "../../../lib/api/http"

export const prerender = false

// authorize before the direct (API-bypassing) database read below
const denied = guardPage(Astro.request, Astro.locals.identity, { kind: "active" })
if (denied) {
    return denied
}

// pull the list; a missing composers table surfaces the missing-table fallback page rather than a raw 500
const composers = await guardedRead(() => listComposers(Astro.locals.cfContext))
if (composers instanceof Response) {
    return composers
}
if (!composers) {
    throw new Error("Failed to fetch the composers list from the database")
}

const formatted_composers = composers.map(composer => ({
    id: composer.id,
    name: composer.name,
    name2: `${composer.birth_year || "?"} - ${composer.death_year ? (composer.death_year === -1 ? "Present" : composer.death_year) : "?"}`,
}))

---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}List Composers`} description="View the list of composers in the database"/>
    <AdminHead />
</head>
<body>
    <AdminHeader identity={Astro.locals.identity} welcome={false}/>
    <main class="admin-main" role="main">
    <h2>List Composers</h2>
    <ListResults noun="composer" enviro="admin" results={formatted_composers} />
    </main>
    <AdminFooter />
</body>
</html>
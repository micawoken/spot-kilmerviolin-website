---
import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import IDEntryForm from "../../../components/entities/IDEntryForm.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

export const prerender = false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Delete Composer`} description="Delete a composer from the database"/>
    <AdminHead />
</head>
<body>
    <AdminHeader identity={Astro.locals.identity} welcome={false}/>
    <h2>Delete a Composer</h2>
    <p class="general-warning">Deletion is permanent. Composers that are referenced by compositions cannot be deleted.</p>
    <IDEntryForm output_div={undefined} hidden={false} />
    <p id="transaction-status">Your request status will show here after you press "Submit".</p>
    <script>
        import { getForm, genHandler, getTransactionElem } from "../../../scripts/interface"
        import { APIOpCode } from "../../../scripts/connector"
        const delete_form = getForm("composer", APIOpCode.DELETE)
        console.log("Form element obtained for composers delete operation:", delete_form)
        const handler = genHandler(delete_form, getTransactionElem(), APIOpCode.DELETE, "composer")
        delete_form.addEventListener("submit", (evt: Event) => {
            evt.preventDefault()
            if (!confirm("Are you sure you want to permanently delete this composer?")) {
                return
            }
            handler(evt)
        })
    </script>
    <AdminFooter />
</body>
</html>

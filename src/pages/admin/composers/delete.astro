import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import IDEntryForm from "../../../components/entities/IDEntryForm.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

export const prerender = false
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Delete Composer`} description="Delete a composer from the database" />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Delete a Composer</h2>
            <p class="general-warning">
                Deletion is permanent. Composers that are referenced by compositions cannot be deleted.
            </p>
            <IDEntryForm output_div={undefined} hidden={false} search={true} />
            <p id="transaction-status">Your request status will show here after you press "Submit".</p>
            <script>
                import { getForm, genHandler, getTransactionElem } from "../../../scripts/interface"
                import { APIOpCode } from "../../../scripts/connector"
                import { attachKeywordSearchInline } from "../../../scripts/keyword_search"
                const delete_form = getForm("composer", APIOpCode.DELETE)
                // keyword lookup scoped to composers; selecting a hit only fills the id field so the user can
                // review the target before pressing Submit (which is what triggers the delete confirmation)
                attachKeywordSearchInline(
                    "form-id-entry-search-input",
                    "form-id-entry-search-button",
                    "form-id-entry-search-results",
                    () => "composers",
                    (result) => {
                        const id_input = document.getElementById("form-id-entry-id")
                        if (id_input instanceof HTMLInputElement) id_input.value = String(result.id)
                    }
                )
                const handler = genHandler(delete_form, getTransactionElem(), APIOpCode.DELETE, "composer")
                delete_form.addEventListener("submit", (evt: Event) => {
                    evt.preventDefault()
                    if (!confirm("Are you sure you want to permanently delete this composer?")) {
                        return
                    }
                    handler(evt)
                })
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

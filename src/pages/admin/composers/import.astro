import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"
import { composer_csv_columns } from "../../../scripts/types"

export const prerender = false
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Import Composers`} description="Bulk-import composers from a CSV file" />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Import Composers from CSV</h2>
            <p class="general-infohelp">
                Upload a CSV file with these header columns (in any order):{" "}
                <code>{composer_csv_columns.join(", ")}</code>. Optional cells may be left blank. List cells (tags)
                separate multiple values with a semicolon (<code>;</code>). Max 999 rows per transaction.
            </p>
            <div class="import-controls">
                <input type="file" id="import-file" accept=".csv,text/csv" />
                <button type="button" id="import-load">Load file</button>
                <button type="button" id="import-validate">Validate with server</button>
                <button type="button" id="import-commit">Import</button>
            </div>
            <p id="import-error"></p>
            <div id="import-phasemap"></div>
            <p id="import-summary"></p>
            <div id="import-grid"></div>
            <p id="transaction-status">Load a file to begin.</p>
            <p class="general-helpinfo">
                Back to <a href="/admin/composers" class="general-helpinfo-link">Composers</a>.
            </p>
            <script>
                import { initImport } from "../../../scripts/import"
                initImport("composers")
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

---
import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import ContributorInfo from "../../components/entities/ContributorInfo.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

import { CONTRIBUTOR } from "../../lib/api/d1"
import { getContributor } from "../../lib/api/database"

export const prerender = false

// the middleware has already resolved the caller's identity; the profile is the caller's own record, so
// it is read directly by the caller's contributor id (a self read, so protected properties are fine to show)
const identity = Astro.locals.identity ?? null
const self_id = identity?.id ?? null

let contributor_data: ContributorRecord | null = null
if (self_id !== null && self_id !== undefined) {
    contributor_data = await getContributor(Astro.locals.cfContext, CONTRIBUTOR.primary_key, String(self_id))
    if (!contributor_data) {
        console.warn(`No contributor record found for self id ${self_id}`)
    }
}
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}My Profile`} description="View and manage your profile"/>
    <AdminHead />
</head>
<body>
    <AdminHeader identity={identity} welcome={false}/>
    <h2>My Profile</h2>
    {
        contributor_data ? (
            <>
                <p class="general-infohelp">This is your profile as it appears in the contributor database. To change your personal information, use <a href="/admin/profile/edit">Edit my profile</a>. To change the email you sign in with, use <a href="/admin/profile/reset_login">Change sign-in email</a>. Your sign-in email is shown below as the identity email.</p>
                <ContributorInfo contributor={contributor_data} />
                {
                    contributor_data.image ? (
                        <p class="general-infohelp">Image URL: <a href={contributor_data.image} id="profile-image-url">{contributor_data.image}</a></p>
                    ) : null
                }
                <div class="entity-result-details">
                    <p><a href="/admin/profile/edit" class="col-item-link">Edit my profile &gt;</a></p>
                    <p><a href="/admin/profile/reset_login" class="col-item-link">Change sign-in email &gt;</a></p>
                </div>
            </>
        ) : (
            identity?.enrollable ? (
                <p class="general-warning">Your login is not yet linked to a contributor record, so you have no profile to display. Complete <a href="/admin/advanced/selfenroll">self-enrollment</a> first.</p>
            ) : (
                <p>No profile information is available. You may be browsing without authentication (such as in local development), or your login has no associated contributor record.</p>
            )
        )
    }
    <AdminFooter />
</body>
</html>

import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import ListResults from "../../../components/entities/ListResults.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

// list is rendered server-side
import { listContributors } from "../../../lib/api/database"
import { guardPage } from "../../../lib/api/page_auth"
import { guardedRead } from "../../../lib/api/http"

export const prerender = false

// the list is read directly from the database (bypassing the API), so authorize before the read: any
// active caller may view the list. Only non-protected columns (name, major, class year) are rendered
// below, so no protected property is exposed to a non-admin (the protected columns are never read out).
const denied = guardPage(Astro.request, Astro.locals.identity, { kind: "active" })
if (denied) {
    return denied
}

// pull the list; a missing contributors table surfaces the missing-table fallback page rather than a raw 500
const contributors = await guardedRead(() => listContributors(Astro.locals.cfContext))
if (contributors instanceof Response) {
    return contributors
}
if (!contributors) {
    throw new Error("Failed to fetch the contributors list from the database")
}

// the caller's own contributor id, used to flag their row in the listing (mirrors the "(you)" marker
// on the user list); identity.id is the contributor id stored on the identity record
const self_id = Astro.locals.identity?.id

// name, major, and class_year are not protected properties (CONTRIBUTOR.protected covers roles, admin,
// and identity_email only), so every active caller — not just admins — may see them in the listing
const formatted_contributors = contributors.map((contributor) => ({
    id: contributor.id,
    name: contributor.name,
    // major and class_year are nullable; omit whichever is null instead of rendering "null"
    name2: [contributor.major, contributor.class_year !== null ? `${contributor.class_year}` : null]
        .filter((part) => part !== null)
        .join(" "),
    is_self: contributor.id === self_id
}))
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}List Contributors`}
            description="View the list of contributors in the database"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>List Contributors</h2>
            <ListResults noun="contributor" enviro="admin" results={formatted_contributors} />
        </main>
        <AdminFooter />
    </body>
</html>

---
import BaseHead from "../../../components/BaseHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import IDEntryForm from "../../../components/entities/IDEntryForm.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

export const prerender = false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Delete Contributor`} description="Delete a contributor from the database"/>
    <meta name="robots" content="noindex" />
</head>
<body>
    <AdminHeader identity={Astro.locals.identity} welcome="false"/>
    <h2>Delete a Contributor</h2>
    <p class="general-warning">Deletion is permanent and requires administrator permissions. You cannot delete your own record. Consider deactivating the contributor instead via <a href="/admin/iam/remove">Identity & Access Management &gt; Delete user</a>.</p>
    <IDEntryForm output_div={undefined} hidden={false} />
    <p id="transaction-status">Your request status will show here after you press "Submit".</p>
    <script>
        import { getForm, genHandler, getTransactionElem } from "../../../scripts/interface"
        import { APIOpCode } from "../../../scripts/connector"
        const delete_form = getForm("contributor_partial", APIOpCode.DELETE)
        console.log("Form element obtained for contributors delete operation:", delete_form)
        const handler = genHandler(delete_form, getTransactionElem(), APIOpCode.DELETE, "contributor_partial")
        delete_form.addEventListener("submit", (evt: Event) => {
            evt.preventDefault()
            if (!confirm("Are you sure you want to permanently delete this contributor?")) {
                return
            }
            handler(evt)
        })
    </script>
    <AdminFooter />
</body>
</html>

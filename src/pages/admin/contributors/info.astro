import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import IDEntryForm from "../../../components/entities/IDEntryForm.astro"
import ContributorInfo from "../../../components/entities/ContributorInfo.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

import { CONTRIBUTOR, redactProtected } from "../../../lib/api/d1"
import { getContributor } from "../../../lib/api/database"
import { guardPage } from "../../../lib/api/page_auth"
import { guardedRead } from "../../../lib/api/http"
import { authEnabled } from "../../../lib/api/environment"

export const prerender = false

// authorize before any direct (API-bypassing) database read; the unfiltered SSR read below is redacted
// for non-admins (see below) so protected properties are never leaked to a non-self, non-admin caller
const denied = guardPage(Astro.request, Astro.locals.identity, { kind: "active" })
if (denied) {
    return denied
}

const is_admin = Astro.locals.identity?.admin === true
const self_id = Astro.locals.identity?.id ?? null
const auth_enabled = authEnabled(Astro.request)

// SSR is used if an ID is specified as a query param. Any active caller may load a record this way; the
// direct database read is unfiltered, so its protected properties are redacted below for any caller other
// than an admin or the owner of the record (mirroring the API GET /contributors/[id] policy).
const id = Astro.url.searchParams.get("id")
const is_self = id !== null && self_id !== null && self_id === Number(id)
// only an admin or the record's owner may edit it; the "Edit this contributor" follow-up link is hidden
// for everyone else (auth-disabled local dev constructs no identity, so editing is unrestricted there)
const may_edit = is_admin || is_self || !auth_enabled
let use_id: boolean = false
let contributor_data: Partial<ContributorRecord> | null = null
if (id) {
    // a missing contributors table surfaces the missing-table fallback page
    const result = await guardedRead(() => getContributor(Astro.locals.cfContext, CONTRIBUTOR.primary_key, id))
    if (result instanceof Response) {
        return result
    }
    if (!result) {
        console.warn(`No contributor found with ID ${id}, falling back to client-side ID entry`)
    } else {
        // an admin (or the caller viewing their own record) sees the full record; everyone else has the
        // protected properties stripped. Auth-disabled local dev never redacts (it constructs no identity).
        contributor_data =
            auth_enabled && !is_admin && !is_self
                ? (redactProtected(CONTRIBUTOR, result) as Partial<ContributorRecord>)
                : result
        use_id = true
    }
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}View Contributor`} description="View a contributor" />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>View a Contributor</h2>
            <IDEntryForm output_div={undefined} hidden={use_id} search={true} />
            <ContributorInfo contributor={use_id ? contributor_data : null} hidden={!use_id} />
            <p id="transaction-status">
                {
                    use_id
                        ? "Contributor data loaded from URL."
                        : 'Your request status will show here after you press "Submit".'
                }
            </p>
            {
                // when loaded server-side via ?id=, mirror the client READ flow's follow-up links: edit this
                // record (only when the caller may edit it), or return to the ID-entry view to look up another
                // (the path without the id query param)
                use_id ? (
                    <p>
                        {may_edit ? (
                            <Fragment>
                                <a href={`/admin/contributors/edit?id=${id}`}>Edit this contributor &gt;</a>
                                <span class="admin-nav-sep" aria-hidden="true">
                                    |
                                </span>{" "}
                            </Fragment>
                        ) : null}
                        <a href={Astro.url.pathname}>View another contributor &gt;</a>
                    </p>
                ) : null
            }
            <script>
                import { getForm, genHandler, getTransactionElem } from "../../../scripts/interface"
                import { APIOpCode } from "../../../scripts/connector"
                import { attachKeywordSearchInline } from "../../../scripts/keyword_search"
                const read_form = getForm("contributor_partial", APIOpCode.READ)
                read_form.addEventListener(
                    "submit",
                    genHandler(read_form, getTransactionElem(), APIOpCode.READ, "contributor_partial")
                )
                // keyword lookup scoped to contributors; selecting a hit loads it on-page via the same READ flow as the ID entry form
                attachKeywordSearchInline(
                    "form-id-entry-search-input",
                    "form-id-entry-search-button",
                    "form-id-entry-search-results",
                    () => "contributors",
                    (result) => {
                        const id_input = document.getElementById("form-id-entry-id")
                        if (id_input instanceof HTMLInputElement) id_input.value = String(result.id)
                        read_form.requestSubmit()
                    }
                )
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

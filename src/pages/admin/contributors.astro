import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

export const prerender = false

const locals = Astro.locals

const identity = locals.identity
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Contributors`} description="Maintain contributor information" />
        <AdminHead />
    </head>
    <body>
        <!-- Header -->
        <AdminHeader identity={identity} welcome={true} />
        <main class="admin-main" role="main">
            <h2>Contributors</h2>
            <p class="general-infohelp">
                Contributors are the individuals credited for work on the project. Each record stores their contributor
                information and also maintains their identity and authorization details for login.
            </p>
            <!-- links to database management pages -->
            <div class="flex-container">
                <div class="column">
                    <ul>
                        <li><a href="/admin/contributors/create" class="col-item-link">Add new contributor</a></li>
                        <li><a href="/admin/contributors/info" class="col-item-link">View contributor info</a></li>
                        <li><a href="/admin/contributors/edit" class="col-item-link">Edit existing contributor</a></li>
                        <li><a href="/admin/contributors/delete" class="col-item-link">Delete contributor</a></li>
                        <li><a href="/admin/contributors/list" class="col-item-link">List contributors</a></li>
                        <li><a href="/admin/contributors/import" class="col-item-link">Import contributors</a></li>
                    </ul>
                </div>
            </div>
            <p class="general-helppointer">
                For help with these options, please review the <a
                    href="/admin/docs/contributors"
                    class="general-helppointer-link">Database Management - Contributors</a
                > documentation and video.
            </p>
            <p class="general-helpinfo">
                Looking for user identity management options? Those options are in <a
                    href="/admin/iam"
                    class="general-helpinfo-link">Identity & Access Management</a
                >.
            </p>
        </main>
        <AdminFooter />
    </body>
</html>

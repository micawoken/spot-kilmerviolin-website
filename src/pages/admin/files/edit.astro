import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import ImageCrop from "../../../components/ImageCrop.astro"
import { ADMIN_PAGE_TITLE_PRFX, MAX_ALT_TEXT_LENGTH } from "../../../consts"

import { getStorageUsage } from "../../../lib/api/files"
import { authEnabled } from "../../../lib/api/environment"

export const prerender = false

// In local dev the Cloudflare Images emulation cannot crop/resize (see optimizeImage), so the upload is
// stored unchanged; warn the operator. Dev is the same localhost rule that disables auth.
const isDev = !authEnabled(Astro.request)

// the key being replaced may be supplied via ?id=
const key = Astro.url.searchParams.get("id") ?? ""

// current usage seeds the live storage estimate (the client projects usage after the chosen file,
// discounting the size of the file being replaced)
const usage = await getStorageUsage(Astro.locals.cfContext)
const used_gb = (usage.used / (1024 * 1024 * 1024)).toFixed(2)
const max_gb = (usage.max / (1024 * 1024 * 1024)).toFixed(2)
const percent = usage.max > 0 ? Math.round((usage.used / usage.max) * 100) : 0
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Replace File`}
            description="Replace an existing file in the file store"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main id="admin-main-content" class="admin-main" role="main">
            <h2>Replace a File</h2>
            <p class="general-infohelp">Replace a file to change what image shows while maintaining its file key.</p>
            {
                isDev && (
                    <p class="admin-dev-warning" role="status">
                        <strong>Local development:</strong> image cropping and optimization are{" "}
                        <strong>skipped here</strong> — the local Cloudflare Images emulation cannot crop, so the file
                        is stored unchanged. You can still frame the crop below; it is applied in production.
                    </p>
                )
            }
            <div class="generic-form">
                <form id="file-replace-form" class="generic-form" novalidate>
                    <fieldset>
                        <legend>File key<span class="field-required" aria-hidden="true">*</span></legend>
                        <div class="field-row">
                            <input
                                type="text"
                                id="file-replace-key"
                                name="key"
                                value={key}
                                placeholder="e.g. composer-portrait.jpg"
                                required
                            />
                        </div>
                        <div class="searchhelper" id="file-search">
                            <label for="file-search-input"><strong>Search for file:</strong></label>
                            <input type="text" id="file-search-input" />
                            <button type="button" id="file-search-button">Search</button>
                            <div id="file-search-results">
                                <p>Results will display here when searched.</p>
                            </div>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>Replacement file<span class="field-required" aria-hidden="true">*</span></legend>
                        <div class="field-row">
                            <input type="file" id="file-replace-input" name="file" accept="image/*" required />
                        </div>
                        {
                            /* crop interface: appears once an image is chosen; lets the operator pick orientation and frame */
                        }
                        <ImageCrop inputId="file-replace-input" id="image-crop" />
                    </fieldset>
                    <fieldset>
                        <legend>Alt text<span class="field-required" aria-hidden="true">*</span></legend>
                        <div class="field-row">
                            <textarea
                                id="file-replace-alt"
                                name="alt"
                                maxlength={MAX_ALT_TEXT_LENGTH}
                                placeholder="Describe the image for screen readers and search engines"
                                required></textarea>
                        </div>
                    </fieldset>
                    {
                        /* live storage figure (mirrors /admin/files); updates with a projection once a file is chosen,
                        discounting the replaced file's current size. used/max bytes are carried in data attributes
                        for the client estimate (a define:vars script cannot also use module imports). */
                    }
                    <p id="file-storage-usage" class="general-infohelp" data-used={usage.used} data-max={usage.max}>
                        Storage used: {used_gb} GB of {max_gb} GB ({percent}%).
                    </p>
                    <p class="field-required-note">
                        <span class="field-required" aria-hidden="true">*</span> indicates a required field
                    </p>
                    <button type="submit" id="file-replace-button">Upload</button>
                </form>
            </div>
            <p id="transaction-status">Your request status will show here after you press "Upload".</p>
            <script>
                import { replaceFile } from "../../../scripts/connector"
                import { attachFileSearchInline, attachStorageEstimate } from "../../../scripts/file_picker"
                import type { CropSelection, ImageCropChangeDetail } from "../../../scripts/image_crop"
                import { showFieldError, clearFieldError } from "../../../scripts/form_validate"
                import { isImageMimeType } from "../../../lib/api/validation"
                const form = document.getElementById("file-replace-form")
                const status = document.getElementById("transaction-status")
                const key_input = document.getElementById("file-replace-key")
                const file_input = document.getElementById("file-replace-input")
                const alt_input = document.getElementById("file-replace-alt")
                const usage_elem = document.getElementById("file-storage-usage")
                const crop_elem = document.getElementById("image-crop")

                const IMAGE_ONLY_MESSAGE = "Please choose an image file (JPEG, PNG, WebP, GIF, AVIF)."
                const ALT_REQUIRED_MESSAGE = "Alt text is required."

                // live search: selecting a hit fills its key into the key field instead of navigating
                attachFileSearchInline(
                    "file-search-input",
                    "file-search-button",
                    "file-search-results",
                    (key: string) => {
                        if (key_input instanceof HTMLInputElement) {
                            key_input.value = key
                            // re-run the storage estimate for the newly selected key
                            key_input.dispatchEvent(new Event("input", { bubbles: true }))
                        }
                    }
                )

                // live storage estimate: shows current usage and projects how much will remain after the replacement
                if (usage_elem) {
                    const used = Number(usage_elem.dataset.used ?? "0")
                    const max = Number(usage_elem.dataset.max ?? "0")
                    attachStorageEstimate(used, max, "file-replace-input", "file-storage-usage", "file-replace-key")
                }

                if (
                    form instanceof HTMLFormElement &&
                    status &&
                    key_input instanceof HTMLInputElement &&
                    file_input instanceof HTMLInputElement &&
                    alt_input instanceof HTMLTextAreaElement
                ) {
                    const input = file_input

                    // the ImageCrop component owns the crop UI and its too-small warning; cache its reported
                    // selection to forward on submit. The image-only hard error stays the page's concern.
                    let crop: CropSelection | null = null
                    crop_elem?.addEventListener("imagecrop:change", (evt) => {
                        crop = (evt as CustomEvent<ImageCropChangeDetail>).detail.crop
                    })

                    // live image-only feedback as soon as a file is chosen
                    input.addEventListener("change", () => {
                        const file = input.files?.[0]
                        if (file && !isImageMimeType(file.type)) showFieldError(input, IMAGE_ONLY_MESSAGE)
                        else clearFieldError(input)
                    })

                    // live required feedback as soon as alt text is edited
                    alt_input.addEventListener("input", () => {
                        if (alt_input.value.trim() === "") showFieldError(alt_input, ALT_REQUIRED_MESSAGE)
                        else clearFieldError(alt_input)
                    })

                    form.addEventListener("submit", async (evt: Event) => {
                        evt.preventDefault()
                        const key = key_input.value.trim()
                        const file = input.files?.[0]
                        const alt = alt_input.value.trim()
                        if (!key || !file) {
                            status.textContent = "Please provide both a file key and a replacement file."
                            return
                        }
                        // reject non-images before submit
                        if (!isImageMimeType(file.type)) {
                            showFieldError(input, IMAGE_ONLY_MESSAGE)
                            status.textContent = IMAGE_ONLY_MESSAGE
                            return
                        }
                        if (!alt) {
                            showFieldError(alt_input, ALT_REQUIRED_MESSAGE)
                            status.textContent = ALT_REQUIRED_MESSAGE
                            return
                        }
                        status.textContent = "Replacing..."
                        try {
                            await replaceFile(key, file, alt, crop)
                            status.innerHTML = `Replacement complete. <a href="/admin/files/info?id=${encodeURIComponent(key)}">View file info &gt;</a>`
                            form.reset()
                            // form.reset() does not fire change; nudge the crop component to clear its preview
                            input.dispatchEvent(new Event("change"))
                        } catch (error) {
                            status.textContent = `Replacement failed: ${error instanceof Error ? error.message : String(error)}`
                            console.error(error)
                        }
                    })
                }
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

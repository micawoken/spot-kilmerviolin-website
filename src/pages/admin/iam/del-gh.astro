---
/**
 * pages/admin/iam/del-gh.astro
 *
 * Administrator page to clear a contributor's GitHub username link, keyed by their identity email. Clearing
 * the link first revokes any granted repository access (the linked account is removed as a collaborator)
 * before the username and id are cleared, so access is never left orphaned.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */

import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"
import { emailFromParam } from "../../../lib/api/validation"

export const prerender = false

const prefill_email = emailFromParam(Astro.url)
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Clear GitHub Username`}
            description="Clear a user's linked GitHub username"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Clear a User's GitHub Username</h2>
            <p class="general-warning">
                Clearing the link first revokes the user's repository access (removing them as a collaborator),
                then unlinks the GitHub account. This operation requires administrator permissions.
            </p>
            <div class="generic-form">
                <form id="gh-form-del" class="generic-form" novalidate>
                    <fieldset>
                        <legend>User Identity Email<span class="field-required" aria-hidden="true">*</span></legend>
                        <div class="field-row">
                            <input type="email" id="gh-form-del-email" name="email" value={prefill_email} required />
                        </div>
                    </fieldset>
                    <button type="submit">Submit</button>
                </form>
            </div>
            <p id="transaction-status">Your request status will show here after you press "Submit".</p>
            <script>
                import { clearIdentityGithub } from "../../../scripts/connector"
                import { disableInput, enableInput, getTransactionElem } from "../../../scripts/interface"
                import { attachFormValidation, validateFormFields } from "../../../scripts/form_validate"

                const form = document.getElementById("gh-form-del") as HTMLFormElement
                const message = getTransactionElem()
                attachFormValidation(form)

                form.addEventListener("submit", async (evt: Event) => {
                    evt.preventDefault()
                    if (!validateFormFields(form)) {
                        message.textContent = "Please correct the highlighted fields and try again."
                        return
                    }
                    const email = String(new FormData(form).get("email") ?? "")
                    if (!email) {
                        message.textContent = "Error: an identity email address is required"
                        return
                    }
                    if (!confirm(`Clear the GitHub username for ${email}? This revokes any repository access.`)) {
                        return
                    }
                    message.textContent = "Processing request..."
                    disableInput(form)
                    try {
                        await clearIdentityGithub(email)
                        message.textContent = `Request succeeded: cleared the GitHub username for ${email}`
                    } catch (error) {
                        message.textContent = `Error: ${error instanceof Error ? error.message : String(error)}`
                        console.error(error)
                    } finally {
                        enableInput(form)
                    }
                })
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

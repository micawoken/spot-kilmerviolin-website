---
/**
 * pages/admin/iam/change-gh.astro
 *
 * Administrator page to add or edit a contributor's GitHub username, keyed by their identity email.
 * The username is verified against GitHub and bound to that account's immutable id. This does not grant
 * repository access — authorize the user separately (see /admin/user/authorize-gh).
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */

import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"
import { emailFromParam } from "../../../lib/api/validation"

export const prerender = false

const prefill_email = emailFromParam(Astro.url)
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Add or Edit GitHub Username`}
            description="Add or edit a user's linked GitHub username"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Add or Edit a User's GitHub Username</h2>
            <p class="general-infohelp">
                Adds or updates the GitHub username linked to the contributor record with the given identity
                email. The username is verified against GitHub. This operation requires administrator permissions.
            </p>
            <p class="general-warning">
                This links an account but does not grant repository access. Authorize the user separately under
                <a href="/admin/user/authorize-gh">Authorize for GitHub</a>.
            </p>
            <div class="generic-form">
                <form id="gh-form-change" class="generic-form" novalidate>
                    <fieldset>
                        <legend>User Identity Email<span class="field-required" aria-hidden="true">*</span></legend>
                        <div class="field-row">
                            <input type="email" id="gh-form-change-email" name="email" value={prefill_email} required />
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>GitHub Username<span class="field-required" aria-hidden="true">*</span></legend>
                        <div class="field-row">
                            <input type="text" id="gh-form-change-username" name="username" required />
                            <small class="general-infohelp field-inline-help">the user's GitHub login</small>
                        </div>
                    </fieldset>
                    <p class="field-required-note">
                        <span class="field-required" aria-hidden="true">*</span> indicates a required field
                    </p>
                    <button type="submit">Submit</button>
                </form>
            </div>
            <p id="transaction-status">Your request status will show here after you press "Submit".</p>
            <script>
                import { setIdentityGithub } from "../../../scripts/connector"
                import { disableInput, enableInput, getTransactionElem } from "../../../scripts/interface"
                import { attachFormValidation, validateFormFields } from "../../../scripts/form_validate"
                import { isValidGithubUsername } from "../../../lib/api/validation"

                const form = document.getElementById("gh-form-change") as HTMLFormElement
                const message = getTransactionElem()
                attachFormValidation(form)

                form.addEventListener("submit", async (evt: Event) => {
                    evt.preventDefault()
                    if (!validateFormFields(form)) {
                        message.textContent = "Please correct the highlighted fields and try again."
                        return
                    }
                    const data = new FormData(form)
                    const email = String(data.get("email") ?? "")
                    const username = String(data.get("username") ?? "").trim()
                    if (!email || !username) {
                        message.textContent = "Error: both an identity email and a GitHub username are required"
                        return
                    }
                    if (!isValidGithubUsername(username)) {
                        message.textContent = "Error: enter a valid GitHub username (letters, digits, single hyphens)."
                        return
                    }
                    if (!confirm(`Set the GitHub username for ${email} to ${username}?`)) {
                        return
                    }
                    message.textContent = "Processing request..."
                    disableInput(form)
                    try {
                        await setIdentityGithub(email, username)
                        message.textContent = `Request succeeded: set the GitHub username for ${email} to ${username}`
                    } catch (error) {
                        message.textContent = `Error: ${error instanceof Error ? error.message : String(error)}`
                        console.error(error)
                    } finally {
                        enableInput(form)
                    }
                })
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

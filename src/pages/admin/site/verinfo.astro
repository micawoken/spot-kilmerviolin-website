import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

// version info is rendered server-side (the GET /api/v1/site endpoint serves API consumers)
import verinfo from "../../../lib/api/verinfo"
import { guardPage } from "../../../lib/api/page_auth"
import { test as accessTokenTest } from "../../../lib/api/access_iam_mgmt"

export const prerender = false

// authorize before rendering build/environment info, mirroring GET /api/v1/site (active callers)
const denied = guardPage(Astro.request, Astro.locals.identity, { kind: "active" })
if (denied) {
    return denied
}

const info = verinfo(Astro.request)

// Integration token health is an admin-only diagnostic: it makes a live read against the Cloudflare API
// to confirm the configured secret still works after a migration or rotation. It is gated to
// administrators and skipped otherwise (including local development, where no identity is present and the
// secrets/bindings are unavailable). test() never throws — it resolves to false on any failure, so a
// failing integration never breaks the page render.
let tokenHealth: { cloudflare: boolean } | null = null
if (Astro.locals.identity?.admin === true) {
    tokenHealth = { cloudflare: await accessTokenTest() }
}

// build timestamp arrives as an ISO string; render it in a readable local form while keeping the raw
// ISO value as the <time datetime> for fidelity. Falls back to the raw value if it is not parseable.
const buildDate = info.timestamp ? new Date(info.timestamp) : null
const buildTimestampDisplay =
    buildDate && !isNaN(buildDate.getTime())
        ? buildDate.toLocaleString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
              hour: "numeric",
              minute: "2-digit",
              timeZoneName: "short"
          })
        : (info.timestamp ?? "(unknown)")

// render a TTL (in seconds) as a human-readable duration scaled up to the largest applicable unit, days
// being the ceiling (weeks are deliberately excluded): "7 days", "2 hours", "1 hour 30 minutes",
// "45 seconds". null/undefined render as "(not set)". The raw seconds are shown alongside by the caller.
const pl = (n: number, unit: string): string => `${n} ${unit}${n === 1 ? "" : "s"}`
const formatTtl = (seconds: number | null | undefined): string => {
    if (seconds === null || seconds === undefined) return "(not set)"
    if (seconds === 0) return "0 seconds"
    const parts: string[] = []
    const days = Math.floor(seconds / 86400)
    const hours = Math.floor((seconds % 86400) / 3600)
    const minutes = Math.floor((seconds % 3600) / 60)
    const secs = seconds % 60
    if (days) parts.push(pl(days, "day"))
    if (hours) parts.push(pl(hours, "hour"))
    if (minutes) parts.push(pl(minutes, "minute"))
    if (secs) parts.push(pl(secs, "second"))
    return parts.join(" ")
}
// "<human> (<n> s)", or just the human form when there is no raw value to show
const ttlWithRaw = (seconds: number | null | undefined): string =>
    seconds === null || seconds === undefined ? formatTtl(seconds) : `${formatTtl(seconds)} (${seconds} s)`

// render a byte count as a human-readable binary size with the raw byte value alongside: "25 MiB
// (26214400 bytes)". null/undefined render as "(not set)"; sub-KiB values omit the redundant raw suffix.
const formatBytes = (bytes: number | null | undefined): string => {
    if (bytes === null || bytes === undefined) return "(not set)"
    const units = ["bytes", "KiB", "MiB", "GiB", "TiB"]
    let value = bytes
    let i = 0
    while (value >= 1024 && i < units.length - 1) {
        value /= 1024
        i++
    }
    if (i === 0) return `${bytes} ${units[0]}`
    const human = `${value % 1 === 0 ? value : value.toFixed(1)} ${units[i]}`
    return `${human} (${bytes} bytes)`
}

const yesno = (value: boolean): string => (value ? "Yes" : "No")

// the identity-record cache TTL is delivered in milliseconds; the durations group renders in seconds
const identityTtlSec = Math.round(info.environment.ttls.identity_ms / 1000)
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Site Info`}
            description="View site build and environment information"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Site Information</h2>
            <div class="entity-result-container site-info-card">
                <h3 class="entity-result-name">Site Information</h3>
                <div id="site-info-infoline" class="site-info-infoline">
                    <strong>{info.environment.name}</strong>
                    <span>Build {info.build_id}</span>
                    <span>
                        {
                            buildDate && !isNaN(buildDate.getTime()) ? (
                                <time datetime={buildDate.toISOString()}>{buildTimestampDisplay}</time>
                            ) : (
                                buildTimestampDisplay
                            )
                        }
                    </span>
                    {info.tag && <span>Tag {info.tag}</span>}
                </div>
                <div class="site-info-details entity-result-details">
                    {/* details are grouped by data type rather than subsystem: booleans, then durations,
                        then other numeric quantities, then strings */}
                    <div class="site-info-group">
                        <strong>Self-enrollment enabled:</strong>
                        <span>{yesno(info.settings.selfenroll)}</span>
                        <strong>Rich error descriptions:</strong>
                        <span>{yesno(info.settings.errordesc)}</span>
                        <strong>Authentication service enabled:</strong>
                        <span>{yesno(info.environment.authservice)}</span>
                        <strong>Database writable:</strong>
                        <span>{yesno(info.environment.db_writable)}</span>
                    </div>
                    <div class="site-info-group">
                        <strong>Cache API TTL (default):</strong>
                        <span>{ttlWithRaw(info.environment.ttls.cacheApi.default)}</span>
                        <strong>Cache API TTL (long):</strong>
                        <span>{ttlWithRaw(info.environment.ttls.cacheApi.long)}</span>
                        <strong>KV cache TTL (default):</strong>
                        <span>{ttlWithRaw(info.environment.ttls.kv.default)}</span>
                        <strong>Identity cache TTL:</strong>
                        <span>{ttlWithRaw(identityTtlSec)}</span>
                        <strong>Rebuild cooldown:</strong>
                        <span>{ttlWithRaw(info.settings.rebuild_cooldown_sec)}</span>
                    </div>
                    <div class="site-info-group">
                        <strong>Max upload size:</strong>
                        <span>{formatBytes(info.environment.limits.max_upload_bytes)}</span>
                        <strong>Search result cap:</strong>
                        <span>{info.environment.limits.search_result_cap} results</span>
                        <strong>Max image width:</strong>
                        <span>{info.environment.images.max_width} px</span>
                        <strong>Image quality:</strong>
                        <span>{info.environment.images.quality}</span>
                    </div>
                    <div class="site-info-group">
                        <strong>Target image format:</strong>
                        <span>{info.environment.images.format}</span>
                    </div>
                    {
                        tokenHealth && (
                            <div class="site-info-group">
                                <strong>Cloudflare API token:</strong>
                                <span>
                                    {tokenHealth.cloudflare
                                        ? "OK"
                                        : "Failed — verify the token is valid and authorized for this account"}
                                </span>
                            </div>
                        )
                    }
                </div>
            </div>
        </main>
        <AdminFooter />
    </body>
</html>

import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"
import { guardPage } from "../../../lib/api/page_auth"
import { ADMIN_REBUILD_OVERRIDE_COOLDOWN_SEC } from "../../../lib/api/rebuild"

export const prerender = false

// a rebuild only publishes content or design changes, so access is gated on the dedicated rebuild
// permission (assigned to every role carrying cms_editor and/or design_editor; mirrors POST /api/v1/site)
const denied = guardPage(Astro.request, Astro.locals.identity, {
    kind: "permission",
    permissions: ["rebuild"]
})
if (denied) {
    return denied
}

// the cooldown override is an admin-only escape hatch; the checkbox is only ever rendered for an admin,
// mirroring the show_elevate convention on CompositionForm/ContributorForm. This is a UI convenience only:
// the server independently re-checks admin status on the meta.elevate flag (see POST /api/v1/site)
const is_admin = Astro.locals.identity?.admin === true
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Rebuild Site`}
            description="Trigger a rebuild and redeploy of the site"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main id="admin-main-content" class="admin-main" role="main">
            <h2>Rebuild the Site</h2>
            <p class="general-warning">
                Website rebuilds use cloud compute minutes on Worker Builds. Do not rebuild the website until you are
                done with editing so we can conserve resources.
            </p>
            <p class="general-infohelp">
                Rebuilds are used to publish changes you make to the database to the website. Any changes you make will
                not be made public until you rebuild.
            </p>
            <button type="button" id="site-rebuild-button">Rebuild site</button>
            {
                is_admin ? (
                    <div class="form-section">
                        <h3 class="form-section-title">Administrative Options</h3>
                        <fieldset>
                            <legend>Admin Cooldown Override</legend>
                            <input type="checkbox" id="site-rebuild-admin-override" name="elevate" />
                            <label for="site-rebuild-admin-override">Use administrator cooldown override</label>
                            <p class="general-warning">
                                When checked, a rebuild may be triggered as often as once every{" "}
                                {ADMIN_REBUILD_OVERRIDE_COOLDOWN_SEC} seconds instead of the standard cooldown. Use
                                sparingly, as rebuilds consume Worker Builds compute minutes.
                            </p>
                        </fieldset>
                    </div>
                ) : null
            }
            <p id="transaction-status">Your request status will show here after you press "Rebuild site".</p>
            <script>
                import { rebuildSite, getSite } from "../../../scripts/connector"
                import { getTransactionElem } from "../../../scripts/interface"

                const button = document.getElementById("site-rebuild-button") as HTMLButtonElement
                const message = getTransactionElem()
                // absent entirely for a non-admin (see is_admin in the frontmatter); the server independently
                // re-checks admin status on the meta.elevate flag, so this checkbox is a UI convenience only
                const overrideCheckbox = document.getElementById(
                    "site-rebuild-admin-override"
                ) as HTMLInputElement | null

                /**
                 * Detects whether the page is being served from a local development build, mirroring the
                 * hostname check in lib/api/environment.ts. Development serves only from localhost/127.0.0.1,
                 * so rebuilds (which redeploy the live Worker) are meaningless and disabled here. The API
                 * enforces the same restriction server-side.
                 */
                function isDevelopment(): boolean {
                    const hostname = window.location.hostname
                    return hostname === "localhost" || hostname === "127.0.0.1"
                }

                // ADVISORY ONLY. These are derived from the running build's timestamp, which is a LOWER bound
                // on the server's window: the server measures its cooldown from the last rebuild TRIGGER
                // (lib/api/rebuild.ts), so a request can still be refused while these read as elapsed. The
                // refusal arrives as a 429 whose message carries the exact remaining wait, which is what the
                // click handler surfaces. Do not treat a pre-gate that has expired as permission to rebuild.
                //
                // The earliest time (epoch ms) at which a standard rebuild is permitted.
                let allowedAt = 0
                // The same, for an admin-override rebuild (the shorter window). Only ever consulted when the
                // override checkbox is present and checked; the server enforces its own window on meta.elevate.
                let overrideAllowedAt = 0

                /**
                 * Formats a duration in seconds as a short "Xm Ys" (or "Ys") string for the cooldown notice.
                 */
                function formatWait(seconds: number): string {
                    const mins = Math.floor(seconds / 60)
                    const secs = seconds % 60
                    return mins > 0 ? `${mins}m ${secs}s` : `${secs}s`
                }

                /**
                 * Re-evaluates the cooldown: disables the button and shows the remaining wait while it is active,
                 * re-enabling it once the window elapses. Schedules itself to refresh while a cooldown is pending.
                 * Consults the override cooldown instead of the standard one whenever the admin-only override
                 * checkbox is present and checked.
                 */
                function refreshCooldown(): void {
                    const overridden = overrideCheckbox?.checked === true
                    const effectiveAllowedAt = overridden ? overrideAllowedAt : allowedAt
                    const remaining = Math.ceil((effectiveAllowedAt - Date.now()) / 1000)
                    if (remaining > 0) {
                        button.disabled = true
                        message.textContent = overridden
                            ? `Too soon since the last rebuild. With the admin override, you can rebuild again in ${formatWait(remaining)}.`
                            : `Too soon since the last rebuild. You can rebuild again in ${formatWait(remaining)}.`
                        window.setTimeout(refreshCooldown, 1000)
                    } else {
                        button.disabled = false
                        message.textContent = `Your request status will show here after you press "Rebuild site".`
                    }
                }

                if (isDevelopment()) {
                    // rebuilds redeploy the live Worker, so they are disabled on a local development build
                    button.disabled = true
                    message.textContent = "Site rebuild is disabled in the development environment."
                } else {
                    // On load, read the current build's timestamp and cooldowns to gate the button before any click.
                    try {
                        const info = await getSite()
                        const built = info?.timestamp ? Date.parse(info.timestamp) : NaN
                        const cooldownSec = Number(info?.settings?.rebuild_cooldown_sec)
                        const overrideCooldownSec = Number(info?.settings?.admin_rebuild_cooldown_sec)
                        if (!isNaN(built) && !isNaN(cooldownSec)) {
                            allowedAt = built + cooldownSec * 1000
                        }
                        if (!isNaN(built) && !isNaN(overrideCooldownSec)) {
                            overrideAllowedAt = built + overrideCooldownSec * 1000
                        }
                        refreshCooldown()
                    } catch (error) {
                        // a failure to read build info should not block manual rebuilds; the server still enforces the cooldown
                        console.error(error)
                    }

                    // toggling the checkbox switches which cooldown gates the button, so re-evaluate immediately
                    overrideCheckbox?.addEventListener("change", refreshCooldown)

                    button.addEventListener("click", async () => {
                        const overridden = overrideCheckbox?.checked === true
                        if (Date.now() < (overridden ? overrideAllowedAt : allowedAt)) {
                            // guard against a click slipping through before the cooldown UI refreshes
                            refreshCooldown()
                            return
                        }
                        const confirmMessage = overridden
                            ? "Are you sure you want to use the admin cooldown override to trigger a site rebuild and redeploy?"
                            : "Are you sure you want to trigger a site rebuild and redeploy?"
                        if (!confirm(confirmMessage)) {
                            return
                        }
                        message.textContent = "Processing request..."
                        button.disabled = true
                        try {
                            await rebuildSite(overridden)
                            message.textContent =
                                "Request succeeded: rebuild triggered. The new build will be live in a few minutes."
                        } catch (error) {
                            message.textContent = `Error: ${error instanceof Error ? error.message : String(error)}`
                            console.error(error)
                        } finally {
                            button.disabled = false
                        }
                    })
                }
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

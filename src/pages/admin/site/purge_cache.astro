---
import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

export const prerender = false
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Purge Cache`} description="Purge the site's database cache" />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Purge the Database Cache</h2>
            <p class="general-warning">
                Unless you encounter stale data, you should not purge the cache. The cache will automatically update
                within the time-to-live specified in <a href="/admin/site/verinfo"
                    >Site Management &gt; View site info</a
                >. Purging the cache unnecessarily will increase read operations on the database, which are subject to a
                daily limit.
            </p>
            <p class="general-infohelp">
                The database cache contains temporary copies of the database to improve website performance and reduce
                database use. By default, the website will check the cache first. When you make an edit, it updates the
                database but may not update the cache. Purging the cache here deletes the cache and allows it to
                regenerate from the database.
            </p>
            <button type="button" id="site-purge-button">Purge cache</button>
            <p id="transaction-status">Your request status will show here after you press "Purge cache".</p>
            <script>
                import { purgeSite } from "../../../scripts/connector"
                import { getTransactionElem } from "../../../scripts/interface"

                const button = document.getElementById("site-purge-button") as HTMLButtonElement
                const message = getTransactionElem()

                button.addEventListener("click", async () => {
                    if (!confirm("Are you sure you want to purge the database cache?")) {
                        return
                    }
                    message.textContent = "Processing request..."
                    button.disabled = true
                    try {
                        const result = await purgeSite()
                        message.textContent = `Request succeeded: ${result?.message ?? "cache purged"}`
                    } catch (error) {
                        message.textContent = `Error: ${error instanceof Error ? error.message : String(error)}`
                        console.error(error)
                    } finally {
                        button.disabled = false
                    }
                })
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

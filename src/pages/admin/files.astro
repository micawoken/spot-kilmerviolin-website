---
import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

import { getStorageUsage } from "../../lib/api/files"

export const prerender = false

// surface current storage usage so admins can see how close the bucket is to its ceiling
const usage = await getStorageUsage(Astro.locals.cfContext)
const used_gb = (usage.used / (1024 * 1024 * 1024)).toFixed(2)
const max_gb = (usage.max / (1024 * 1024 * 1024)).toFixed(2)
const percent = usage.max > 0 ? Math.round((usage.used / usage.max) * 100) : 0
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}File Management`} description="Manage files stored in the R2 file store"/>
    <AdminHead />
</head>
<body>
    <AdminHeader identity={Astro.locals.identity} welcome={false}/>
    <main class="admin-main" role="main">
    <h2>File Management</h2>
    <p class="general-infohelp">Files (mainly images) are stored in the R2 file store and referenced by records via their image field. Uploaded images are optimized automatically.</p>
    <p class="general-infohelp">Storage used: {used_gb} GB of {max_gb} GB ({percent}%).</p>
    <div class="flex-container">
        <div class="column">
            <ul>
                <li><a href="/admin/files/create" class="col-item-link">Add new file</a></li>
                <li><a href="/admin/files/info" class="col-item-link">View file info</a></li>
                <li><a href="/admin/files/edit" class="col-item-link">Replace existing file</a></li>
                <li><a href="/admin/files/delete" class="col-item-link">Delete file</a></li>
                <li><a href="/admin/files/list" class="col-item-link">List files</a></li>
            </ul>
        </div>
    </div>
    <p class="general-helppointer">For help with these options, please review the <a href="/admin/docs/files" class="general-helppointer-link">File Management</a> documentation and video.</p>
    </main>
    <AdminFooter />
</body>
</html>

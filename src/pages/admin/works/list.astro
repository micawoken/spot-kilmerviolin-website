---
import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import ListResults from "../../../components/entities/ListResults.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"

// list is rendered server-side
import { attachCompositionNames, listCompositions } from "../../../lib/api/database"
import { guardPage } from "../../../lib/api/page_auth"
import { guardedRead } from "../../../lib/api/http"

export const prerender = false

// authorize before the direct (API-bypassing) database read below
const denied = guardPage(Astro.request, Astro.locals.identity, { kind: "active" })
if (denied) {
    return denied
}

// pull the list; a missing compositions table surfaces the missing-table fallback page rather than a raw 500
const compositions = await guardedRead(() => listCompositions(Astro.locals.cfContext))
if (compositions instanceof Response) {
    return compositions
}
if (!compositions) {
    throw new Error("Failed to fetch the compositions list from the database")
}

// resolve composer names so each entry identifies its composer, which is otherwise only a numeric id;
// a missing composers/contributors table here also surfaces the missing-table fallback page
const enhanced_compositions = await guardedRead(() => attachCompositionNames(Astro.locals.cfContext, compositions))
if (enhanced_compositions instanceof Response) {
    return enhanced_compositions
}

// NOTE: ListResults builds /admin/{noun}s/... links, so the URL noun is "work";
// the client-side interface noun for compositions remains "composition"
const formatted_compositions = enhanced_compositions.map(({ object, names }) => ({
    id: object.id,
    name: object.name,
    name2: names.composer_name,
}))
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}List Compositions`} description="View the list of compositions in the database"/>
    <AdminHead />
</head>
<body>
    <AdminHeader identity={Astro.locals.identity} welcome={false}/>
    <main class="admin-main" role="main">
    <h2>List Compositions</h2>
    <ListResults noun="work" enviro="admin" results={formatted_compositions} />
    </main>
    <AdminFooter />
</body>
</html>

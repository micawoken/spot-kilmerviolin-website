import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

export const prerender = false

const locals = Astro.locals

const identity = locals.identity
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}User Management`}
            description="Manage user account status and administrator access"
        />
        <AdminHead />
    </head>
    <body>
        <!-- Header -->
        <AdminHeader identity={identity} welcome={true} />
        <main class="admin-main" role="main">
            <h2>User Management</h2>
            <p class="general-infohelp">
                User Management allows you to activate or deactivate a user account and modify their account type.
            </p>
            <!-- Pages for user account status and administrator access -->
            <div class="flex-container">
                <div class="column">
                    <ul>
                        <li><a href="/admin/user/activate" class="col-item-link">Activate user account</a></li>
                        <li><a href="/admin/user/deactivate" class="col-item-link">Deactivate user account</a></li>
                        <li><a href="/admin/user/elevate" class="col-item-link">Promote user to administrator</a></li>
                        <li><a href="/admin/user/demote" class="col-item-link">Demote user from administrator</a></li>
                        <li><a href="/admin/user/tokens" class="col-item-link">Manage API tokens</a></li>
                        <li><a href="/admin/user/tokens/build" class="col-item-link">Manage build tokens</a></li>
                    </ul>
                </div>
            </div>
            <p class="general-helpinfo">
                Looking to add, remove, or edit the roles on a user account? Those options are in <a
                    href="/admin/iam"
                    class="general-helpinfo-link">Identity &amp; Access Management</a
                >.
            </p>
        </main>
        <AdminFooter />
    </body>
</html>

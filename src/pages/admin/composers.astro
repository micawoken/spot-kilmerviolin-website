import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

export const prerender = false

const locals = Astro.locals

const identity = locals.identity
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Composers`} description="Maintain composer information" />
        <AdminHead />
    </head>
    <body>
        <!-- Header -->
        <AdminHeader identity={identity} welcome={true} />
        <main class="admin-main" role="main">
            <h2>Composers</h2>
            <p class="general-infohelp">
                Composer records represent composers or arrangers of musical compositions. They are referenced in
                compositions.
            </p>
            <!-- links to database management pages -->
            <div class="flex-container">
                <div class="column">
                    <ul>
                        <li><a href="/admin/composers/create" class="col-item-link">Add new composer</a></li>
                        <li><a href="/admin/composers/info" class="col-item-link">View composer info</a></li>
                        <li><a href="/admin/composers/edit" class="col-item-link">Edit existing composer</a></li>
                        <li><a href="/admin/composers/delete" class="col-item-link">Delete composer</a></li>
                        <li><a href="/admin/composers/list" class="col-item-link">List composers</a></li>
                        <li><a href="/admin/composers/import" class="col-item-link">Import composers</a></li>
                    </ul>
                </div>
            </div>
            <p class="general-helppointer">
                For help with these options, please review the <a
                    href="/admin/docs/composers"
                    class="general-helppointer-link">Database Management - Composers</a
                > documentation and video.
            </p>
        </main>
        <AdminFooter />
    </body>
</html>

import TokenManager from "../../../components/TokenManager.astro"
import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"
import { guardPage } from "../../../lib/api/page_auth"
import { listApiTokensForContributor, type ApiTokenRow } from "../../../lib/api/tokens"

export const prerender = false

// self-service: any active, enrolled contributor manages their own tokens
const denied = guardPage(Astro.request, Astro.locals.identity, { kind: "active" })
if (denied) {
    return denied
}

interface TokenRowView extends ApiTokenRow {
    status_label: "Revoked" | "Expired" | "Active"
}

// status is precomputed here (rather than inline in the template) because Astro's template parser
// misreads a bare "<=" inside a JSX expression as the start of a tag
function statusLabel(token: ApiTokenRow, now: number): TokenRowView["status_label"] {
    if (token.revoked_date !== null) return "Revoked"
    if (token.expires_date <= now) return "Expired"
    return "Active"
}

let tokens: TokenRowView[] = []
let error: string | null = null
try {
    const now = Date.now()
    tokens = (await listApiTokensForContributor(Astro.locals.identity!.id)).map((token) => ({
        ...token,
        status_label: statusLabel(token, now)
    }))
} catch (e) {
    error = e instanceof Error ? e.message : String(e)
    console.error("Failed to fetch API token list:", e)
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}API Tokens`} description="Manage your API access tokens" />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main id="admin-main-content" class="admin-main" role="main">
            <h2>API Tokens</h2>
            <p class="general-warning">
                API tokens are like passwords - never share them with anyone else. Keep them safe.
            </p>
            <p class="general-infohelp">
                Issue and revoke API tokens scoped to your user account permissions. Usage requires presentation of both
                an API token and a Cloudflare Access Service Token.
            </p>
            <TokenManager tokens={tokens} error={error} />
        </main>
        <AdminFooter />
    </body>
</html>

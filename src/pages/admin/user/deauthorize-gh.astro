---
/**
 * pages/admin/user/deauthorize-gh.astro
 *
 * Administrator page to revoke a contributor's GitHub repository write access (removes them as a
 * collaborator), keyed by their identity email. The username link is left in place. The repository owner is
 * protected and cannot be deauthorized.
 *
 * Copyright (C) 2026 Michael Wong.
 *
 * This program is free software: you can redistribute it and/or modify
 * it under the terms of the GNU General Public License as published by
 * the Free Software Foundation, either version 3 of the License, or any later version.
 *
 * This license is also subject to additional terms as specified in the README.md.
 *
 * This program is distributed in the hope that it will be useful,
 * but WITHOUT ANY WARRANTY; without even the implied warranty of
 * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
 * GNU General Public License for more details.
 *
 * You should have received a copy of the GNU General Public License
 * along with this program. If not, see <https://www.gnu.org/licenses/>.
 */

import BaseHead from "../../../components/BaseHead.astro"
import AdminHead from "../../../components/AdminHead.astro"
import AdminHeader from "../../../components/AdminHeader.astro"
import AdminFooter from "../../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../../consts"
import { emailFromParam } from "../../../lib/api/validation"

export const prerender = false

const prefill_email = emailFromParam(Astro.url)
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Deauthorize for GitHub`}
            description="Revoke a user's GitHub repository write access"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={Astro.locals.identity} welcome={false} />
        <main class="admin-main" role="main">
            <h2>Revoke a User's GitHub Access</h2>
            <p class="general-infohelp">
                Removes the linked GitHub account of the contributor with the given identity email from the
                content repository. The username link is kept; only repository access is revoked. This operation
                requires administrator permissions.
            </p>
            <div class="generic-form">
                <form id="gh-form-deauthorize" class="generic-form" novalidate>
                    <fieldset>
                        <legend>User Identity Email<span class="field-required" aria-hidden="true">*</span></legend>
                        <div class="field-row">
                            <input type="email" id="gh-form-deauthorize-email" name="email" value={prefill_email} required />
                        </div>
                    </fieldset>
                    <button type="submit">Submit</button>
                </form>
            </div>
            <p id="transaction-status">Your request status will show here after you press "Submit".</p>
            <script>
                import { deauthorizeIdentityGithub } from "../../../scripts/connector"
                import { disableInput, enableInput, getTransactionElem } from "../../../scripts/interface"
                import { attachFormValidation, validateFormFields } from "../../../scripts/form_validate"

                const form = document.getElementById("gh-form-deauthorize") as HTMLFormElement
                const message = getTransactionElem()
                attachFormValidation(form)

                form.addEventListener("submit", async (evt: Event) => {
                    evt.preventDefault()
                    if (!validateFormFields(form)) {
                        message.textContent = "Please correct the highlighted fields and try again."
                        return
                    }
                    const email = String(new FormData(form).get("email") ?? "")
                    if (!email) {
                        message.textContent = "Error: an identity email address is required"
                        return
                    }
                    if (!confirm(`Revoke ${email}'s write access to the content repository?`)) {
                        return
                    }
                    message.textContent = "Processing request..."
                    disableInput(form)
                    try {
                        await deauthorizeIdentityGithub(email)
                        message.textContent = `Request succeeded: revoked repository access from ${email}`
                    } catch (error) {
                        message.textContent = `Error: ${error instanceof Error ? error.message : String(error)}`
                        console.error(error)
                    } finally {
                        enableInput(form)
                    }
                })
            </script>
        </main>
        <AdminFooter />
    </body>
</html>

---
import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import KeywordSearchBox from "../../components/entities/KeywordSearchBox.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

export const prerender = false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Search`} description="Search the database by keyword"/>
    <AdminHead />
</head>
<body>
    <AdminHeader identity={Astro.locals.identity} welcome={false}/>
    <h2>Search the Database</h2>
    <p class="general-infohelp">Search composers, compositions, and contributors by keyword. Matches on names, composer names, tags, bios, and notes rank highest. Select a database to narrow the search, or leave it on "All databases". Click a result to view it.</p>
    <KeywordSearchBox id_prefix="admin-search" label="Search by keyword" database_select={true} />
    <p id="transaction-status">Your search results will show here after you press "Search".</p>
    <script>
        import { attachKeywordSearch } from "../../scripts/interface"

        // each table's hits route to that entity's info (view) page
        const INFO_PATHS: Record<SearchDatabase, string> = {
            composers: "/admin/composers/info",
            compositions: "/admin/works/info",
            contributors: "/admin/contributors/info"
        }

        const database_select = document.getElementById("admin-search-database")
        attachKeywordSearch(
            "admin-search-input",
            "admin-search-button",
            "admin-search-results",
            () => {
                const value = database_select instanceof HTMLSelectElement ? database_select.value : ""
                return value === "" ? null : (value as SearchDatabase)
            },
            (result) => `${INFO_PATHS[result.database]}?id=${result.id}`
        )
    </script>
    <AdminFooter />
</body>
</html>

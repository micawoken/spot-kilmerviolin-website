import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

export const prerender = false

const locals = Astro.locals

const identity = locals.identity
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Site Management`}
            description="Manage site information and configuration"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={identity} welcome={true} />
        <main id="admin-main-content" class="admin-main" role="main">
            <h2>Site Management</h2>
            <p class="general-infohelp">
                Site Management allows you to perform various general operations related to the website.
            </p>
            <div class="flex-container">
                <div class="column">
                    <ul>
                        <li><a href="/admin/search" class="col-item-link">Search database</a></li>
                        <li><a href="/admin/site/verinfo" class="col-item-link">View site info</a></li>
                        <li><a href="/admin/site/analytics" class="col-item-link">View site analytics</a></li>
                        <li>
                            <a href="/_emdash/admin" class="col-item-link" target="_blank" rel="noopener noreferrer"
                                >Access EmDash CMS</a
                            >
                        </li>
                        <li><a href="/admin/site/rebuild" class="col-item-link">Rebuild site</a></li>
                        <li><a href="/admin/site/purge_cache" class="col-item-link">Purge cache</a></li>
                    </ul>
                </div>
            </div>
            <p class="general-helppointer">
                For help with these options, please review the <a
                    href="/admin/docs/site"
                    class="general-helppointer-link">Site Management</a
                > documentation.
            </p>
        </main>
        <AdminFooter />
    </body>
</html>

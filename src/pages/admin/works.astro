---
import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

export const prerender = false

const locals = Astro.locals
const date = new Date()

const identity = locals.identity
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Compositions`} description="Maintain composition information"/>
    <AdminHead />
</head>
<body>
    <!-- Header -->
    <AdminHeader identity={identity} welcome={true}/>
    <!-- links to database management pages -->
    <div class="flex-container"> 
        <div class="column">
            <h2><a href="/admin/works" class="col-header-link">Compositions</a></h2>
            <ul>
                <li><a href="/admin/works/create" class="col-item-link">Add new composition</a></li>
                <li><a href="/admin/works/info" class="col-item-link">View composition info</a></li>
                <li><a href="/admin/works/edit" class="col-item-link">Edit existing composition</a></li>
                <li><a href="/admin/works/delete" class="col-item-link">Delete composition</a></li>
                <li><a href="/admin/works/list" class="col-item-link">List compositions</a></li>
            </ul>
        </div>
    </div>
    <p class="general-helppointer">For help with these options, please review the <a href="/admin/docs/works" class="general-helppointer-link">Database Management - Compositions</a> documentation and video.</p>
    <AdminFooter />
</body>
</html>
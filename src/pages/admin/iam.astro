import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

export const prerender = false

const locals = Astro.locals

const identity = locals.identity
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${ADMIN_PAGE_TITLE_PRFX}Identity & Access Management`}
            description="Manage access to administrative services"
        />
        <AdminHead />
    </head>
    <body>
        <AdminHeader identity={identity} welcome={true} />
        <main class="admin-main" role="main">
            <h2>Identity & Access Management</h2>
            <p class="general-infohelp">
                Identity & Access Management controls who can log into this system and what they are allowed to do once
                connected.
            </p>
            <div class="flex-container">
                <div class="column">
                    <ul>
                        <li><a href="/admin/iam/whoami" class="col-item-link">My authorization info</a></li>
                        <li><a href="/admin/iam/add" class="col-item-link">Add new user</a></li>
                        <li><a href="/admin/iam/list" class="col-item-link">List users</a></li>
                        <li><a href="/admin/iam/edit" class="col-item-link">Add or remove roles</a></li>
                        <li><a href="/admin/iam/email" class="col-item-link">Change sign-in email</a></li>
                        <li><a href="/admin/iam/remove" class="col-item-link">Delete user</a></li>
                    </ul>
                </div>
            </div>
            <p class="general-helppointer">
                For help with these options, please review the <a
                    href="/admin/docs/iam"
                    class="general-helppointer-link">Identity & Access Management</a
                > documentation.
            </p>
            <p class="general-helpinfo">
                Looking for options to activate or deactivate an account, or to promote or demote a user as
                administrator? Those options are in <a href="/admin/user" class="general-helpinfo-link"
                    >User Management</a
                >.
            </p>
        </main>
        <AdminFooter />
    </body>
</html>

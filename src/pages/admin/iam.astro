---
import BaseHead from "../../components/BaseHead.astro"
import AdminHead from "../../components/AdminHead.astro"
import AdminHeader from "../../components/AdminHeader.astro"
import AdminFooter from "../../components/AdminFooter.astro"
import { ADMIN_PAGE_TITLE_PRFX } from "../../consts"

export const prerender = false

const locals = Astro.locals
const date = new Date()

const identity = locals.identity
---
<!DOCTYPE html>
<html lang="en">
<head>
    <BaseHead title={`${ADMIN_PAGE_TITLE_PRFX}Identity & Access Management`} description="Manage access to administrative services"/>
    <AdminHead />
</head>
<body>
    <!-- Header -->
    <AdminHeader identity={identity}  welcome={true}/>
    <!-- Pages for IAM, site info/mgmt, and advanced -->
    <div class="flex-container">
        <div class="column">
            <h2><a href="/admin/iam" class="col-header-link">Identity & Access Management</a></h2>
            <ul>
                <li><a href="/admin/iam/whoami" class="col-item-link">My authorization info</a></li>
                <li><a href="/admin/iam/add" class="col-item-link">Add new user</a></li>
                <li><a href="/admin/iam/list" class="col-item-link">List users</a></li>
                <li><a href="/admin/iam/edit" class="col-item-link">Add or remove roles</a></li>
                <li><a href="/admin/iam/activate" class="col-item-link">Activate user account</a></li>
                <li><a href="/admin/iam/deactivate" class="col-item-link">Deactivate user account</a></li>
                <li><a href="/admin/iam/remove" class="col-item-link">Delete user</a></li>
            </ul>
        </div>
    </div>
    <p class="general-helppointer">For help with these options, please review the <a href="/admin/docs/iam" class="general-helppointer-link">Identity & Access Management</a>documentation and video.</p>
    <p class="general-helpinfo">Looking for options to promote or demote a user as administrator? Those options are in <a href="/admin/advanced" class="general-helpinfo-link">Advanced Options</a> &gt; <a href="/admin/advanced/elevate" class="general-helpinfo-link">Promote user to administrator</a> and <a href="/admin/advanced/demote" class="general-helpinfo-link">Demote user from administrator</a>.</p>
    <AdminFooter />
</body>
</html>
import { Render } from "@puckeditor/core/rsc"

import PublicPage from "../layouts/PublicPage.astro"
import CompositorStyles from "../components/CompositorStyles.astro"
import {
    fetchPublishedDesignPages,
    fetchPublishedTheme,
    NOT_FOUND_PAGE_SLUG,
    partitionDesignPages
} from "../lib/build/design-api"
import { buildConfig, OUTLET_PROPS, TOKEN_PROPS } from "../lib/compositor/catalog"
import { hasBlockingError, lintDesign } from "../lib/compositor/lint"
import { EMPTY_TOKEN_CATALOG } from "../lib/compositor/tokens"

export const prerender = true

const [designPages, theme] = await Promise.all([fetchPublishedDesignPages(), fetchPublishedTheme()])
const { notFoundPage } = partitionDesignPages(designPages)

if (notFoundPage) {
    const findings = lintDesign(notFoundPage.doc, theme, TOKEN_PROPS, OUTLET_PROPS, undefined, true)
    for (const finding of findings.filter((candidate) => candidate.severity === "warning")) {
        console.warn(`[build] 404 design page - ${finding.path}: ${finding.message}`)
    }
    if (hasBlockingError(findings)) {
        const errors = findings
            .filter((finding) => finding.severity === "error")
            .map((finding) => `  ${finding.path}: ${finding.message}`)
            .join("\n")
        throw new Error(
            `[build] the reserved "${NOT_FOUND_PAGE_SLUG}" design page fails the design lint and cannot be ` +
                `published:\n${errors}\nFix it in /admin/advanced/designs, or unpublish the page to fall back to the ` +
                "static Not Found page."
        )
    }
}

const title = notFoundPage?.title || "Page not found"
const description = notFoundPage?.description || "The page you requested does not exist."
---

{
    notFoundPage ? (
        <PublicPage title={title} description={description}>
            <CompositorStyles slot="head" />
            {/* No entry (a design_page, same as [...slug].astro's design_page branch): outlets render
                nothing. No client directive -> server-rendered, zero JS. */}
            <Render
                config={buildConfig(theme ?? EMPTY_TOKEN_CATALOG, "build", {
                    entry: null,
                    mediaBaseUrl: import.meta.env.EMDASH_MEDIA_PUBLIC_URL ?? process.env.EMDASH_MEDIA_PUBLIC_URL
                })}
                data={notFoundPage.doc.puck}
            />
        </PublicPage>
    ) : (
        <PublicPage title={title} description={description}>
            <article>
                <h1>Page not found</h1>
                <p>
                    The page you requested does not exist. <a href="/">Return home</a>.
                </p>
            </article>
        </PublicPage>
    )
}

# Build-time configuration for prerendering the public site.

# Origin of the deployed site to read published content/settings/menu from (the live worker's EmDash API)
CONTENT_API_BASE=https://kilmer.nrnnet.xyz

# Cloudflare Access service token authorized on the Access application that protects /_emdash
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional EmDash personal access token (ec_pat_...) sent as a Bearer fallback, for setups where the
# service token does not resolve to an EDITOR.
EMDASH_API_TOKEN=

# Public URL of the emdash-media R2 bucket (custom domain or public bucket URL)
EMDASH_MEDIA_PUBLIC_URL=

# Public URL of the spot-kilmerviolin-files R2 bucket
FILES_PUBLIC_URL=

# Build-time reader for the D1-backed entity tables
BUILD_API_TOKEN=

# Cloudflare Web Analytics beacon token - not the tag
CF_WEB_ANALYTICS_TOKEN=

# Site-wide og:image/twitter:image fallback (an absolute URL) for a public page that has no image of its own
SITE_DEFAULT_OG_IMAGE=

# Whether the built robots.txt (src/pages/robots.txt.ts) allows crawlers to index the site
SITE_ALLOW_INDEXING=

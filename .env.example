# Build-time configuration for prerendering the public site.
#
# These are consumed ONLY during `astro build` (getStaticPaths + the chrome readers fetch CMS content over
# EmDash's HTTP API — see src/lib/build/emdash-api.ts). They are NOT wrangler runtime secrets/vars and must
# not be added to wrangler.jsonc; set them in the local .env for local builds and in the Cloudflare Workers
# Builds environment for CI builds.

# Origin of the deployed site to read published content/settings/menu from (the live worker's EmDash API).
CONTENT_API_BASE=https://kilmer.nrnnet.xyz

# Cloudflare Access service token authorized on the Access application that protects /_emdash. It passes
# the edge Access policy; EmDash maps it to the default EDITOR role, which grants content:read /
# settings:read / menus:read.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional EmDash personal access token (ec_pat_...) sent as a Bearer fallback, for setups where the
# service token does not resolve to an EDITOR. Leave blank when the service token suffices.
EMDASH_API_TOKEN=

# Public URL of the emdash-media R2 bucket (custom domain or public bucket URL). Makes CMS images load for
# anonymous visitors on the prerendered public pages instead of the Access-gated media proxy.
EMDASH_MEDIA_PUBLIC_URL=

# Public URL of the spot-kilmerviolin-files R2 bucket (custom domain or public bucket URL, e.g.
# https://db-img.kilmer.nrnnet.xyz). Makes a D1 entity's uploaded (/api/v1/files/<key>) image field load
# for anonymous visitors on the prerendered public pages instead of the Access-gated /api/v1/files proxy.
# The whole bucket is public once a custom domain/r2.dev URL is attached to it — R2_FILES also stores
# arbitrary admin-uploaded files, not just images, so anyone who knows or guesses a key can fetch it.
FILES_PUBLIC_URL=

# Build-time reader for the D1-backed entity tables (composers/contributors/compositions), read over the
# deployed Worker's own GET /api/v1/{composers,contributors,works} endpoints, authenticated with a build
# token (plan-prelaunch-features.md §2 D9 — see /admin/user/tokens/build to issue one). Reader returns
# null (skips entity pages) when this, or any of the CF_ACCESS_CLIENT_* pair above, is unset. Unlike the
# EMDASH_API_TOKEN fallback above, the Access service-token headers are MANDATORY for this reader — a
# build token alone authenticates nothing (Access remains the mandatory outer gate for every token type).
#
# Formerly this reader used a broad, account-scoped Cloudflare "D1: Read" API token against D1's REST
# query endpoint directly (D1_API_TOKEN/D1_ACCOUNT_ID/D1_DATABASE_ID). That token should be deleted from
# the Cloudflare dashboard once a build using BUILD_API_TOKEN has been verified — it is strictly broader
# than a build token (full read access to every table in the database, not just these three collections).
BUILD_API_TOKEN=

# Cloudflare Web Analytics beacon token (Analytics & Logs > Web Analytics > Add a site > your site >
# Manage site > JavaScript snippet > the "token" field, NOT the site tag). Public, not secret — it is
# emitted verbatim into every public page's HTML (see src/components/PublicHead.astro) — but it must be
# set here rather than in wrangler.jsonc because public pages are prerendered at build time. Leave blank
# to omit the beacon entirely. The admin analytics view (src/lib/api/analytics.ts) reads the resulting data
# separately, at runtime, via CF_ANALYTICS_SITE_TAG/CF_ANALYTICS_TOKEN in wrangler.jsonc — see DEPLOY.md.
CF_WEB_ANALYTICS_TOKEN=

# Site-wide og:image/twitter:image fallback (an absolute URL) for a public page that has no image of its
# own (no per-entity image, no CMS featured_image) — see src/components/PublicHead.astro. Leave blank to
# omit those tags entirely on such a page rather than point at a placeholder asset.
SITE_DEFAULT_OG_IMAGE=

{
	"name": "spot-kilmerviolin",
	"compatibility_date": "2026-06-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	// account_id is intentionally omitted: wrangler reads it from the CLOUDFLARE_ACCOUNT_ID env var at
	// deploy/dev time instead, so this AGPL-covered file doesn't have to carry it. See DEPLOY.md.
	// the current website route
	"workers_dev": true,
	"routes": [
		{ "pattern": "kilmer.nrnnet.xyz", "custom_domain": true }
	],
	// preview_urls must stay enabled for the "staging" preview alias to resolve (it otherwise
	// defaults to follow workers_dev); set explicitly so the staging deploy does not silently break
	"preview_urls": true,
	// logging config
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1.0
		}
	},
	// for error reporting
	"upload_source_maps": true,
	// constants fixed in wrangler (others, such as error reporting, are determined dynamically by the exec environment)
	"vars": {
		"CACHE_API_TTL": 7200, // 2 hours
		"CACHE_API_TTL_LONG": 604800, // 168 hours (1 week)
		"KV_CACHE_TTL": 57600, // 16 hours
		// CF_ACCESS_POLICY_ID, CF_ACCOUNT_ID, CF_ACCESS_AUD, and TEAM_DOMAIN moved from vars to secrets
		// (see secrets.required below) so their deployment-specific values aren't committed in this
		// AGPL-covered file. Set them with `wrangler secret put <NAME>`; see DEPLOY.md.
		// REPLACE with the "Site tag" of the Cloudflare Web Analytics site created for this domain (Analytics
		// & Logs > Web Analytics > Add a site > your site > Manage site > the "siteTag", NOT the beacon
		// token used in the public <script> snippet — see CF_WEB_ANALYTICS_TOKEN in .env.example and DEPLOY.md).
		// Left blank disables the admin analytics view (it renders a "not configured" message instead).
		"CF_ANALYTICS_SITE_TAG": "",
		// the reserved domain used to generate placeholder sign-in emails for contributors with no real
		// sign-in email (see FALLBACK_EMAIL_DOMAIN in src/lib/api/fallback.ts); change this when forking
		// the project for a different deployment so generated fallback addresses don't collide with a
		// domain you don't control
		"FALLBACK_EMAIL_DOMAIN": "mwmsc.net",
		// this worker's own origin: used as a synthetic host for Cache API keys (see cache_host in
		// lib/api/caching.ts and blob_host in lib/api/files.ts — Cloudflare recommends a resolvable
		// domain for cache keys) and as the CORS fallback origin (see cors_fallback_origin in
		// lib/api/http.ts) when a request has no allowlisted Origin. Should match one of the entries in
		// ALLOWED_ORIGINS (src/consts.ts) for the current deployment's actual workers.dev/custom domain.
		"WORKER_ORIGIN": "https://spot-kilmerviolin.nrnnetint.workers.dev",
		"API_USER_SELFENROLL": true, // if true, enables self-enrollment, allowing for account configuration without being first created by a user enroller or admin
		"REBUILD_COOLDOWN_SEC": 1800, // 30 minutes; minimum seconds after a build before another rebuild may be triggered (enforced server-side in /api/v1/site POST and reflected client-side)
		// DB write gating is now determined dynamically by the runtime environment (see dbWriteEnabled in src/lib/api/environment.ts)
		"IDENTITY_CACHE_TTL_MS": 45000, // 45 seconds; per-isolate identity-record cache TTL (see _getIdentityRecord in src/lib/api/authorize.ts)
		"MAX_UPLOAD_BYTES": 26214400, // 25 MiB; maximum size of a single uploaded file (see maxUploadBytes in src/lib/api/r2.ts)
		"SEARCH_RESULT_CAP": 50, // maximum search hits returned per table, to bound the response size (see runSearch in src/lib/api/search.ts)
		"MAX_IMAGE_WIDTH": 1600, // informational long edge of an optimized image; must match the CANON_PORTRAIT/CANON_LANDSCAPE long edge in src/lib/api/images.ts
		"TARGET_IMAGE_FORMAT": "image/webp", // re-encode format for optimized images (see optimizeImage in src/lib/api/images.ts)
		"TARGET_IMAGE_QUALITY": 82 // encode quality (0-100) for the target image format; keep the build-time copy in integrations/optimize-files.mjs in sync
	},
	// secret requirements
	"secrets": {
		// CF_ANALYTICS_TOKEN is optional at runtime (see lib/api/analytics.ts's "unconfigured" fallback) but
		// listed here so a fresh deploy is reminded to set it; a missing value only disables the admin
		// analytics view, it never fails a request. CF_ACCESS_POLICY_ID/CF_ACCOUNT_ID/CF_ACCESS_AUD/
		// TEAM_DOMAIN aren't secret in the confidentiality sense, but are deployment-specific values that
		// used to live in the `vars` block above; they moved here so they aren't committed to this
		// AGPL-covered file. See DEPLOY.md.
		"required": [
			"CF_ACCESS_TOKEN",
			"CF_DEPLOY_HOOK",
			"CF_ACCESS_CLIENT_ID",
			"CF_ACCESS_CLIENT_SECRET",
			"CF_ANALYTICS_TOKEN",
			"CF_ACCESS_POLICY_ID",
			"CF_ACCOUNT_ID",
			"CF_ACCESS_AUD",
			"TEAM_DOMAIN"
		]
	},
	// api bindings
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB_MAIN",
			"database_name": "spot-kilmerviolin-db",
			"database_id": "ea3e0315-08a4-4495-9f8f-6839ef876ddf"
		},
		// EmDash CMS content store (separate from DB_MAIN to isolate the beta schema). EmDash creates and
		// migrates its own tables automatically on first request. Provisioned via `wrangler d1 create emdash-db`.
		{
			"binding": "EMDASH_DB",
			"database_name": "emdash-db",
			"database_id": "57fc50e6-9b49-401a-b861-0f1163944e0f"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV_DB_CACHE",
			"id": "d0d0fecda0504e29ba7800141df3f3ae"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_FILES",
			"bucket_name": "spot-kilmerviolin-files"
		},
		// EmDash CMS media library (separate from R2_FILES, the admin composition-image pool). Create with
		// `wrangler r2 bucket create emdash-media` (owner action). Draws against the same account-wide
		// storage ceiling as R2_FILES, not a separate one — see MAX_R2_STORAGE_BYTES in src/lib/api/r2.ts
		// and the capacity guard in src/middleware/emdash_media_capacity.ts.
		{
			"binding": "EMDASH_MEDIA",
			"bucket_name": "emdash-media"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	// rate limits
	"ratelimits": [
		{
			"name": "RL_FREQ", // applied based on IP address, intended to stop high-frequency requests
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 10
			}
		},
		{
			"name": "RL_API_PUBLIC", // applied to the public API, intended to backstop against overwhelming request volumes
			"namespace_id": "1002", // applies globally to all users
			"simple": {
				"limit": 1000, // hits to this rate limit would only apply to public users of API endpoints and wouldn't apply to ordinary page visitors (public pages are prerendered static assets served from ASSETS, so they never reach the worker)
				"period": 60
			}
		},
		{
			"name": "RL_API_ADMIN_GLOBAL", // applies to admin endpoints if authenticated (unauthenticated users receive 403)
			"namespace_id": "1003", // applies globally
			"simple": {
				"limit": 250, // population of admin users is extremely small, so a lower limit is acceptable
				"period": 60
			}
		},
		{
			"name": "RL_API_ADMIN_USER", // applies to admin endpoints if authenticated (unauthenticated users receive 403)
			"namespace_id": "1004", // applies based on user ID, so each admin user has their own rate limit
			"simple": {
				"limit": 50,
				"period": 60
			}
		},
		{
			"name": "RL_ADMIN_RENDER", // applied to admin rendering pages by IP, intended to prevent unusual request volumnes
			"namespace_id": "1005",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "RL_API_FILES_READ", // applied to file reads (GET /api/v1/files/{id}) by IP; R2 Class B operations are capped at 10M/mo, so a generous per-IP limit keeps internal call volume well under the ceiling without throttling normal admin use
			"namespace_id": "1006",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			"name": "RL_API_FILES_WRITE", // applied to file lists/uploads/replacements/deletions by user; R2 Class A operations are capped at 1M/mo, so a low per-user limit prevents internal logic from running excessive writes/lists against R2
			"namespace_id": "1007",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}
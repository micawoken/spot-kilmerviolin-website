{
	"name": "spot-kilmerviolin",
	"compatibility_date": "2026-06-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"account_id": "49d973b0738799edc1a8edac208b35be",
	// the current website route
	"workers_dev": true,
	"routes": [],
	// preview_urls must stay enabled for the "staging" preview alias to resolve (it otherwise
	// defaults to follow workers_dev); set explicitly so the staging deploy does not silently break
	"preview_urls": true,
	// logging config
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1.0
		}
	},
	// for error reporting
	"upload_source_maps": true,
	// constants fixed in wrangler (others, such as error reporting, are determined dynamically by the exec environment)
	"vars": {
		"CACHE_API_TTL": 7200, // 2 hours
		"CACHE_API_TTL_LONG": 604800, // 168 hours (1 week)
		"KV_CACHE_TTL": 57600, // 16 hours
		"CF_ACCESS_LIST_ID": "a7696af3-f1d7-4593-85a6-1e152390562f", // points to the list reusable component used by the access policy, which is used by the access application
		"CF_ACCOUNT_ID": "49d973b0738799edc1a8edac208b35be", // the account ID for kennedy.6697@gmail.com
		"CF_ACCESS_AUD": "0d075cefe6325b9fe0ccc4911081ee79708d3261c24cb0dce26f40286b0dfdf6", // the aud for the Access policy to validate the JWT against
		"GITHUB_REPO_OWNER": "micawoken",
		"GITHUB_REPO_NAME": "entrusting-devilish-fish",
		// the external Pages CMS sync endpoint that mirrors CMS-editor authorization into its collaborator
		// table (see src/lib/api/cms_access_sync.ts, docs/dev/pages-cms.md). Set to the deployed fork URL;
		// when blank (or PAGES_CMS_SYNC_SECRET unset) the sync no-ops. Temporary host until a permanent
		// (non-business) domain is chosen — the prior infra.mwmsc.net domain is being restricted to business use.
		"PAGES_CMS_SYNC_URL": "https://cms.guest.mwmsc.net/api/sync/cms-access",
		"API_USER_SELFENROLL": true, // if true, enables self-enrollment, allowing for account configuration without being first created by a user enroller or admin
		"TEAM_DOMAIN": "https://nrnnetint.cloudflareaccess.com", // the domain for the Access policy to validate the JWT against
		"REBUILD_COOLDOWN_SEC": 900, // 15 minutes; minimum seconds after a build before another rebuild may be triggered (enforced server-side in /api/v1/site POST and reflected client-side)
		// DB write gating is now determined dynamically by the runtime environment (see dbWriteEnabled in src/lib/api/environment.ts)
		"IDENTITY_CACHE_TTL_MS": 45000, // 45 seconds; per-isolate identity-record cache TTL (see _getIdentityRecord in src/lib/api/authorize.ts)
		"MAX_UPLOAD_BYTES": 26214400, // 25 MiB; maximum size of a single uploaded file (see maxUploadBytes in src/lib/api/r2.ts)
		"SEARCH_RESULT_CAP": 50, // maximum search hits returned per table, to bound the response size (see runSearch in src/lib/api/search.ts)
		"MAX_IMAGE_WIDTH": 1600, // informational long edge of an optimized image; must match the CANON_PORTRAIT/CANON_LANDSCAPE long edge in src/lib/api/images.ts
		"TARGET_IMAGE_FORMAT": "image/webp", // re-encode format for optimized images (see optimizeImage in src/lib/api/images.ts)
		"TARGET_IMAGE_QUALITY": 82 // encode quality (0-100) for the target image format; keep the build-time copy in integrations/optimize-files.mjs in sync
	},
	// secret requirements
	"secrets": {
		"required": [
			"CF_ACCESS_TOKEN",
			"CF_DEPLOY_HOOK",
			"GITHUB_ADMIN_TOKEN",
			"PAGES_CMS_SYNC_SECRET"
		]
	},
	// api bindings
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB_MAIN",
			"database_name": "spot-kilmerviolin-db",
			"database_id": "ea3e0315-08a4-4495-9f8f-6839ef876ddf"
		},
		// EmDash CMS content store (separate from DB_MAIN to isolate the beta schema). EmDash creates and
		// migrates its own tables automatically on first request. Provisioned via `wrangler d1 create emdash-db`.
		{
			"binding": "EMDASH_DB",
			"database_name": "emdash-db",
			"database_id": "57fc50e6-9b49-401a-b861-0f1163944e0f"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV_DB_CACHE",
			"id": "d0d0fecda0504e29ba7800141df3f3ae"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_FILES",
			"bucket_name": "spot-kilmerviolin-files"
		},
		// EmDash CMS media library (separate from R2_FILES, the admin composition-image pool). Create with
		// `wrangler r2 bucket create emdash-media` (owner action).
		{
			"binding": "EMDASH_MEDIA",
			"bucket_name": "emdash-media"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	// rate limits
	"ratelimits": [
		{
			"name": "RL_FREQ", // applied based on IP address, intended to stop high-frequency requests
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 10
			}
		},
		{
			"name": "RL_API_PUBLIC", // applied to the public API, intended to backstop against overwhelming request volumes
			"namespace_id": "1002", // applies globally to all users
			"simple": {
				"limit": 1000, // hits to ths rate limit would only apply to public users of API endpoints and wouldn't apply to ordinary page visitors (since those are SSR)
				"period": 60
			}
		},
		{
			"name": "RL_API_ADMIN_GLOBAL", // applies to admin endpoints if authenticated (unauthenticated users receive 403)
			"namespace_id": "1003", // applies globally
			"simple": {
				"limit": 250, // population of admin users is extremely small, so a lower limit is acceptable
				"period": 60
			}
		},
		{
			"name": "RL_API_ADMIN_USER", // applies to admin endpoints if authenticated (unauthenticated users receive 403)
			"namespace_id": "1004", // applies based on user ID, so each admin user has their own rate limit
			"simple": {
				"limit": 50,
				"period": 60
			}
		},
		{
			"name": "RL_ADMIN_RENDER", // applied to admin rendering pages by IP, intended to prevent unusual request volumnes
			"namespace_id": "1005",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "RL_API_FILES_READ", // applied to file reads (GET /api/v1/files/{id}) by IP; R2 Class B operations are capped at 10M/mo, so a generous per-IP limit keeps internal call volume well under the ceiling without throttling normal admin use
			"namespace_id": "1006",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			"name": "RL_API_FILES_WRITE", // applied to file lists/uploads/replacements/deletions by user; R2 Class A operations are capped at 1M/mo, so a low per-user limit prevents internal logic from running excessive writes/lists against R2
			"namespace_id": "1007",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}